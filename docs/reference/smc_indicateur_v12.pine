//@version=6
indicator("SMC Institutional Scalping v12",
     overlay          = true,
     max_labels_count = 500,
     max_lines_count  = 500,
     max_boxes_count  = 500)

// ║  SMC INSTITUTIONAL SCALPING — Nono                               ║
// ║  Indicateur principal — Pine Script v6                           ║
// ║  Version organisée — Ordre des modules corrigé                   ║

// 🤖  PROFIL PAR ASSET — Calibration automatique Asset × Timeframe (Phase 4)
// Un seul système de scoring par asset : le profil s'applique TOUJOURS (plus d'input auto-config).

// Variables de suivi pour les alertes (scope principal)
var bool _alertBuyTriggered  = false
var bool _alertSellTriggered = false

// ── MODE AUDIT (Phase 2.7 : confrontation runtime local ↔ TradingView) ──
// Flèches (émission) et croix (break-even) PERSISTANTES, posées à la barre
// exacte des événements — mêmes transitions que les alertes. Off par défaut :
// aucun effet visuel ni comportemental tant que l'input n'est pas coché.
bool i_audit       = input.bool(false, "Mode audit (marqueurs persistants)", group="Audit")
var int _auditBarBuy     = -1
var int _auditBarSell    = -1
var int _auditBarBeBuy   = -1
var int _auditBarBeSell  = -1
// Créations de trades (f_createBuySignals/Sell) — modifiables depuis les
// fonctions via référence, contrairement aux var simples. C'est CETTE trace
// qui correspond aux émissions du moteur local (création au retour d'OB).
var array<int> _auditCreBuy  = array.new<int>(0)
var array<int> _auditCreSell = array.new<int>(0)

string _tk  = syminfo.ticker
int    _tf  = timeframe.in_seconds() / 60

bool _isXAU = str.contains(_tk, "XAU")
bool _isXAG = str.contains(_tk, "XAG")
bool _isNAS = str.contains(_tk, "NAS") or str.contains(_tk, "NDX") or str.contains(_tk, "US100")
bool _isBTC = str.contains(_tk, "BTC")
bool _isDAX = str.contains(_tk, "DAX") or str.contains(_tk, "GER40") or str.contains(_tk, "DE30")

// Phase 4.1 : asset reconnu = au moins un profil dédié existe.
// Sur un symbole non listé, signaux & scoring sont DÉSACTIVÉS (décision : un seul système par asset).
bool _assetReconnu = _isXAU or _isXAG or _isNAS or _isBTC or _isDAX

// Valeur d'un pip — remontée ici car utilisée tôt (taille des FVG en pips, dashboard, signaux).
float _pipValue = _isXAU ? 0.1  :
                  _isXAG ? 0.01 : 1.0
float _pvLot    = _isXAU ? 10.0 : _isXAG ? 50.0 : _isNAS ? 20.0 :
                  _isBTC ? 1.0  : _isDAX ? 25.0  : 10.0

bool _tfM15   = _tf <= 15
bool _tfH1    = _tf <= 60
bool _tfH4    = _tf <= 240

int _autoSwing =
     _isXAU and _tfM15 ? 3 : _isXAU ? 5 :
     _isXAG and _tfM15 ? 3 : _isXAG ? 4 :
     _isNAS and _tfM15 ? 3 : _isNAS ? 5 :
     _isBTC and _tfM15 ? 3 : _isBTC ? 5 :
     _isDAX and _tfM15 ? 3 : _isDAX ? 5 : 5

// Sensibilité OB : seuil ROC (bps) pour détecter une bougie impulsive
// ROC = (high-low)/close × 10000 — seuil 5 bps (aligné module standalone)
int _autoRocSeuil = 5

// Filtre d'affichage des OB par force /10 — défaut 5 (valeur historique codée
// en dur). Réglable pour le test de vérité : baisser à 1 pour TOUT afficher
// et vérifier si une zone existe (force faible) ou n'a jamais été créée.
int i_affObForce = input.int(5, "Afficher les OB à partir de (force /10)", minval=1, maxval=10)

float _autoSeuilIB =
     _isXAU ? 1.5 : _isXAG ? 1.2 : _isNAS ? 1.5 :
     _isBTC ? 2.0 : _isDAX ? 1.5 : 1.5

float _autoAtrScore =
     _isXAU ? 3.0 : _isXAG ? 2.5 : _isNAS ? 3.0 :
     _isBTC ? 3.5 : _isDAX ? 3.0 : 3.0

float _autoAtrSeuil =
     _isXAU ? 2.0 : _isXAG ? 1.8 : _isNAS ? 2.0 :
     _isBTC ? 2.5 : _isDAX ? 2.0 : 2.0

int _autoTpWidth = 40
if _tfH1
    _autoTpWidth := 30
else if _tfH4
    _autoTpWidth := 20

int _autoTp3Mins =
     _isXAU and _tfM15 ? 60  : _isXAU and _tfH1 ? 240 :
     _isXAG and _tfM15 ? 45  : _isXAG and _tfH1 ? 180 :
     _isNAS and _tfM15 ? 30  : _isNAS and _tfH1  ? 120 :
     _isBTC and _tfM15 ? 90  : _isBTC and _tfH1  ? 360 :
     _isDAX and _tfM15 ? 30  : _isDAX and _tfH1  ? 120 : 60

string _autoSlMode =
     _isBTC ? "2× ATR sous OB" :
     _isXAG ? "1.5× ATR sous OB" :
     _isXAU or _isNAS or _isDAX ? "1× ATR sous OB" : "Bas OB"

// ⚙️  MODULES — Toujours actifs (hardcodés)
bool i_moteurStructure = true
bool i_moteurBOS       = true
bool i_moteurCHOCH     = true
bool i_moteurLiquidite = true
bool i_moteurSweep     = true
bool i_moteurFVG       = true
bool i_moteurOB        = true
bool i_moteurVolume    = true
bool i_moteurATR       = true
bool i_moteurMTF       = true
bool i_moteurIB        = true

// 🎨 COULEURS FIXES (hardcodées — non modifiables dans les paramètres)
color i_colPDH     = color.new(#FFC107, 0)
color i_colPDL     = color.new(#FF9800, 0)
color i_colPWH     = color.new(#42A5F5, 0)
color i_colPWL     = color.new(#26C6DA, 0)
color i_atrBull    = color.new(#00E676, 75)
color i_atrBear    = color.new(#FF1744, 75)
color i_volColor   = color.new(#2962FF, 82)
color i_colFIBBull = color.new(#00C853, 80)
color i_colFIBBear = color.new(#D50000, 80)
color i_colLondon  = color.new(#1565C0, 90)
color i_colNY      = color.new(#B71C1C, 90)
color i_colAsianH  = color.new(#FFD600,  0)
color i_colAsianL  = color.new(#FF6F00,  0)
color i_rangeColor = color.new(#607D8B, 92)

var string GRP_MM      = "💰 Money Management"
float i_capital        = input.float(10000, "Capital ($)", minval=100, step=1000, group=GRP_MM)
float i_riskPct        = input.float(1.0, "Risque/trade (%)", minval=0.1, maxval=5.0, step=0.1, group=GRP_MM)

// SESSIONS & ASIAN LEVELS — Paramètres d'affichage
var string GRP_SES   = "🕐 Sessions & Niveaux Clés"
bool  i_showAsian    = input.bool (false,                    "Session Asitique",           group=GRP_SES)
color i_colAsian     = color.new(#F9A825, 90)
bool  i_showLondon   = input.bool (false,                    "Session Européenne",        group=GRP_SES)
bool  i_showNY       = input.bool (false,                    "Session Américaine",       group=GRP_SES)
bool  i_showAsianHL  = input.bool (false,                    "Asian High / Asian Low", group=GRP_SES)

// Constantes Kill Zones (UTC, en minutes depuis minuit)
int KZ_ASIAN_START  = 0
int KZ_ASIAN_END    = 180
int KZ_LONDON_START = 420
int KZ_LONDON_END   = 570
int KZ_NYAM_START   = 720
int KZ_NYAM_END     = 840
int KZ_NYPM_START   = 1020
int KZ_NYPM_END     = 1140
// Constantes sessions complètes (UTC, en minutes depuis minuit) — pour Asian HL scoring.
// Asian HL reste en UTC (décision 2026-07-26 : scoring figé, KZ et Asian HL en UTC).
int SES_ASIE_START   = 0
int SES_ASIE_END     = 540
int SES_LONDON_START = 480
int SES_LONDON_END   = 1020
int SES_NY_START     = 780
int SES_NY_END       = 1320
int SES_OVLP_START   = 780
int SES_OVLP_END     = 1020
// Sessions complètes pour l'AFFICHAGE (heure Paris, minutes depuis minuit Paris).
// Décision Rono 2026-07-26 : affichage des rectangles de sessions en heure de Paris
// (heure de trading), avec gestion DST automatique via hour(time, "Europe/Paris").
// Les constantes UTC ci-dessus restent pour le scoring (Asian HL).
//   Asie (Tokyo) : 0h00 - 6h30 Paris    → 0 - 390 min
//   Londres      : 8h00 - 16h30 Paris   → 480 - 990 min
//   New York     : 14h30 - 21h00 Paris  → 870 - 1260 min
int SES_PARIS_ASIE_START    = 0
int SES_PARIS_ASIE_END      = 390
int SES_PARIS_LONDON_START  = 480
int SES_PARIS_LONDON_END    = 990
int SES_PARIS_NY_START      = 870
int SES_PARIS_NY_END        = 1260

int  _gKzMins = int(time % 86400000) / 60000
bool inKZ = (_gKzMins >= KZ_ASIAN_START  and _gKzMins < KZ_ASIAN_END)
         or (_gKzMins >= KZ_LONDON_START and _gKzMins < KZ_LONDON_END)
         or (_gKzMins >= KZ_NYAM_START   and _gKzMins < KZ_NYAM_END)
         or (_gKzMins >= KZ_NYPM_START   and _gKzMins < KZ_NYPM_END)

// LIQUIDITE PRECEDENTE — PDH / PDL / PWH / PWL
var string GRP_PL = "🕐 Sessions & Niveaux Clés"
bool  i_showPrevLiq   = input.bool(false,  "Previous /Day High/Day Low/Week High/Week Low", group=GRP_PL)
bool  i_prevLiqScore  = true
float i_prevLiqAtrProx = 0.35
int   i_prevLiqPtsProx  = 2
int   i_prevLiqPtsSweep = 4
bool  i_alertSweepPDHL  = true

float pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
float pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_off)
float pwh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_off)
float pwl = request.security(syminfo.tickerid, "W", low[1],  lookahead=barmerge.lookahead_off)

// SMC pur : niveau de liquidité pris (sweep) = OBSOLÈTE.
var float pdhActive = na
var float pdlActive = na
var float pwhActive = na
var float pwlActive = na
if na(close[1]) or dayofmonth != dayofmonth[1]
    pdhActive := pdh
    pdlActive := pdl
if na(close[1]) or weekofyear != weekofyear[1]
    pwhActive := pwh
    pwlActive := pwl

// Tracking bar de départ du jour et de la semaine courants (pour lignes PD/PW)
var int _curDayStartBar  = 0
var int _curWeekStartBar = 0
var int _curDayStartTime  = 0
var int _curWeekStartTime = 0
var int _prevDayStartTime  = 0
var int _prevWeekStartTime = 0
var float _curDayHigh = na
var int   _curDayHighTime = na
var float _curDayLow  = na
var int   _curDayLowTime  = na
var int   _prevDayHighTime = na
var int   _prevDayLowTime  = na
var float _curWkHigh = na
var int   _curWkHighTime = na
var float _curWkLow  = na
var int   _curWkLowTime  = na
var int   _prevWkHighTime = na
var int   _prevWkLowTime  = na
if na(close[1]) or dayofmonth != dayofmonth[1]
    _prevDayStartTime := _curDayStartTime
    _prevDayHighTime  := _curDayHighTime
    _prevDayLowTime   := _curDayLowTime
    _curDayStartBar  := bar_index
    _curDayStartTime := time
    _curDayHigh := high
    _curDayHighTime := time
    _curDayLow := low
    _curDayLowTime := time
else
    if high > _curDayHigh
        _curDayHigh := high
        _curDayHighTime := time
    if low < _curDayLow
        _curDayLow := low
        _curDayLowTime := time
if na(close[1]) or weekofyear != weekofyear[1]
    _prevWeekStartTime := _curWeekStartTime
    _prevWkHighTime    := _curWkHighTime
    _prevWkLowTime     := _curWkLowTime
    _curWeekStartBar := bar_index
    _curWeekStartTime := time
    _curWkHigh := high
    _curWkHighTime := time
    _curWkLow := low
    _curWkLowTime := time
else
    if high > _curWkHigh
        _curWkHigh := high
        _curWkHighTime := time
    if low < _curWkLow
        _curWkLow := low
        _curWkLowTime := time

// Détection sweep PDH/PDL/PWH/PWL (barstate.isconfirmed)
// « Décisions trading » 2026-08-23 (option A) : un niveau ATTEINT par le prix
// sur bar confirmée est CONSOMMÉ et disparaît — sweep (mèche + close retour)
// OU cassure (close au-delà). Avant : sweep uniquement (la cassure laissait
// le niveau actif), règle incohérente avec l'Asian H/L (cassure uniquement).
if barstate.isconfirmed and not na(pdhActive) and high >= pdhActive
    pdhActive := na
if barstate.isconfirmed and not na(pdlActive) and low <= pdlActive
    pdlActive := na
if barstate.isconfirmed and not na(pwhActive) and high >= pwhActive
    pwhActive := na
if barstate.isconfirmed and not na(pwlActive) and low <= pwlActive
    pwlActive := na

var line  _pdhLine = na
var line  _pdlLine = na
var line  _pwhLine = na
var line  _pwlLine = na
var label _pdhLbl  = na
var label _pdlLbl  = na
var label _pwhLbl  = na
var label _pwlLbl  = na

if barstate.islast
    if not na(_pdhLine)
        line.delete(_pdhLine)
    if not na(_pdlLine)
        line.delete(_pdlLine)
    if not na(_pwhLine)
        line.delete(_pwhLine)
    if not na(_pwlLine)
        line.delete(_pwlLine)
    if not na(_pdhLbl)
        label.delete(_pdhLbl)
    if not na(_pdlLbl)
        label.delete(_pdlLbl)
    if not na(_pwhLbl)
        label.delete(_pwhLbl)
    if not na(_pwlLbl)
        label.delete(_pwlLbl)

    _pdhLine := na
    _pdlLine := na
    _pwhLine := na
    _pwlLine := na
    _pdhLbl  := na
    _pdlLbl  := na
    _pwhLbl  := na
    _pwlLbl  := na

    if i_showPrevLiq
        int _x2  = time
        // Bord gauche = timestamp de la bougie où le high/low du jour précédent s'est formé.
        int _x1d  = not na(_prevDayHighTime) ? _prevDayHighTime : (_prevDayStartTime > 0 ? _prevDayStartTime : _curDayStartTime)
        int _x1dL = not na(_prevDayLowTime)  ? _prevDayLowTime  : (_prevDayStartTime > 0 ? _prevDayStartTime : _curDayStartTime)
        int _x1w  = not na(_prevWkHighTime)  ? _prevWkHighTime  : (_prevWeekStartTime > 0 ? _prevWeekStartTime : _curWeekStartTime)
        int _x1wL = not na(_prevWkLowTime)   ? _prevWkLowTime   : (_prevWeekStartTime > 0 ? _prevWeekStartTime : _curWeekStartTime)
        if not na(pdhActive)
            _pdhLine := line.new(_x1d, pdhActive, _x2, pdhActive, xloc=xloc.bar_time, color=i_colPDH, width=1, style=line.style_dashed)
            _pdhLbl  := label.new(_x2, pdhActive, "Previous Day High", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(i_colPDH, 80), textcolor=i_colPDH, size=size.small)
        if not na(pdlActive)
            _pdlLine := line.new(_x1dL, pdlActive, _x2, pdlActive, xloc=xloc.bar_time, color=i_colPDL, width=1, style=line.style_dashed)
            _pdlLbl  := label.new(_x2, pdlActive, "Previous Day Low", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(i_colPDL, 80), textcolor=i_colPDL, size=size.small)
        if not na(pwhActive)
            _pwhLine := line.new(_x1w, pwhActive, _x2, pwhActive, xloc=xloc.bar_time, color=i_colPWH, width=1, style=line.style_dotted)
            _pwhLbl  := label.new(_x2, pwhActive, "Previous Week High", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(i_colPWH, 80), textcolor=i_colPWH, size=size.small)
        if not na(pwlActive)
            _pwlLine := line.new(_x1wL, pwlActive, _x2, pwlActive, xloc=xloc.bar_time, color=i_colPWL, width=1, style=line.style_dotted)
            _pwlLbl  := label.new(_x2, pwlActive, "Previous Week Low", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(i_colPWL, 80), textcolor=i_colPWL, size=size.small)

// MODULE 1 — STRUCTURE
var string GRP_S   = "📊 Structure & Price Action"
// Phase 4.2 : profil par asset appliqué automatiquement (plus d'input manuel)
int    i_swingLength  = _autoSwing
int    i_rocSeuil     = _autoRocSeuil
bool i_showLabels  = input.bool(false, "High High / High Low / Low High / Low Low",  group=GRP_S)
bool i_showBg      = input.bool(false, "Fond de tendance",           group=GRP_S)

color C_HH       = #00C853
color C_HL       = #69F0AE
color C_LH       = #FF5252
color C_LL       = #D50000
color C_BG_BULL  = color.new(color.green, 95)
color C_BG_BEAR  = color.new(color.red,   95)

// ── Style commun du texte AFFICHÉ DANS les blocs (étape 7 — relooking) ──
// Réutilisé par tous les blocs (FVG, OB, Propulsion, Breaker, OTE, HTF…).
string C_BLOC_TXT_HALIGN = text.align_right
string C_BLOC_TXT_VALIGN = text.align_top
string C_BLOC_TXT_SIZE   = size.tiny
color  C_BLOC_TXT_COLOR  = color.new(color.white, 15)
// Bordure = avis décisionnel (OB / zones) : actionnable / éviter / tradé
color C_AVIS_GUETTER = color.new(#FFD600, 0)   // or vif — setup à guetter
color C_AVIS_EVITER  = color.new(#9E9E9E, 25)  // gris estompé — à éviter
color C_AVIS_TRADE   = color.new(#AA00FF, 0)   // violet — déjà tradé

// FIFO array pour labels structure
var array<label> _structLbls  = array.new<label>(0)
int _maxStructLbls = 12

float ph       = ta.pivothigh(high, i_swingLength, i_swingLength)
float pl       = ta.pivotlow (low,  i_swingLength, i_swingLength)
int   barPivot = bar_index[i_swingLength]

var float sh1  = na
var float sh2  = na
var int   bsh1 = na
var int   bsh2 = na
var float sl1  = na
var float sl2  = na
var int   bsl1 = na
var int   bsl2 = na

if not na(ph)
    sh2  := sh1
    bsh2 := bsh1
    sh1  := ph
    bsh1 := barPivot
if not na(pl)
    sl2  := sl1
    bsl2 := bsl1
    sl1  := pl
    bsl1 := barPivot

bool isHH = not na(ph) and not na(sh2) and ph > sh2
bool isLH = not na(ph) and not na(sh2) and ph < sh2
bool isHL = not na(pl) and not na(sl2) and pl > sl2
bool isLL = not na(pl) and not na(sl2) and pl < sl2

var int bullCount = 0
var int bearCount = 0
if isHH or isHL
    bullCount += 1
    bearCount  := math.max(0, bearCount - 1)
if isLH or isLL
    bearCount += 1
    bullCount  := math.max(0, bullCount - 1)
bool tendanceHaussiere = bullCount >= 2
bool tendanceBaissiere = bearCount >= 2

f_structureLabels() =>
    if i_moteurStructure and i_showLabels
        if isHH
            if array.size(_structLbls) >= _maxStructLbls
                label.delete(array.shift(_structLbls))
            array.push(_structLbls, label.new(barPivot, ph, "Higher High", xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_down, color=C_HH, textcolor=color.white, size=size.small))
        if isLH
            if array.size(_structLbls) >= _maxStructLbls
                label.delete(array.shift(_structLbls))
            array.push(_structLbls, label.new(barPivot, ph, "Lower High", xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_down, color=C_LH, textcolor=color.white, size=size.small))
        if isHL
            if array.size(_structLbls) >= _maxStructLbls
                label.delete(array.shift(_structLbls))
            array.push(_structLbls, label.new(barPivot, pl, "Higher Low", xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_up, color=C_HL, textcolor=color.white, size=size.small))
        if isLL
            if array.size(_structLbls) >= _maxStructLbls
                label.delete(array.shift(_structLbls))
            array.push(_structLbls, label.new(barPivot, pl, "Lower Low", xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_up, color=C_LL, textcolor=color.white, size=size.small))


f_structureLabels()

bgcolor(i_moteurStructure and i_showBg and tendanceHaussiere ? C_BG_BULL :
        i_moteurStructure and i_showBg and tendanceBaissiere ? C_BG_BEAR : na,
        title="Tendance de marché")

// MODULE 2 — BOS (Break of Structure)
var string GRP_B  = "📊 Structure & Price Action"
bool  i_showBOS   = input.bool(false,  "Break of Structure",           group=GRP_B)

color C_BOS_BULL = #2962FF
color C_BOS_BEAR = #FF6D00

float atr14 = ta.atr(14)

var string GRP_IB       = "⚙️ Technique avancé"
float i_seuilIB         = _autoSeuilIB  // Phase 4.2 : profil par asset
int   i_maxIB           = 10  // IB actifs max — en dur
bool  i_showIB          = input.bool (false, "Imbalance",         group=GRP_IB)
color C_IB_BULL_FRESH   = color.new(#00C853, 93)
color C_IB_BULL_PARTIAL = color.new(#00C853, 96)
color C_IB_BEAR_FRESH   = color.new(#D50000, 93)
color C_IB_BEAR_PARTIAL = color.new(#D50000, 96)
color C_IB_BORDER       = color.new(color.white, 85)
bool ibBull = i_moteurIB and barstate.isconfirmed and (close - open) > i_seuilIB * atr14
bool ibBear = i_moteurIB and barstate.isconfirmed and (open - close) > i_seuilIB * atr14

var int dernierSH1_sig = na
var int dernierSL1_sig = na
bool bosHaussier = barstate.isconfirmed and not na(sh1) and close > sh1 and close[1] <= sh1 and (na(dernierSH1_sig) or bsh1 != dernierSH1_sig)
bool bosBaissier = barstate.isconfirmed and not na(sl1) and close < sl1 and close[1] >= sl1 and (na(dernierSL1_sig) or bsl1 != dernierSL1_sig)

var float dernierBOSH_level = na
var int   dernierBOSH_bar   = na
var float dernierBOSB_level = na
var int   dernierBOSB_bar   = na

if i_moteurBOS and bosHaussier
    dernierBOSH_level := sh1
    dernierBOSH_bar   := bar_index
if i_moteurBOS and bosBaissier
    dernierBOSB_level := sl1
    dernierBOSB_bar   := bar_index

// MODULE 3 — MSS / CHOCH
// MSS  = premier BOS contre la tendance (alerte précoce, non confirmé)
// CHOCH = MSS + swing confirmé dans le nouveau sens (signal fiable)
var string GRP_C   = "📊 Structure & Price Action"
bool  i_showMSS    = input.bool(false, "Market Structure Shift", group=GRP_C)
bool  i_showCHOCH  = input.bool(false, "CHange of CHaracter",     group=GRP_C)

color C_MSS_BULL   = #00BCD4   // cyan   — alerte précoce
color C_MSS_BEAR   = #FF9800   // orange — alerte précoce
color C_CHOCH_BULL = #AA00FF   // violet — confirmation
color C_CHOCH_BEAR = #FF1744   // rouge  — confirmation

// MSS : premier BOS contre la tendance dominante
bool mssHaussier = i_moteurCHOCH and tendanceBaissiere and bosHaussier
bool mssBaissier = i_moteurCHOCH and tendanceHaussiere and bosBaissier

// Flags persistants : MSS déclenché, en attente d'un swing confirmé
var bool _mssHPending = false
var bool _mssBPending = false

if mssHaussier
    _mssHPending := true
    _mssBPending := false
if mssBaissier
    _mssBPending := true
    _mssHPending := false

// CHOCH confirmé : MSS + nouveau Higher Low (bull) ou Lower High (bear)
// "not mssHaussier" évite un déclenchement simultané sur la même barre
bool chochHaussier = i_moteurCHOCH and _mssHPending and isHL and not mssHaussier
bool chochBaissier = i_moteurCHOCH and _mssBPending and isLH and not mssBaissier

if chochHaussier
    _mssHPending := false
if chochBaissier
    _mssBPending := false

// Timestamps CHOCH (pour le moteur BSZones — composante I du score). Capturés ici car absents de v12.
var int dernierChochBull_bar = na
var int dernierChochBear_bar = na
if chochHaussier
    dernierChochBull_bar := bar_index
if chochBaissier
    dernierChochBear_bar := bar_index

var float  dernierMSS_level   = na
var int    dernierMSS_bar     = na
var float  dernierCHOCH_level = na
var int    dernierCHOCH_bar   = na
var string dernierCHOCH_dir   = na

// Réinitialisation de la tendance dès le MSS (signal précoce = context change)
if i_moteurCHOCH and mssHaussier
    bullCount        := 0
    bearCount        := 0
    dernierSH1_sig   := bsh1
    dernierMSS_level := sh1
    dernierMSS_bar   := bar_index
if i_moteurCHOCH and mssBaissier
    bullCount        := 0
    bearCount        := 0
    dernierSL1_sig   := bsl1
    dernierMSS_level := sl1
    dernierMSS_bar   := bar_index
if i_moteurCHOCH and chochHaussier
    dernierCHOCH_level := sh1
    dernierCHOCH_bar   := bar_index
    dernierCHOCH_dir   := "HAUSSIER"
if i_moteurCHOCH and chochBaissier
    dernierCHOCH_level := sl1
    dernierCHOCH_bar   := bar_index
    dernierCHOCH_dir   := "BAISSIER"
if bosHaussier and not mssHaussier
    dernierSH1_sig := bsh1
if bosBaissier and not mssBaissier
    dernierSL1_sig := bsl1

// Arrays FIFO — labels/lignes BOS, MSS et CHOCH (P0-2)
var array<label> _bosLbls    = array.new<label>(0)
var array<line>  _bosLines   = array.new<line>(0)
var array<label> _mssLbls    = array.new<label>(0)
var array<line>  _mssLines   = array.new<line>(0)
var array<label> _chochLbls  = array.new<label>(0)
var array<line>  _chochLines = array.new<line>(0)
int _bosMaxVis = 6

f_block17() =>
    if i_moteurBOS and i_showBOS
        if bosHaussier and not mssHaussier and not na(bsh1)
            if array.size(_bosLines) >= _bosMaxVis
                line.delete(array.shift(_bosLines))
            if array.size(_bosLbls) >= _bosMaxVis
                label.delete(array.shift(_bosLbls))
            array.push(_bosLines, line.new(bsh1, sh1, bar_index, sh1, xloc=xloc.bar_index,
                 color=C_BOS_BULL, width=2, style=line.style_solid))
            array.push(_bosLbls, label.new(bar_index, sh1, "Break Of Structure ▲", xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_down, color=C_BOS_BULL, textcolor=color.white, size=size.small))
        if bosBaissier and not mssBaissier and not na(bsl1)
            if array.size(_bosLines) >= _bosMaxVis
                line.delete(array.shift(_bosLines))
            if array.size(_bosLbls) >= _bosMaxVis
                label.delete(array.shift(_bosLbls))
            array.push(_bosLines, line.new(bsl1, sl1, bar_index, sl1, xloc=xloc.bar_index,
                 color=C_BOS_BEAR, width=2, style=line.style_solid))
            array.push(_bosLbls, label.new(bar_index, sl1, "Break Of Structure ▼", xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_up, color=C_BOS_BEAR, textcolor=color.white, size=size.small))


f_block17()

f_block16() =>
    if i_moteurCHOCH and i_showMSS
        if mssHaussier and not na(bsh1)
            if array.size(_mssLines) >= _bosMaxVis
                line.delete(array.shift(_mssLines))
            if array.size(_mssLbls) >= _bosMaxVis
                label.delete(array.shift(_mssLbls))
            array.push(_mssLines, line.new(bsh1, sh1, bar_index, sh1, xloc=xloc.bar_index,
                 color=C_MSS_BULL, width=2, style=line.style_dashed))
            array.push(_mssLbls, label.new(bar_index, sh1, "Market Structure Shift ▲", xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_down, color=C_MSS_BULL, textcolor=color.white, size=size.small))
        if mssBaissier and not na(bsl1)
            if array.size(_mssLines) >= _bosMaxVis
                line.delete(array.shift(_mssLines))
            if array.size(_mssLbls) >= _bosMaxVis
                label.delete(array.shift(_mssLbls))
            array.push(_mssLines, line.new(bsl1, sl1, bar_index, sl1, xloc=xloc.bar_index,
                 color=C_MSS_BEAR, width=2, style=line.style_dashed))
            array.push(_mssLbls, label.new(bar_index, sl1, "Market Structure Shift ▼", xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_up, color=C_MSS_BEAR, textcolor=color.white, size=size.small))


f_block16()

f_block15() =>
    if i_moteurCHOCH and i_showCHOCH
        if chochHaussier and not na(bsh1)
            if array.size(_chochLines) >= _bosMaxVis
                line.delete(array.shift(_chochLines))
            if array.size(_chochLbls) >= _bosMaxVis
                label.delete(array.shift(_chochLbls))
            array.push(_chochLines, line.new(bsh1, sh1, bar_index, sh1, xloc=xloc.bar_index,
                 color=C_CHOCH_BULL, width=3, style=line.style_solid))
            array.push(_chochLbls, label.new(bar_index, sh1, "CHange Of CHaracter ▲", xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_down, color=C_CHOCH_BULL, textcolor=color.white, size=size.small))
        if chochBaissier and not na(bsl1)
            if array.size(_chochLines) >= _bosMaxVis
                line.delete(array.shift(_chochLines))
            if array.size(_chochLbls) >= _bosMaxVis
                label.delete(array.shift(_chochLbls))
            array.push(_chochLines, line.new(bsl1, sl1, bar_index, sl1, xloc=xloc.bar_index,
                 color=C_CHOCH_BEAR, width=3, style=line.style_solid))
            array.push(_chochLbls, label.new(bar_index, sl1, "CHange Of CHaracter ▼", xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_up, color=C_CHOCH_BEAR, textcolor=color.white, size=size.small))


f_block15()

// MODULE 4 — LIQUIDITÉ (Equal Highs / Equal Lows)
var string GRP_L  = "📊 Structure & Price Action"
bool  i_showLiq   = input.bool (false,  "EQual High / EQual Low",          group=GRP_L)
float i_tolEq     = 0.20  // Tolérance EQH/EQL (× ATR14) — refonte 2026-07-27 (0.10→0.20)
float i_tolCluster = 0.50 // Tolérance regroupement niveaux proches (× ATR14) — refonte 2026-07-28

color C_EQH       = #FFD600   // jaune (EQH)
color C_EQL       = #00BCD4   // cyan (EQL)
color C_LIQ_DEV   = #9E9E9E   // gris (1 touche = en formation)
color C_LIQ_SWEEP = #616161   // gris foncé (niveau sweepé)

// UDT LiqLevel : un niveau de liquidité EQH/EQL avec compteur de touches et état sweep.
// Refonte 2026-07-27 : remplace les anciens arrays _liqLines/_liqLbls (FIFO simple sans comptage).
type LiqLevel
    float  price     // niveau moyen (moyenne des pivots touchés)
    int    tFirst    // bar_index du 1er pivot (bord gauche de la ligne)
    int    tTime     // timestamp (ms) du 1er pivot — pour la table debug sans
                     // opérateur [] (qui plafonne à 5000 barres en arrière)
    int    touches   // nombre de pivots touchés (2=développement, 3+=confirmé)
    bool   swept     // true si le prix a traversé le niveau puis est revenu
    bool   isHigh    // true=EQH, false=EQL

var array<LiqLevel> liqPool = array.new<LiqLevel>(0)
int _maxLiq = 20   // FIFO max niveaux EQH/EQL

float tolEq = i_tolEq * atr14
float tolCluster = i_tolCluster * atr14   // tolérance regroupement (plus large que détection)
bool  isEQH = not na(ph) and not na(sh2) and math.abs(sh1 - sh2) <= tolEq
bool  isEQL = not na(pl) and not na(sl2) and math.abs(sl1 - sl2) <= tolEq

var float dernierEQH_level = na
var float dernierEQL_level = na

// Diagnostic vague 3 : compter évaluations/créations et mémoriser la
// DERNIÈRE évaluation isEQH (valeurs + tolérance).
var int _diagEvalH = 0
var int _diagCreat = 0
var float _diagSh1 = na
var float _diagSh2 = na
var float _diagTolEq = na
var int _diagLastPivBar = na
var float _diagPh = na

// f_liqUpdate : met à jour le pool liqPool avec un nouveau pivot.
// - Si un niveau existant du même type est dans la tolérance → incrémente touches + MAJ price.
// - Sinon → crée un nouveau niveau (touches=2 car sh1+sh2 = 2 pivots à la création).
// Param : isHigh=true pour EQH (sh1/sh2), false pour EQL (sl1/sl2).
// NB : la fonction ne retourne rien (void). Le 'true' final explicite évite l'erreur Pine
// "Return type of one of the if/else blocks is not compatible" (L580 sans le true).
f_liqUpdate(bool _isHigh, float _p1, float _p2, int _bp2, int _tp2) =>
    float _newPrice = (_p1 + _p2) / 2.0
    int   _foundIdx = -1
    // Chercher un niveau existant du même type dans la tolérance du nouveau pivot.
    if array.size(liqPool) > 0
        for _i = 0 to array.size(liqPool) - 1
            LiqLevel _ll = array.get(liqPool, _i)
            if _ll.isHigh == _isHigh and not _ll.swept
                if math.abs(_ll.price - _p1) <= tolCluster
                    _foundIdx := _i
                    break
    if _foundIdx >= 0
        // Niveau existant → incrémenter touches et recalculer price (moyenne cumulée).
        LiqLevel _ll = array.get(liqPool, _foundIdx)
        _ll.touches := _ll.touches + 1
        _ll.price   := (_ll.price * (_ll.touches - 1) + _p1) / _ll.touches
    else
        // Nouveau niveau (2 pivots à la création via sh1+sh2 ou sl1+sl2).
        if array.size(liqPool) >= _maxLiq
            array.shift(liqPool)
        array.push(liqPool, LiqLevel.new(price=_newPrice, tFirst=_bp2, tTime=_tp2, touches=2, swept=false, isHigh=_isHigh))
    true   // explicit void return (évite l'erreur Pine de type de retour incompatible if/else)

if not na(ph) and not na(sh2)
    _diagEvalH += 1
    _diagSh1 := sh1
    _diagSh2 := sh2
    _diagTolEq := tolEq
    _diagLastPivBar := bar_index
    _diagPh := ph
if i_moteurLiquidite and isEQH and not na(bsh2)
    _diagCreat += 1
    dernierEQH_level := (sh1 + sh2) / 2.0
    int _iBH = na(bsh2) ? 0 : math.min(bsh2, 5000)
    f_liqUpdate(true, sh1, sh2, bsh2, time[_iBH])
if i_moteurLiquidite and isEQL and not na(bsl2)
    dernierEQL_level := (sl1 + sl2) / 2.0
    int _iBL = na(bsl2) ? 0 : math.min(bsl2, 5000)
    f_liqUpdate(false, sl1, sl2, bsl2, time[_iBL])

// 3e touche isolée : un pivot haut confirmé (ph) qui n'est PAS égal à sh2 (isEQH=false)
// MAIS qui est dans la tolérance d'un niveau EQH existant → incrémente touches.
if i_moteurLiquidite and not isEQH and not na(ph) and not na(sh2)
    if array.size(liqPool) > 0
        for _i = 0 to array.size(liqPool) - 1
            LiqLevel _ll = array.get(liqPool, _i)
            if _ll.isHigh and not _ll.swept and math.abs(_ll.price - sh1) <= tolCluster
                _ll.touches := _ll.touches + 1
                _ll.price   := (_ll.price * (_ll.touches - 1) + sh1) / _ll.touches
                break
if i_moteurLiquidite and not isEQL and not na(pl) and not na(sl2)
    if array.size(liqPool) > 0
        for _i = 0 to array.size(liqPool) - 1
            LiqLevel _ll = array.get(liqPool, _i)
            if not _ll.isHigh and not _ll.swept and math.abs(_ll.price - sl1) <= tolCluster
                _ll.touches := _ll.touches + 1
                _ll.price   := (_ll.price * (_ll.touches - 1) + sl1) / _ll.touches
                break

// f_liqLabels : dessine/redessine les lignes EQH/EQL depuis liqPool.
// Refonte 2026-07-27 : distinction visuelle selon touches + grisage si sweepé.
var array<line>  _liqLines = array.new<line>(0)
var array<label> _liqLbls  = array.new<label>(0)

f_liqLabels() =>
    if i_moteurLiquidite and i_showLiq and array.size(liqPool) > 0
        // Nettoyer anciennes lignes/labels puis tout redessiner depuis liqPool.
        if array.size(_liqLines) > 0
            for _i = 0 to array.size(_liqLines) - 1
                line.delete(array.get(_liqLines, _i))
            array.clear(_liqLines)
        if array.size(_liqLbls) > 0
            for _i = 0 to array.size(_liqLbls) - 1
                label.delete(array.get(_liqLbls, _i))
            array.clear(_liqLbls)
        for _i = 0 to array.size(liqPool) - 1
            LiqLevel _ll = array.get(liqPool, _i)
            // « Décisions trading » : niveau touché = consommé = PAS AFFICHÉ.
            if _ll.swept
                continue
            // Couleur/épaisseur selon touches.
            color _c   = _ll.isHigh ? C_EQH : C_EQL
            int   _w   = 1
            if _ll.touches >= 3
                _w := 2
            string _txt = (_ll.isHigh ? "EQH" : "EQL") + " ×" + str.tostring(_ll.touches)
            color _txtColor = _ll.isHigh ? color.black : color.white
            array.push(_liqLines, line.new(_ll.tFirst, _ll.price, bar_index, _ll.price, xloc=xloc.bar_index,
                color=_c, width=_w, style=line.style_dashed, extend=extend.none))
            array.push(_liqLbls, label.new(bar_index, _ll.price, _txt, xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_left, color=_c, textcolor=_txtColor, size=size.small))

f_liqLabels()

// MODULE 5 — SWEEP (Manipulation de Liquidité)
var string GRP_W  = "📊 Structure & Price Action"
bool  i_showSwp   = input.bool(false, "Sweeps",               group=GRP_W)
int   i_maxSwpB   = 3

color C_SWEEP_BULL = #00E676
color C_SWEEP_BEAR = #FF1744

var int   sweepH_bar   = na
var float sweepH_level = na
var int   sweepB_bar   = na
var float sweepB_level = na

if i_moteurSweep
    if not na(dernierEQL_level) and low < dernierEQL_level and na(sweepH_bar)
        sweepH_bar   := bar_index
        sweepH_level := dernierEQL_level
    if not na(dernierEQH_level) and high > dernierEQH_level and na(sweepB_bar)
        sweepB_bar   := bar_index
        sweepB_level := dernierEQH_level
    if not na(sweepH_bar) and (bar_index - sweepH_bar) > i_maxSwpB
        sweepH_bar   := na
        sweepH_level := na
    if not na(sweepB_bar) and (bar_index - sweepB_bar) > i_maxSwpB
        sweepB_bar   := na
        sweepB_level := na

bool sweepHaussier = i_moteurSweep and not na(sweepH_bar) and close > sweepH_level
bool sweepBaissier = i_moteurSweep and not na(sweepB_bar) and close < sweepB_level

var float dernierSweepH_level = na
var int   dernierSweepH_bar   = na
var float dernierSweepB_level = na
var int   dernierSweepB_bar   = na

if sweepHaussier
    dernierSweepH_level := sweepH_level
    dernierSweepH_bar   := bar_index
    sweepH_bar          := na
    sweepH_level        := na
    dernierEQL_level    := na  // niveau consommé — invalide après sweep (scoring/DoL)
    // « Décisions trading » 2026-08-23 : les niveaux touchés DISPARAISSENT
    // (le gris « contexte historique » est supprimé — décision propriétaire).
    if array.size(liqPool) > 0
        for _i = 0 to array.size(liqPool) - 1
            LiqLevel _ll = array.get(liqPool, _i)
            if not _ll.isHigh and not _ll.swept and math.abs(_ll.price - sweepH_level) <= tolEq
                _ll.swept := true
                break

if sweepBaissier
    dernierSweepB_level := sweepB_level
    dernierSweepB_bar   := bar_index
    sweepB_bar          := na
    sweepB_level        := na
    dernierEQH_level    := na  // niveau consommé — invalide après sweep (scoring/DoL)
    if array.size(liqPool) > 0
        for _i = 0 to array.size(liqPool) - 1
            LiqLevel _ll = array.get(liqPool, _i)
            if _ll.isHigh and not _ll.swept and math.abs(_ll.price - sweepB_level) <= tolEq
                _ll.swept := true
                break

// « Décisions trading » 2026-08-23 (option A) : tout niveau ATTEINT sur bar
// confirmée est consommé — dernierEQH/EQL (couvre la CASSURE, le sweep étant
// déjà traité ci-dessus) et pool liqPool (purge, plus d'affichage gris).
if barstate.isconfirmed and not na(dernierEQH_level) and high >= dernierEQH_level
    dernierEQH_level := na
if barstate.isconfirmed and not na(dernierEQL_level) and low <= dernierEQL_level
    dernierEQL_level := na
if barstate.isconfirmed and array.size(liqPool) > 0
    for _i = 0 to array.size(liqPool) - 1
        LiqLevel _ll = array.get(liqPool, _i)
        if not _ll.swept
            if (_ll.isHigh and high >= _ll.price) or (not _ll.isHigh and low <= _ll.price)
                _ll.swept := true

// Phase 5.1 : un sweep ne compte au scoring que s'il est RÉCENT (≤ N barres).
// Sans cela, dernierSweep*_level persistait indéfiniment → présent dans 94-100 % des trades.
// Étape 3 : fenêtre exprimée en DURÉE RÉELLE (réf M15 validée = 5 barres × 900 s = 4500 s),
// traduite en barres selon le TF courant → comportement identique sur M5/M15/M30/tout TF.
// M15 : round(4500/900)=5 (non-régression exacte) · M5 : 15 · M30 : 3 · plancher 1.
int _tfSec = timeframe.in_seconds()
int SWEEP_FRESH_BARS = na(_tfSec) or _tfSec <= 0 ? 5 : math.max(1, int(math.round(4500.0 / _tfSec)))
bool _sweepBullFrais = not na(dernierSweepH_level) and not na(dernierSweepH_bar) and (bar_index - dernierSweepH_bar) <= SWEEP_FRESH_BARS
bool _sweepBearFrais = not na(dernierSweepB_level) and not na(dernierSweepB_bar) and (bar_index - dernierSweepB_bar) <= SWEEP_FRESH_BARS

int _sweepMaxVis = 6
var array<label> _sweepLbls = array.new<label>(0)

if i_moteurSweep and i_showSwp
    if sweepHaussier
        if array.size(_sweepLbls) >= _sweepMaxVis
            label.delete(array.shift(_sweepLbls))
        array.push(_sweepLbls, label.new(bar_index, low, "Sweep ▲", xloc=xloc.bar_index, yloc=yloc.price,
             style=label.style_label_up, color=C_SWEEP_BULL, textcolor=color.white, size=size.small))
    if sweepBaissier
        if array.size(_sweepLbls) >= _sweepMaxVis
            label.delete(array.shift(_sweepLbls))
        array.push(_sweepLbls, label.new(bar_index, high, "Sweep ▼", xloc=xloc.bar_index, yloc=yloc.price,
             style=label.style_label_down, color=C_SWEEP_BEAR, textcolor=color.white, size=size.small))

// MODULE 6 — FVG (Fair Value Gap)
var string GRP_F  = "🏦 Order Blocks & FVG"
bool  i_showFVG   = input.bool (false,  "Fair Value Gap",                             group=GRP_F)
bool  i_masquerInactifs = false  // P : en dur OFF — zones partiellement mitigées conservées (recolorées), seules les zones totalement comblées sont supprimées
float i_minFVG    = 0.20  // Taille minimale FVG (× ATR14) — calibré, stable
int   i_maxFVG    = 10    // FVG actifs max par sens — en dur
int   i_fvgMaxAge = 50

color C_FVG_BULL_FRESH   = color.new(#00C853, 93)
color C_FVG_BULL_PARTIAL = color.new(#00C853, 96)
color C_FVG_BEAR_FRESH   = color.new(#D50000, 93)
color C_FVG_BEAR_PARTIAL = color.new(#D50000, 96)
color C_FVG_BORDER       = color.new(color.white, 85)

float minGap  = i_minFVG * atr14
bool  isFVGBull = i_moteurFVG and (low  - high[2]) > minGap
bool  isFVGBear = i_moteurFVG and (low[2] - high)  > minGap

var array<float> fvgBullTop   = array.new<float>(0)
var array<float> fvgBullBot   = array.new<float>(0)
var array<int>   fvgBullState = array.new<int>(0)
var array<box>   fvgBullBox   = array.new<box>(0)
var array<int>   fvgBullBar   = array.new<int>(0)
var array<float> fvgBearTop   = array.new<float>(0)
var array<float> fvgBearBot   = array.new<float>(0)
var array<int>   fvgBearState = array.new<int>(0)
var array<box>   fvgBearBox   = array.new<box>(0)
var array<int>   fvgBearBar   = array.new<int>(0)

f_fvgBullCreate() =>
    if isFVGBull
        if array.size(fvgBullBox) >= i_maxFVG
            box _bxF = array.shift(fvgBullBox)
            if not na(_bxF)
                box.delete(_bxF)
            array.shift(fvgBullTop)
            array.shift(fvgBullBot)
            array.shift(fvgBullState)
            array.shift(fvgBullBar)
        float topB = low
        float botB = high[2]
        array.push(fvgBullTop,   topB)
        array.push(fvgBullBot,   botB)
        array.push(fvgBullState, 0)
        array.push(fvgBullBar,   bar_index[2])
        array.push(fvgBullBox, i_showFVG ? box.new(bar_index[2], topB, bar_index + 50, botB,
             bgcolor=C_FVG_BULL_FRESH, border_color=C_FVG_BORDER, border_width=1,
             text="Fair Value Gap", text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE,
             text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN) : na)


f_fvgBullCreate()

f_fvgBearCreate() =>
    if isFVGBear
        if array.size(fvgBearBox) >= i_maxFVG
            box _bxF = array.shift(fvgBearBox)
            if not na(_bxF)
                box.delete(_bxF)
            array.shift(fvgBearTop)
            array.shift(fvgBearBot)
            array.shift(fvgBearState)
            array.shift(fvgBearBar)
        float topBr = low[2]
        float botBr = high
        array.push(fvgBearTop,   topBr)
        array.push(fvgBearBot,   botBr)
        array.push(fvgBearState, 0)
        array.push(fvgBearBar,   bar_index[2])
        array.push(fvgBearBox, i_showFVG ? box.new(bar_index[2], topBr, bar_index + 50, botBr,
             bgcolor=C_FVG_BEAR_FRESH, border_color=C_FVG_BORDER, border_width=1,
             text="Fair Value Gap", text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE,
             text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN) : na)


f_fvgBearCreate()

f_fvgBullLifecycle() =>
    if i_moteurFVG and array.size(fvgBullTop) > 0 and barstate.isconfirmed
        array<int> _bullDel = array.new<int>(0)
        for i = 0 to array.size(fvgBullTop) - 1
            float topB    = array.get(fvgBullTop, i)
            float botB    = array.get(fvgBullBot, i)
            bool  _oldFVG = i_fvgMaxAge > 0 and (bar_index - array.get(fvgBullBar, i)) > i_fvgMaxAge
            if close < botB or _oldFVG
                box _bxD = array.get(fvgBullBox, i)
                if not na(_bxD)
                    box.delete(_bxD)
                array.push(_bullDel, i)
            else
                if barstate.islast
                    box _bxS = array.get(fvgBullBox, i)
                    if not na(_bxS)
                        box.set_right(_bxS, bar_index + 50)
                if low < topB and array.get(fvgBullState, i) == 0
                    array.set(fvgBullState, i, 1)
                    box _bxC = array.get(fvgBullBox, i)
                    if i_masquerInactifs
                        if not na(_bxC)
                            box.delete(_bxC)
                            array.set(fvgBullBox, i, na)
                    else
                        if not na(_bxC)
                            box.set_bgcolor(_bxC, C_FVG_BULL_PARTIAL)
        if array.size(_bullDel) > 0
            array.sort(_bullDel, order.descending)
            for j = 0 to array.size(_bullDel) - 1
                int idx = array.get(_bullDel, j)
                array.remove(fvgBullBox,   idx)
                array.remove(fvgBullTop,   idx)
                array.remove(fvgBullBot,   idx)
                array.remove(fvgBullState, idx)
                array.remove(fvgBullBar,   idx)


f_fvgBullLifecycle()

f_fvgBearLifecycle() =>
    if i_moteurFVG and array.size(fvgBearTop) > 0 and barstate.isconfirmed
        array<int> _bearDel = array.new<int>(0)
        for i = 0 to array.size(fvgBearTop) - 1
            float topBr   = array.get(fvgBearTop, i)
            float botBr   = array.get(fvgBearBot, i)
            bool  _oldFVG = i_fvgMaxAge > 0 and (bar_index - array.get(fvgBearBar, i)) > i_fvgMaxAge
            if close > topBr or _oldFVG
                box _bxD = array.get(fvgBearBox, i)
                if not na(_bxD)
                    box.delete(_bxD)
                array.push(_bearDel, i)
            else
                if barstate.islast
                    box _bxS = array.get(fvgBearBox, i)
                    if not na(_bxS)
                        box.set_right(_bxS, bar_index + 50)
                if high > botBr and array.get(fvgBearState, i) == 0
                    array.set(fvgBearState, i, 1)
                    box _bxC = array.get(fvgBearBox, i)
                    if i_masquerInactifs
                        if not na(_bxC)
                            box.delete(_bxC)
                            array.set(fvgBearBox, i, na)
                    else
                        if not na(_bxC)
                            box.set_bgcolor(_bxC, C_FVG_BEAR_PARTIAL)
        if array.size(_bearDel) > 0
            array.sort(_bearDel, order.descending)
            for j = 0 to array.size(_bearDel) - 1
                int idx = array.get(_bearDel, j)
                array.remove(fvgBearBox,   idx)
                array.remove(fvgBearTop,   idx)
                array.remove(fvgBearBot,   idx)
                array.remove(fvgBearState, idx)
                array.remove(fvgBearBar,   idx)


f_fvgBearLifecycle()

// ── Barème de seuils PAR ASSET (Phase 6) ─────────────────────────────────────
// Un seul jeu de constantes partagé par le mapping de force (f_force) et les classes.
// Recalibré sur les scores max réels observés post-Phase 7 (M15) :
//   XAU=13, XAG=14, NAS=19, DAX=21, BTC=15.
// Référence validée XAU 7/10/12 (≈54%/77%/92% du max) propagée proportionnellement aux autres.
//   XAU 7/10/12 — NAS 10/15/17 — DAX 11/16/19
//   (NAS Instit ramené 18→17 : palier WR 78 / R 0.94 excellent mais N=9 ; 17 le repeuple ≥10 sans diluer)
// Phase 8 — XAG & BTC : score NON-DISCRIMINANT (WR plat/inversé entre bandes, prédicteurs trop rares).
//   → classes Fort/Instit DÉSACTIVÉES (seuils inatteignables) : ces assets restent en « Moyen-only ».
//     Le signal exploitable y est le seuil Moyen+ lui-même (WR ~58-62, R positif). Évite tout overfitting.
bool _plafondMoyen = _isXAG or _isBTC
int SEUIL_MOYEN  = _isDAX ? 11 : _isNAS ? 10 : _isBTC ? 8 : 7
int SEUIL_FORT   = _plafondMoyen ? 99 : _isDAX ? 16 : _isNAS ? 15 : 10
int SEUIL_INSTIT = _plafondMoyen ? 99 : _isDAX ? 19 : _isNAS ? 17 : 12

// Phase 11 — score max observé par asset (dénominateur affiché dans le label de trade)
int _scoreMax = _isXAU ? 13 : _isXAG ? 14 : _isNAS ? 19 : _isDAX ? 21 : _isBTC ? 15 : 0

int seuilTrade = 0  // tous les retours OB génèrent un trade ; le tri visuel se fait au score /10 (zones + labels)

// Phase 11.2 — Force /10 par mapping sur les bandes calibrées (SEUIL_MOYEN/FORT/INSTIT).
// Convertit le score brut (borne théorique ~70, _scoreMax observé) en note intuitive 1→10,
// en réutilisant la calibration par asset :
//   < Moyen → 1-4 (faible) · Moyen→Fort → 5-6 (correct) · Fort→Instit → 7-8 (fort) · ≥ Instit → 9-10 (excellent).
// Assets « Moyen-only » (XAG/BTC, Fort=Instit=99) : la note plafonne naturellement vers 5-6 (fiabilité moindre assumée).
f_force(int sc) =>
    float _f = 0.0
    if sc < SEUIL_MOYEN
        _f := 1.0 + 3.0 * sc / math.max(1, SEUIL_MOYEN)
    else if sc < SEUIL_FORT
        _f := 5.0 + 1.0 * (sc - SEUIL_MOYEN) / math.max(1, SEUIL_FORT - SEUIL_MOYEN)
    else if sc < SEUIL_INSTIT
        _f := 7.0 + 1.0 * (sc - SEUIL_FORT) / math.max(1, SEUIL_INSTIT - SEUIL_FORT)
    else
        _f := 9.0 + 1.0 * (sc - SEUIL_INSTIT) / math.max(1, _scoreMax - SEUIL_INSTIT)
    int(math.min(10, math.max(1, math.round(_f))))

// P5.1 — ÉCHELLE DE FORCE UNIFIÉE : OB, trades, alertes ET zones utilisent tous f_force (/10).
// f_force20 (/20) supprimé — cohérence d'affichage + gain de tokens.
// Constantes C_FAIBLE/MOYEN/FORT/INSTIT supprimées (étaient utilisées uniquement par f_couleur, elle-même orpheline).

// MODULE 7 — ORDER BLOCKS
var string GRP_O  = "🏦 Order Blocks & FVG"
bool  i_showOB    = input.bool  (true,       "Order Blocks",                             group=GRP_O)
int   i_maxOB     = 40    // OB actifs max par sens — aligné module standalone


color C_OB_BULL_FRESH  = color.new(#00C853, 70)
color C_OB_BULL_PART   = color.new(#00C853, 83)
color C_OB_BULL_DEEP   = color.new(#00C853, 91)
color C_OB_BEAR_FRESH  = color.new(#D50000, 70)
color C_OB_BEAR_PART   = color.new(#D50000, 83)
color C_OB_BEAR_DEEP   = color.new(#D50000, 91)
color C_OB_BDR_BULL    = color.new(#00C853, 20)
color C_OB_BDR_BEAR    = color.new(#D50000, 20)

// Détection OB — modèle ROC aligné sur OB 5 étoiles
// ROC = (high-low)/close × 10000 bps — range complet (mèches incluses)
// OB BULLISH : impulsion haussière (ROC ≥ seuil, close > open) + bougie[1] baissière
// OB BEARISH : impulsion baissière (ROC ≥ seuil, open > close) + bougie[1] haussière
float _rocCur = close != 0.0 ? (high - low) / close * 10000.0 : 0.0
bool  _rocOk  = _rocCur >= i_rocSeuil

bool _obImpulseBull = barstate.isconfirmed and (close > open) and (close[1] < open[1]) and _rocOk
bool _obImpulseBear = barstate.isconfirmed and (open  > close) and (close[1] > open[1]) and _rocOk

// Debug vague 3 : table des niveaux EQH/EQL (prix + date + touches + swept).
bool i_debugLiq = input.bool(false, "Debug : table EQH/EQL")

bool newBullOB = i_moteurOB and _obImpulseBull
bool newBearOB = i_moteurOB and _obImpulseBear

var array<float> obBullTop   = array.new<float>(0)
var array<float> obBullBot   = array.new<float>(0)
var array<int>   obBullState = array.new<int>(0)
var array<box>   obBullBox   = array.new<box>(0)
var array<int>   obBullTime  = array.new<int>(0)
var array<int>   obBullBar   = array.new<int>(0)
var array<float> obBearTop   = array.new<float>(0)
var array<float> obBearBot   = array.new<float>(0)
var array<int>   obBearState = array.new<int>(0)
var array<box>   obBearBox   = array.new<box>(0)
var array<int>   obBearTime  = array.new<int>(0)
var array<int>   obBearBar   = array.new<int>(0)
var array<bool>  obBullIsIB      = array.new<bool>(0)
var array<bool>  obBearIsIB      = array.new<bool>(0)
var array<bool>  obBullSignaled  = array.new<bool>(0)
var array<bool>  obBearSignaled  = array.new<bool>(0)
var array<int>   obBullScore    = array.new<int>(0)
var array<int>   obBearScore    = array.new<int>(0)
// Arrays zone-cœur (Étape 1a) — parallèles aux OB (sous-box d'intersection OB∩OTE∩FVG)
var array<box>   obBullCoreBox  = array.new<box>(0)
var array<box>   obBearCoreBox  = array.new<box>(0)

// MODULE 4b — ZONES D'ACHAT / DE VENTE (remplacé par le moteur BSZones — voir module dédié)
// Ancien système (obBullZoneBox/f_zonesLifecycle/labels ACHAT-VENTE) retiré 2026-07-31.
// Les zones BSZones sont désormais indépendantes des OB (détection Sweep→Disp→OB canonique ICT).
var string GRP_ZN  = "🎯 Signaux & Zones"
bool  i_showZones  = input.bool(true,  "Zones d'Achat/Vente", group=GRP_ZN)
// ── Filtres qualité des zones (v11, codés en dur, validés campagnes 2026-07-19) ─────────────
// CONSERVÉS : utilisés par f_createBuySignals/Sell (moteur OB) pour qualifier les trades OB.
// Combo gagnant = P1.2 (FVG) + P2.3 (DoL), SAUF DAX M15/M30 (_znDaxHTF neutralise).
bool  _znDaxHTF    = _isDAX and _tf >= 15                 // DAX M15/M30 : filtres neutralisés
bool  i_znFvgReq   = not _znDaxHTF                         // P1.2 ON (sauf DAX M15/M30)
bool  i_znDolReq   = not _znDaxHTF                         // P2.3 ON (sauf DAX M15/M30)

// MODULE 8b — BREAKER BLOCKS (déclarations)
// Déclaré ici car le lifecycle OB (MODULE 7) crée des Breakers lors des invalidations
var string GRP_BB = "🏦 Order Blocks & FVG"
bool i_showBB = input.bool(false, "Breaker Blocks", group=GRP_BB)
int  i_maxBB  = 5  // Breaker Blocks max par sens — en dur

// Bearish Breaker = Bull OB invalidé (close < bas) — zone de résistance
var array<float> bbBearTop = array.new<float>(0)
var array<float> bbBearBot = array.new<float>(0)
var array<box>   bbBearBox = array.new<box>(0)
// Bullish Breaker = Bear OB invalidé (close > haut) — zone de support
var array<float> bbBullTop = array.new<float>(0)
var array<float> bbBullBot = array.new<float>(0)
var array<box>   bbBullBox = array.new<box>(0)

color C_BB_BEAR = color.new(#D50000, 93)  // rouge estompé — Bearish Breaker (uniformisé)
color C_BB_BULL = color.new(#00C853, 93)  // vert estompé — Bullish Breaker (uniformisé)
color C_BB_BDR  = color.new(color.white, 60)

f_newBullOB() =>
    if newBullOB
        // OB BULLISH = la bougie juste avant l'impulsion haussière (high[1]/low[1])
        float _obT = high[1]
        float _obB = low[1]
        int   _obX = bar_index[1]
        if array.size(obBullTop) >= i_maxOB
            box   _bxB = array.shift(obBullBox)
            if not na(_bxB)
                box.delete(_bxB)
            array.shift(obBullTop)
            array.shift(obBullBot)
            array.shift(obBullState)
            array.shift(obBullTime)
            array.shift(obBullBar)
            array.shift(obBullIsIB)
            array.shift(obBullSignaled)
            array.shift(obBullScore)
            // Sous-bloc zone-cœur : supprimé avec l'OB parent (plus valable pour le trading)
            box   _coBxB = array.shift(obBullCoreBox)
            if not na(_coBxB)
                box.delete(_coBxB)
        array.push(obBullTop,      _obT)
        array.push(obBullBot,      _obB)
        array.push(obBullState,    0)
        array.push(obBullTime,     int(time[1]))
        array.push(obBullBar,      bar_index)  // bougie impulsion = garde anti-suppression immédiate
        array.push(obBullIsIB,     ibBull[1])
        array.push(obBullSignaled, false)
        array.push(obBullScore,    0)
        array.push(obBullCoreBox,  na)
        if i_showOB
            array.push(obBullBox, box.new(_obX, _obT, bar_index + 50, _obB,
                bgcolor=C_OB_BULL_FRESH, border_color=C_OB_BDR_BULL, border_width=2,
                text="Order Blo", text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE,
                text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN))
        else
            array.push(obBullBox, na)


f_newBullOB()

f_newBearOB() =>
    if newBearOB
        // OB BEARISH = la bougie juste avant l'impulsion baissière (high[1]/low[1])
        float _obT = high[1]
        float _obB = low[1]
        int   _obX = bar_index[1]
        if array.size(obBearTop) >= i_maxOB
            box   _bxBr = array.shift(obBearBox)
            if not na(_bxBr)
                box.delete(_bxBr)
            array.shift(obBearTop)
            array.shift(obBearBot)
            array.shift(obBearState)
            array.shift(obBearTime)
            array.shift(obBearBar)
            array.shift(obBearIsIB)
            array.shift(obBearSignaled)
            array.shift(obBearScore)
            // Sous-bloc zone-cœur : supprimé avec l'OB parent (plus valable pour le trading)
            box   _coBxR = array.shift(obBearCoreBox)
            if not na(_coBxR)
                box.delete(_coBxR)
        array.push(obBearTop,      _obT)
        array.push(obBearBot,      _obB)
        array.push(obBearState,    0)
        array.push(obBearTime,     int(time[1]))
        array.push(obBearBar,      bar_index)  // bougie impulsion = garde anti-suppression immédiate
        array.push(obBearIsIB,     ibBear[1])
        array.push(obBearSignaled, false)
        array.push(obBearScore,    0)
        array.push(obBearCoreBox,  na)
        if i_showOB
            array.push(obBearBox, box.new(_obX, _obT, bar_index + 50, _obB,
                bgcolor=C_OB_BEAR_FRESH, border_color=C_OB_BDR_BEAR, border_width=2,
                text="Order Block", text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE,
                text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN))
        else
            array.push(obBearBox, na)


f_newBearOB()

f_obLifecycle() =>
    array<int> _obBullDel = array.new<int>(0)
    if i_moteurOB and array.size(obBullTop) > 0 and barstate.isconfirmed
        for i = 0 to array.size(obBullTop) - 1
            float topB    = array.get(obBullTop, i)
            float botB    = array.get(obBullBot, i)
            float mid     = (topB + botB) / 2.0
            bool  expired = false
            // Invalide si low atteint le haut de la zone (bord supérieur) — aligné OB 5 étoiles
            // Garde anti-suppression immédiate : ignorer la bougie de création
            int   _obBarB    = array.get(obBullBar, i)
            bool  _signaledB = array.get(obBullSignaled, i)
            // Invalide dès que low atteint le haut de la zone — aligné OB 5 étoiles
            bool  _invalB = low <= topB
            if (bar_index > _obBarB and _invalB) or expired
                box   _bxD = array.get(obBullBox, i)
                if not na(_bxD)
                    box.delete(_bxD)
                // Breaker Block : Bull OB invalidé par close < bas — devient Bearish Breaker
                // La zone reste identique à l'ancien OB, elle agit désormais comme résistance
                // Correctif 1.1 : ne créer un Breaker que sur une vraie invalidation directionnelle
                // (close < botB), pas sur le simple nettoyage d'un OB signalé (low <= topB).
                if not expired and close < botB
                    if array.size(bbBearTop) >= i_maxBB
                        box _bxBB = array.shift(bbBearBox)
                        if not na(_bxBB)
                            box.delete(_bxBB)
                        array.shift(bbBearTop)
                        array.shift(bbBearBot)
                    array.push(bbBearTop, topB)
                    array.push(bbBearBot, botB)
                    if i_showBB
                        array.push(bbBearBox, box.new(bar_index, topB, bar_index + 50, botB,
                             bgcolor=C_BB_BEAR, border_color=C_BB_BDR, border_width=1,
                             text="BREAKER", text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE,
                             text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN))
                    else
                        array.push(bbBearBox, na)
                array.push(_obBullDel, i)
            else
                box _bxK = array.get(obBullBox, i)
                // Filtre affichage : masquer les OB faibles pour réduire le bruit visuel.
                // Seuil réglable (test de vérité 2026-08-19) — défaut 5 = historique codé dur.
                bool _affiche = f_force(array.get(obBullScore, i)) >= i_affObForce
                if not na(_bxK)
                    box.set_right(_bxK, bar_index + 50)
                    int _stNow = array.get(obBullState, i)
                    color _coul = _stNow == 2 ? C_OB_BULL_DEEP : _stNow == 1 ? C_OB_BULL_PART : C_OB_BULL_FRESH
                    box.set_bgcolor(_bxK, _affiche ? _coul : na)
                    box.set_border_color(_bxK, _affiche ? C_OB_BDR_BULL : na)
                if low <= topB
                    int st = array.get(obBullState, i)
                    if close <= mid and st < 2
                        array.set(obBullState, i, 2)
                        if not na(_bxK) and _affiche
                            box.set_bgcolor(_bxK, C_OB_BULL_DEEP)
                    else if close > mid and st == 0
                        array.set(obBullState, i, 1)
                        if not na(_bxK) and _affiche
                            box.set_bgcolor(_bxK, C_OB_BULL_PART)
        if array.size(_obBullDel) > 0
            array.sort(_obBullDel, order.descending)
            for j = 0 to array.size(_obBullDel) - 1
                int idx = array.get(_obBullDel, j)
                array.remove(obBullBox,      idx)
                array.remove(obBullScore,    idx)
                array.remove(obBullTop,      idx)
                array.remove(obBullBot,      idx)
                array.remove(obBullState,    idx)
                array.remove(obBullTime,     idx)
                array.remove(obBullBar,      idx)
                array.remove(obBullIsIB,     idx)
                array.remove(obBullSignaled, idx)
                // Sous-bloc zone-cœur : supprimé avec l'OB parent (plus valable pour le trading)
                box   _rmCoBxB = array.get(obBullCoreBox, idx)
                if not na(_rmCoBxB)
                    box.delete(_rmCoBxB)
                array.remove(obBullCoreBox,  idx)

    array<int> _obBearDel = array.new<int>(0)
    if i_moteurOB and array.size(obBearTop) > 0 and barstate.isconfirmed
        for i = 0 to array.size(obBearTop) - 1
            float topBr   = array.get(obBearTop, i)
            float botBr   = array.get(obBearBot, i)
            float mid     = (topBr + botBr) / 2.0
            bool  expired = false
            // Invalide si high atteint le bas de la zone (bord inférieur) — aligné OB 5 étoiles
            // Garde anti-suppression immédiate : ignorer la bougie de création
            int   _obBarBr    = array.get(obBearBar, i)
            bool  _signaledBr = array.get(obBearSignaled, i)
            // Invalide dès que high atteint le bas de la zone — aligné OB 5 étoiles
            bool  _invalBr = high >= botBr
            if (bar_index > _obBarBr and _invalBr) or expired
                box   _bxDr = array.get(obBearBox, i)
                if not na(_bxDr)
                    box.delete(_bxDr)
                // Breaker Block : Bear OB invalidé par close > haut — devient Bullish Breaker
                // Correctif 1.1 : ne créer un Breaker que sur une vraie invalidation directionnelle
                // (close > topBr), pas sur le simple nettoyage d'un OB signalé (high >= botBr).
                if not expired and close > topBr
                    if array.size(bbBullTop) >= i_maxBB
                        box _bxBB = array.shift(bbBullBox)
                        if not na(_bxBB)
                            box.delete(_bxBB)
                        array.shift(bbBullTop)
                        array.shift(bbBullBot)
                    // La zone Bullish Breaker = zone exacte de l'ancien OB Bear
                    array.push(bbBullTop, topBr)  // haut = haut original de l'OB
                    array.push(bbBullBot, botBr)  // bas  = bas original de l'OB
                    if i_showBB
                        array.push(bbBullBox, box.new(bar_index, topBr, bar_index + 50, botBr,
                             bgcolor=C_BB_BULL, border_color=C_BB_BDR, border_width=1,
                             text="BREAKER", text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE,
                             text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN))
                    else
                        array.push(bbBullBox, na)
                array.push(_obBearDel, i)
            else
                box _bxKr = array.get(obBearBox, i)
                // Filtre affichage : masquer les OB faibles pour réduire le bruit visuel.
                // Seuil réglable (test de vérité 2026-08-19) — défaut 5 = historique codé dur.
                bool _afficheR = f_force(array.get(obBearScore, i)) >= i_affObForce
                if not na(_bxKr)
                    box.set_right(_bxKr, bar_index + 50)
                    int _stNow = array.get(obBearState, i)
                    color _coulR = _stNow == 2 ? C_OB_BEAR_DEEP : _stNow == 1 ? C_OB_BEAR_PART : C_OB_BEAR_FRESH
                    box.set_bgcolor(_bxKr, _afficheR ? _coulR : na)
                    box.set_border_color(_bxKr, _afficheR ? C_OB_BDR_BEAR : na)
                if high >= botBr
                    int st = array.get(obBearState, i)
                    if close >= mid and st < 2
                        array.set(obBearState, i, 2)
                        if not na(_bxKr) and _afficheR
                            box.set_bgcolor(_bxKr, C_OB_BEAR_DEEP)
                    else if close < mid and st == 0
                        array.set(obBearState, i, 1)
                        if not na(_bxKr) and _afficheR
                            box.set_bgcolor(_bxKr, C_OB_BEAR_PART)
        if array.size(_obBearDel) > 0
            array.sort(_obBearDel, order.descending)
            for j = 0 to array.size(_obBearDel) - 1
                int idx = array.get(_obBearDel, j)
                array.remove(obBearBox,      idx)
                array.remove(obBearScore,    idx)
                array.remove(obBearTop,      idx)
                array.remove(obBearBot,      idx)
                array.remove(obBearState,    idx)
                array.remove(obBearTime,     idx)
                array.remove(obBearBar,      idx)
                array.remove(obBearIsIB,     idx)
                array.remove(obBearSignaled, idx)
                // Sous-bloc zone-cœur : supprimé avec l'OB parent (plus valable pour le trading)
                box   _rmCoBxR = array.get(obBearCoreBox, idx)
                if not na(_rmCoBxR)
                    box.delete(_rmCoBxR)
                array.remove(obBearCoreBox,  idx)


f_obLifecycle()
// MODULE 9 — VOLUME
var string GRP_V = "⚙️ Technique avancé"
int   i_volPer  = 20
float i_volMult = 1.0
bool  i_showVol = input.bool  (false, "Fond de volume fort",   group=GRP_V)

float volMa = ta.sma(volume, i_volPer)
bool  volOk = i_moteurVolume and not na(volMa) and volume > volMa * i_volMult

bgcolor(i_showVol and volOk ? i_volColor : na, title="Volume fort")

// MODULE 8b — BREAKER BLOCKS (lifecycle)
// Suppression des Breakers quand complètement traversés
f_bbLifecycle() =>
    if array.size(bbBullTop) > 0 and barstate.isconfirmed
        array<int> _delBBBull = array.new<int>(0)
        for i = 0 to array.size(bbBullTop) - 1
            float _t = array.get(bbBullTop, i)
            float _b = array.get(bbBullBot, i)
            if close < _b  // prix passe sous le Bullish Breaker — zone consommée
                box _bx = array.get(bbBullBox, i)
                if not na(_bx)
                    box.delete(_bx)
                array.push(_delBBBull, i)
            else if barstate.islast
                box _bx = array.get(bbBullBox, i)
                if not na(_bx)
                    box.set_right(_bx, bar_index + 50)
        if array.size(_delBBBull) > 0
            array.sort(_delBBBull, order.descending)
            for j = 0 to array.size(_delBBBull) - 1
                int _idx = array.get(_delBBBull, j)
                array.remove(bbBullTop, _idx)
                array.remove(bbBullBot, _idx)
                array.remove(bbBullBox, _idx)

    if array.size(bbBearTop) > 0 and barstate.isconfirmed
        array<int> _delBBBear = array.new<int>(0)
        for i = 0 to array.size(bbBearTop) - 1
            float _t = array.get(bbBearTop, i)
            float _b = array.get(bbBearBot, i)
            if close > _t  // prix passe au-dessus du Bearish Breaker — zone consommée
                box _bx = array.get(bbBearBox, i)
                if not na(_bx)
                    box.delete(_bx)
                array.push(_delBBBear, i)
            else if barstate.islast
                box _bx = array.get(bbBearBox, i)
                if not na(_bx)
                    box.set_right(_bx, bar_index + 50)
        if array.size(_delBBBear) > 0
            array.sort(_delBBBear, order.descending)
            for j = 0 to array.size(_delBBBear) - 1
                int _idx = array.get(_delBBBear, j)
                array.remove(bbBearTop, _idx)
                array.remove(bbBearBot, _idx)
                array.remove(bbBearBox, _idx)


f_bbLifecycle()
// MODULE 8c — PROPULSION BLOCKS (OB + FVG chevauchants)
// Confluence OB+FVG = zone de réaction à forte probabilité
var string GRP_PRP    = "🏦 Order Blocks & FVG"
bool i_showPropulsion = input.bool(false, "Propulsion Blocks", group=GRP_PRP)
int  i_maxProp        = 3  // Propulsion Blocks max par sens — en dur

var array<float> propBullTop = array.new<float>(0)
var array<float> propBullBot = array.new<float>(0)
var array<box>   propBullBox = array.new<box>(0)
var array<float> propBearTop = array.new<float>(0)
var array<float> propBearBot = array.new<float>(0)
var array<box>   propBearBox = array.new<box>(0)

color C_PROP_BULL = color.new(#00C853, 93)  // vert estompé — Propulsion Bull (uniformisé)
color C_PROP_BEAR = color.new(#D50000, 93)  // rouge estompé — Propulsion Bear (uniformisé)
color C_PROP_BDR  = color.new(#FFD700, 10)

// Détection : nouveau FVG Bull → chercher overlap avec OB Bull actifs
f_fvgBullOB() =>
    if isFVGBull and array.size(obBullTop) > 0
        float _fTop = low
        float _fBot = high[2]
        for _pi = 0 to array.size(obBullTop) - 1
            float _oTop = array.get(obBullTop, _pi)
            float _oBot = array.get(obBullBot, _pi)
            float _ovBot = math.max(_fBot, _oBot)
            float _ovTop = math.min(_fTop, _oTop)
            if _ovTop > _ovBot  // chevauchement réel
                if array.size(propBullBox) >= i_maxProp
                    box _ob = array.shift(propBullBox)
                    if not na(_ob)
                        box.delete(_ob)
                    array.shift(propBullTop)
                    array.shift(propBullBot)
                array.push(propBullTop, _ovTop)
                array.push(propBullBot, _ovBot)
                box _pb = i_showPropulsion ? box.new(bar_index, _ovTop, bar_index + 50, _ovBot,
                     bgcolor=C_PROP_BULL, border_color=C_PROP_BDR, border_width=2,
                     text="⚡", text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE,
                     text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN) : na
                array.push(propBullBox, _pb)


f_fvgBullOB()

// Détection : nouveau FVG Bear → chercher overlap avec OB Bear actifs
f_fvgBearOB() =>
    if isFVGBear and array.size(obBearTop) > 0
        float _fTop = low[2]
        float _fBot = high
        for _pi = 0 to array.size(obBearTop) - 1
            float _oTop = array.get(obBearTop, _pi)
            float _oBot = array.get(obBearBot, _pi)
            float _ovBot = math.max(_fBot, _oBot)
            float _ovTop = math.min(_fTop, _oTop)
            if _ovTop > _ovBot
                if array.size(propBearBox) >= i_maxProp
                    box _ob = array.shift(propBearBox)
                    if not na(_ob)
                        box.delete(_ob)
                    array.shift(propBearTop)
                    array.shift(propBearBot)
                array.push(propBearTop, _ovTop)
                array.push(propBearBot, _ovBot)
                box _pb = i_showPropulsion ? box.new(bar_index, _ovTop, bar_index + 50, _ovBot,
                     bgcolor=C_PROP_BEAR, border_color=C_PROP_BDR, border_width=2,
                     text="⚡", text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE,
                     text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN) : na
                array.push(propBearBox, _pb)


f_fvgBearOB()

// Lifecycle Propulsion Blocks
f_propBullLifecycle() =>
    if array.size(propBullTop) > 0 and barstate.isconfirmed
        array<int> _delPB = array.new<int>(0)
        for _pi = 0 to array.size(propBullTop) - 1
            if close < array.get(propBullBot, _pi)
                box _bx = array.get(propBullBox, _pi)
                if not na(_bx)
                    box.delete(_bx)
                array.push(_delPB, _pi)
            else if barstate.islast
                box _bx = array.get(propBullBox, _pi)
                if not na(_bx)
                    box.set_right(_bx, bar_index + 50)
        if array.size(_delPB) > 0
            array.sort(_delPB, order.descending)
            for _j = 0 to array.size(_delPB) - 1
                int _idx = array.get(_delPB, _j)
                array.remove(propBullTop, _idx)
                array.remove(propBullBot, _idx)
                array.remove(propBullBox, _idx)


f_propBullLifecycle()

f_propBearLifecycle() =>
    if array.size(propBearTop) > 0 and barstate.isconfirmed
        array<int> _delPBr = array.new<int>(0)
        for _pi = 0 to array.size(propBearTop) - 1
            if close > array.get(propBearTop, _pi)
                box _bx = array.get(propBearBox, _pi)
                if not na(_bx)
                    box.delete(_bx)
                array.push(_delPBr, _pi)
            else if barstate.islast
                box _bx = array.get(propBearBox, _pi)
                if not na(_bx)
                    box.set_right(_bx, bar_index + 50)
        if array.size(_delPBr) > 0
            array.sort(_delPBr, order.descending)
            for _j = 0 to array.size(_delPBr) - 1
                int _idx = array.get(_delPBr, _j)
                array.remove(propBearTop, _idx)
                array.remove(propBearBot, _idx)
                array.remove(propBearBox, _idx)


f_propBearLifecycle()

// MODULE 10 — ATR / IMPULSION
var string GRP_A = "⚙️ Technique avancé"
float i_atrSeuil = _autoAtrSeuil  // Phase 4.2 : profil par asset
bool  i_showAtr  = input.bool (false, "Fond d'impulsions fortes", group=GRP_A)

float range1 = high - low
bool  atrOk  = i_moteurATR and not na(atr14) and range1 > i_atrSeuil * atr14
bool  atrBull = atrOk and close > open
bool  atrBear = atrOk and close < open

bgcolor(i_showAtr and atrBull ? i_atrBull : na, title="Impulsion haussière")
bgcolor(i_showAtr and atrBear ? i_atrBear : na, title="Impulsion baissière")

// MODULE 10b — NDOG / NWOG (New Day / New Week Opening Gaps)
// NDOG : gap entre clôture veille et ouverture du jour  (M1–M15)
// NWOG : gap entre clôture vendredi et ouverture lundi  (H1–H4)
var string GRP_GAP  = "🕐 Sessions & Niveaux Clés"
bool  i_showNDOG    = input.bool (false,  "New Day Opening Gap ",         group=GRP_GAP)
bool  i_showNWOG    = input.bool (false,  "New Week Opening Gap",        group=GRP_GAP)
// v11 : i_moteurGap SUPPRIMÉ (jamais testé en BT, campagne FINAL 2026-07-19).
// Le scoring NDOG/NWOG (_preInGap) a été retiré de f_score. Les gaps NDOG/NWOG
// restent détectés et affichés (i_showNDOG/NWOG) mais ne scorent plus les signaux.
float i_gapMinMult  = 0.3
int   i_maxGap      = 1  // NDOG/NWOG max par type — en dur (décision 2026-07-27 : 1 seul)
color i_ndogColor   = color.new(#26C6DA, 75)
color i_nwogColor   = color.new(#AB47BC, 75)

// Phase 3.3 : gating timeframe — NDOG pertinent en M1–M15, NWOG en H1–H4.
// Hors de ces plages, gaps ni créés/affichés ni scorés (évite le bruit multi-TF).
bool  _tfNDOG       = timeframe.in_seconds() <= 900                                      // M1–M15
bool  _tfNWOG       = timeframe.in_seconds() >= 3600 and timeframe.in_seconds() <= 14400 // H1–H4

// Arrays : top / bot / box / mitigated pour NDOG et NWOG
var array<float> ndogTop  = array.new<float>(0)
var array<float> ndogBot  = array.new<float>(0)
var array<box>   ndogBox  = array.new<box>(0)
var array<bool>  ndogMit  = array.new<bool>(0)
var array<float> nwogTop  = array.new<float>(0)
var array<float> nwogBot  = array.new<float>(0)
var array<box>   nwogBox  = array.new<box>(0)
var array<bool>  nwogMit  = array.new<bool>(0)

// Détection d'un nouveau jour de trading
bool _newDay  = not na(close[1]) and dayofmonth != dayofmonth[1]
// Détection d'une nouvelle semaine de trading (changement de weekofyear)
bool _newWeek = not na(close[1]) and weekofyear != weekofyear[1]

float _gapMin = not na(atr14) ? i_gapMinMult * atr14 : 0.0

// Création NDOG — au début d'une nouvelle journée (gating TF M1–M15, Phase 3.3)
f_block3() =>
    if _newDay and barstate.isconfirmed and _tfNDOG
        float _gTop = math.max(open, close[1])
        float _gBot = math.min(open, close[1])
        if _gTop - _gBot >= _gapMin and _gTop != _gBot
            if array.size(ndogBox) >= i_maxGap
                box _ob = array.shift(ndogBox)
                if not na(_ob)
                    box.delete(_ob)
                array.shift(ndogTop)
                array.shift(ndogBot)
                array.shift(ndogMit)
            array.push(ndogTop, _gTop)
            array.push(ndogBot, _gBot)
            array.push(ndogMit, false)
            array.push(ndogBox, i_showNDOG ?
                 box.new(bar_index - 1, _gTop, bar_index + 50, _gBot,
                      bgcolor=i_ndogColor, border_color=color.new(#26C6DA, 10),
                      border_width=1, text="New Day Opening Gap", text_color=color.new(#26C6DA, 0),
                      text_size=size.tiny, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN) : na)


f_block3()

// Création NWOG — au début d'une nouvelle semaine (gating TF H1–H4, Phase 3.3)
f_block2() =>
    if _newWeek and barstate.isconfirmed and _tfNWOG
        float _gTop = math.max(open, close[1])
        float _gBot = math.min(open, close[1])
        if _gTop - _gBot >= _gapMin and _gTop != _gBot
            if array.size(nwogBox) >= i_maxGap
                box _ob = array.shift(nwogBox)
                if not na(_ob)
                    box.delete(_ob)
                array.shift(nwogTop)
                array.shift(nwogBot)
                array.shift(nwogMit)
            array.push(nwogTop, _gTop)
            array.push(nwogBot, _gBot)
            array.push(nwogMit, false)
            array.push(nwogBox, i_showNWOG ?
                 box.new(bar_index - 1, _gTop, bar_index + 50, _gBot,
                      bgcolor=i_nwogColor, border_color=color.new(#AB47BC, 10),
                      border_width=1, text="New Week Opening Gap", text_color=color.new(#AB47BC, 0),
                      text_size=size.tiny, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN) : na)


f_block2()

// Lifecycle NDOG : mitigation + extension
if array.size(ndogTop) > 0 and barstate.isconfirmed
    for _gi = 0 to array.size(ndogTop) - 1
        if not array.get(ndogMit, _gi)
            float _gt = array.get(ndogTop, _gi)
            float _gb = array.get(ndogBot, _gi)
            // Mitigé quand le prix remplit complètement le gap
            if low <= _gb and high >= _gt
                array.set(ndogMit, _gi, true)
                box _bx = array.get(ndogBox, _gi)
                if not na(_bx)
                    box.set_bgcolor(_bx, color.new(#26C6DA, 92))
                    box.set_right(_bx, bar_index)
            else if barstate.islast
                box _bx = array.get(ndogBox, _gi)
                if not na(_bx)
                    box.set_right(_bx, bar_index + 50)

// Lifecycle NWOG : mitigation + extension
if array.size(nwogTop) > 0 and barstate.isconfirmed
    for _gi = 0 to array.size(nwogTop) - 1
        if not array.get(nwogMit, _gi)
            float _gt = array.get(nwogTop, _gi)
            float _gb = array.get(nwogBot, _gi)
            if low <= _gb and high >= _gt
                array.set(nwogMit, _gi, true)
                box _bx = array.get(nwogBox, _gi)
                if not na(_bx)
                    box.set_bgcolor(_bx, color.new(#AB47BC, 92))
                    box.set_right(_bx, bar_index)
            else if barstate.islast
                box _bx = array.get(nwogBox, _gi)
                if not na(_bx)
                    box.set_right(_bx, bar_index + 50)

// MODULE 4b — PREMIUM / DISCOUNT ZONES (Equilibrium ICT)
// Plage de référence = dernier dealing range BOS (même base que l'OTE, Phase 3.1)
// Au-dessus du 50% = Premium → vendre | En dessous du 50% = Discount → acheter
var string GRP_PD = "📈 Multi-Timeframe & OTE"
bool  i_showPD   = input.bool (false, "Fonds Premium/Discount", group=GRP_PD)
bool  i_showEqLn = input.bool (false, "Equilibrium",      group=GRP_PD)
float i_eqTol    = 0.5

// Phase 3.1 : Premium/Discount dérivé de la MÊME plage de référence que l'OTE
// (le dernier dealing range BOS, figé), au lieu des pivots courants (sh1+sl1)/2 qui
// se désynchronisent. On capture sh1/sl1 au moment du dernier BOS (haussier ou baissier).
var float _pdRangeH = na
var float _pdRangeL = na
if (bosHaussier or bosBaissier) and not na(sh1) and not na(sl1) and sh1 > sl1
    _pdRangeH := sh1
    _pdRangeL := sl1

bool  pdOk          = not na(_pdRangeH) and not na(_pdRangeL)
float pdEquilibrium = pdOk ? (_pdRangeH + _pdRangeL) / 2.0 : na
float pdTolAbs      = pdOk ? pdEquilibrium * (i_eqTol / 100.0) : na
bool  inPremium     = pdOk and close > pdEquilibrium + pdTolAbs
bool  inDiscount    = pdOk and close < pdEquilibrium - pdTolAbs

// Ligne équilibre — créée une fois, mise à jour chaque barre
// Correctif : ne dépend que de son propre toggle (i_showEqLn), plus de i_showPD (fond)
var line pdEqLine = na
if i_showEqLn and pdOk
    if na(pdEqLine)
        pdEqLine := line.new(bar_index, pdEquilibrium, bar_index + 1, pdEquilibrium,
             color=color.new(#FFD700, 20), width=1, style=line.style_dashed,
             extend=extend.right)
    else
        line.set_y1(pdEqLine, pdEquilibrium)
        line.set_y2(pdEqLine, pdEquilibrium)

// Fonds visuels Premium (rouge léger) / Discount (vert léger)
bgcolor(i_showPD and inPremium  ? color.new(#F44336, 95) : na, title="Zone Premium")
bgcolor(i_showPD and inDiscount ? color.new(#4CAF50, 95) : na, title="Zone Discount")

// MODULE 12 — MULTI-TIMEFRAME (MTF)
var string GRP_H  = "📈 Multi-Timeframe & OTE"
int   i_htfSwing  = 3
bool  i_showH1    = input.bool(false,  "Order Blocks H1",      group=GRP_H)
bool  i_showH4    = input.bool(false,  "Order Blocks H4",       group=GRP_H)
bool  i_showW1    = input.bool(false, "Order Blocks W1 (perf)", group=GRP_H)
bool  i_showMN    = input.bool(false, "Order Blocks MN (perf)", group=GRP_H)
color C_H1_BULL = color.new(#00BCD4, 70)
color C_H1_BEAR = color.new(#FF6F00, 70)
color C_H4_BULL = color.new(#1565C0, 60)
color C_H4_BEAR = color.new(#B71C1C, 60)
color C_W1_BULL = color.new(#006064, 50)  // teal profond W1
color C_W1_BEAR = color.new(#4A148C, 50)  // violet profond W1
color C_MN_BULL = color.new(#F57F17, 45)  // or MN
color C_MN_BEAR = color.new(#880E4F, 45)  // bordeaux MN

f_htf(int swLen) =>
    // ⚠️ REPAINT MTF (Phase 3.4) — comportement documenté :
    // Cette fonction évalue les BOS/OB sur un TF supérieur via request.security(..., lookahead_off).
    // Tant que la bougie HTF en cours n'est PAS clôturée, _sh/_sl, le trend et les OB HTF
    // peuvent CHANGER en temps réel (repaint) : une confluence H1/H4/W1/MN affichée maintenant
    // peut disparaître à la clôture de la bougie HTF, et inversement.
    // Choix assumé : on garde l'évaluation LIVE (confluence réactive utile au scalping intrabar).
    // Pour un comportement strictement NON-repaint, il faudrait borner les signaux à la clôture
    // HTF (ex. décaler d'une bougie HTF), au prix d'un retard de confluence.
    float _ph = ta.pivothigh(high, swLen, swLen)
    float _pl = ta.pivotlow (low,  swLen, swLen)
    var float _sh  = na
    var int   _bsh = na
    var float _sl  = na
    var int   _bsl = na
    if not na(_ph)
        _sh  := _ph
        _bsh := bar_index[swLen]
    if not na(_pl)
        _sl  := _pl
        _bsl := bar_index[swLen]
    var int _lastSH_sig = na
    var int _lastSL_sig = na
    bool _bosUp   = not na(_sh) and close > _sh and close[1] <= _sh and (na(_lastSH_sig) or _bsh != _lastSH_sig)
    bool _bosDown = not na(_sl) and close < _sl and close[1] >= _sl and (na(_lastSL_sig) or _bsl != _lastSL_sig)
    if _bosUp
        _lastSH_sig := _bsh
    if _bosDown
        _lastSL_sig := _bsl
    var float _lBT = na
    var float _lBB = na
    var float _lBuT = na
    var float _lBuB = na
    var int   _lBtime  = na
    var int   _lButime = na
    float _prevLBT  = _lBT
    float _prevLBB  = _lBB
    float _prevLBuT = _lBuT
    float _prevLBuB = _lBuB
    int   _prevLBtime  = _lBtime
    int   _prevLButime = _lButime
    if close < open
        _lBT  := open
        _lBB  := low
        _lBtime := time
        _lBuT := na
        _lBuB := na
        _lButime := na
    if close > open
        _lBuT := high
        _lBuB := open
        _lButime := time
        _lBT  := na
        _lBB  := na
        _lBtime := na
    // Historique des 3 derniers OB bull/bear non-mitigés
    var float _b1T = na
    var float _b1B = na
    var float _b2T = na
    var float _b2B = na
    var float _b3T = na
    var float _b3B = na
    var float _r1T = na
    var float _r1B = na
    var float _r2T = na
    var float _r2B = na
    var float _r3T = na
    var float _r3B = na
    var int _b1time = na
    var int _b2time = na
    var int _b3time = na
    var int _r1time = na
    var int _r2time = na
    var int _r3time = na
    if _bosUp and not na(_prevLBT)
        _b3T := _b2T
        _b3B := _b2B
        _b2T := _b1T
        _b2B := _b1B
        _b1T := _prevLBT
        _b1B := _prevLBB
        _b3time := _b2time
        _b2time := _b1time
        _b1time := _prevLBtime
        _lBT := na
        _lBB := na
    if _bosDown and not na(_prevLBuT)
        _r3T := _r2T
        _r3B := _r2B
        _r2T := _r1T
        _r2B := _r1B
        _r1T := _prevLBuT
        _r1B := _prevLBuB
        _r3time := _r2time
        _r2time := _r1time
        _r1time := _prevLButime
        _lBuT := na
        _lBuB := na
    // Mitigation : invalider l'OB si le prix le traverse
    if not na(_b1T) and close < _b1B
        _b1T := na
        _b1B := na
    if not na(_b2T) and close < _b2B
        _b2T := na
        _b2B := na
    if not na(_b3T) and close < _b3B
        _b3T := na
        _b3B := na
    if not na(_r1T) and close > _r1T
        _r1T := na
        _r1B := na
    if not na(_r2T) and close > _r2T
        _r2T := na
        _r2B := na
    if not na(_r3T) and close > _r3T
        _r3T := na
        _r3B := na
    var int _trend = 0
    if _bosUp
        _trend := 1
    if _bosDown
        _trend := -1
    [_trend, _b1T, _b1B, _b2T, _b2B, _b3T, _b3B, _r1T, _r1B, _r2T, _r2B, _r3T, _r3B,
     _b1time, _b2time, _b3time, _r1time, _r2time, _r3time]

[h1Trend, h1BullTop, h1BullBot, h1Bull2Top, h1Bull2Bot, h1Bull3Top, h1Bull3Bot,
          h1BearTop, h1BearBot, h1Bear2Top, h1Bear2Bot, h1Bear3Top, h1Bear3Bot,
          h1Bull1Time, h1Bull2Time, h1Bull3Time, h1Bear1Time, h1Bear2Time, h1Bear3Time] =
     request.security(syminfo.tickerid, "60",  f_htf(i_htfSwing), lookahead=barmerge.lookahead_off)
[h4Trend, h4BullTop, h4BullBot, h4Bull2Top, h4Bull2Bot, h4Bull3Top, h4Bull3Bot,
          h4BearTop, h4BearBot, h4Bear2Top, h4Bear2Bot, h4Bear3Top, h4Bear3Bot,
          h4Bull1Time, h4Bull2Time, h4Bull3Time, h4Bear1Time, h4Bear2Time, h4Bear3Time] =
     request.security(syminfo.tickerid, "240", f_htf(i_htfSwing), lookahead=barmerge.lookahead_off)
[w1Trend, w1BullTop, w1BullBot, w1Bull2Top, w1Bull2Bot, w1Bull3Top, w1Bull3Bot,
          w1BearTop, w1BearBot, w1Bear2Top, w1Bear2Bot, w1Bear3Top, w1Bear3Bot,
          w1Bull1Time, w1Bull2Time, w1Bull3Time, w1Bear1Time, w1Bear2Time, w1Bear3Time] =
     request.security(syminfo.tickerid, "W",   f_htf(i_htfSwing), lookahead=barmerge.lookahead_off)
[mnTrend, mnBullTop, mnBullBot, mnBull2Top, mnBull2Bot, mnBull3Top, mnBull3Bot,
          mnBearTop, mnBearBot, mnBear2Top, mnBear2Bot, mnBear3Top, mnBear3Bot,
          mnBull1Time, mnBull2Time, mnBull3Time, mnBear1Time, mnBear2Time, mnBear3Time] =
     request.security(syminfo.tickerid, "M",   f_htf(i_htfSwing), lookahead=barmerge.lookahead_off)

bool confluenceH1 = i_moteurMTF and
     ((not na(h1BullTop) and close >= h1BullBot and close <= h1BullTop) or
      (not na(h1Bull2Top) and close >= h1Bull2Bot and close <= h1Bull2Top) or
      (not na(h1Bull3Top) and close >= h1Bull3Bot and close <= h1Bull3Top) or
      (not na(h1BearTop) and close >= h1BearBot and close <= h1BearTop) or
      (not na(h1Bear2Top) and close >= h1Bear2Bot and close <= h1Bear2Top) or
      (not na(h1Bear3Top) and close >= h1Bear3Bot and close <= h1Bear3Top))
bool confluenceH4 = i_moteurMTF and
     ((not na(h4BullTop) and close >= h4BullBot and close <= h4BullTop) or
      (not na(h4Bull2Top) and close >= h4Bull2Bot and close <= h4Bull2Top) or
      (not na(h4Bull3Top) and close >= h4Bull3Bot and close <= h4Bull3Top) or
      (not na(h4BearTop) and close >= h4BearBot and close <= h4BearTop) or
      (not na(h4Bear2Top) and close >= h4Bear2Bot and close <= h4Bear2Top) or
      (not na(h4Bear3Top) and close >= h4Bear3Bot and close <= h4Bear3Top))
bool confluenceW1 = i_moteurMTF and
     ((not na(w1BullTop) and close >= w1BullBot and close <= w1BullTop) or
      (not na(w1Bull2Top) and close >= w1Bull2Bot and close <= w1Bull2Top) or
      (not na(w1Bull3Top) and close >= w1Bull3Bot and close <= w1Bull3Top) or
      (not na(w1BearTop) and close >= w1BearBot and close <= w1BearTop) or
      (not na(w1Bear2Top) and close >= w1Bear2Bot and close <= w1Bear2Top) or
      (not na(w1Bear3Top) and close >= w1Bear3Bot and close <= w1Bear3Top))
bool confluenceMN = i_moteurMTF and
     ((not na(mnBullTop) and close >= mnBullBot and close <= mnBullTop) or
      (not na(mnBull2Top) and close >= mnBull2Bot and close <= mnBull2Top) or
      (not na(mnBull3Top) and close >= mnBull3Bot and close <= mnBull3Top) or
      (not na(mnBearTop) and close >= mnBearBot and close <= mnBearTop) or
      (not na(mnBear2Top) and close >= mnBear2Bot and close <= mnBear2Top) or
      (not na(mnBear3Top) and close >= mnBear3Bot and close <= mnBear3Top))


// Marqueur " ◀ ici" si le prix courant est DANS la zone OB HTF considérée.
f_htfTag(float _top, float _bot) =>
    not na(_top) and close >= _bot and close <= _top ? " ◀ ici" : ""


// ── OB HTF : 3 boîtes par sens et par TF ─────────────────────────
// Chaque var box/label est recréé à barstate.islast (delete + new)
var box   boxH1Bull  = na
var box   boxH1Bull2 = na
var box   boxH1Bull3 = na
var box   boxH1Bear  = na
var box   boxH1Bear2 = na
var box   boxH1Bear3 = na
var box   boxH4Bull  = na
var box   boxH4Bull2 = na
var box   boxH4Bull3 = na
var box   boxH4Bear  = na
var box   boxH4Bear2 = na
var box   boxH4Bear3 = na
var box   boxW1Bull  = na
var box   boxW1Bull2 = na
var box   boxW1Bull3 = na
var box   boxW1Bear  = na
var box   boxW1Bear2 = na
var box   boxW1Bear3 = na
var box   boxMNBull  = na
var box   boxMNBull2 = na
var box   boxMNBull3 = na
var box   boxMNBear  = na
var box   boxMNBear2 = na
var box   boxMNBear3 = na

if barstate.islast and i_moteurMTF
    // ── H1 ──
    if not na(boxH1Bull)
        box.delete(boxH1Bull)
    if not na(boxH1Bull2)
        box.delete(boxH1Bull2)
    if not na(boxH1Bull3)
        box.delete(boxH1Bull3)
    if not na(boxH1Bear)
        box.delete(boxH1Bear)
    if not na(boxH1Bear2)
        box.delete(boxH1Bear2)
    if not na(boxH1Bear3)
        box.delete(boxH1Bear3)
    if i_showH1
        if not na(h1BullTop) and not na(h1BullBot) and h1BullTop > h1BullBot
            boxH1Bull  := box.new(h1Bull1Time, h1BullTop,  time, h1BullBot,  xloc=xloc.bar_time, bgcolor=C_H1_BULL,                  border_color=color.new(color.white,60), border_width=1, text="🟢 H1" + f_htfTag(h1BullTop, h1BullBot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(h1Bull2Top) and not na(h1Bull2Bot) and h1Bull2Top > h1Bull2Bot
            boxH1Bull2 := box.new(h1Bull2Time, h1Bull2Top, time, h1Bull2Bot, xloc=xloc.bar_time, bgcolor=color.new(#00BCD4,82), border_color=color.new(color.white,70), border_width=1, text="🟢 H1" + f_htfTag(h1Bull2Top, h1Bull2Bot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(h1Bull3Top) and not na(h1Bull3Bot) and h1Bull3Top > h1Bull3Bot
            boxH1Bull3 := box.new(h1Bull3Time, h1Bull3Top, time, h1Bull3Bot, xloc=xloc.bar_time, bgcolor=color.new(#00BCD4,88), border_color=color.new(color.white,75), border_width=1, text="🟢 H1" + f_htfTag(h1Bull3Top, h1Bull3Bot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(h1BearTop) and not na(h1BearBot) and h1BearTop > h1BearBot
            boxH1Bear  := box.new(h1Bear1Time, h1BearTop,  time, h1BearBot,  xloc=xloc.bar_time, bgcolor=C_H1_BEAR,                  border_color=color.new(color.white,60), border_width=1, text="🔴 H1" + f_htfTag(h1BearTop, h1BearBot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(h1Bear2Top) and not na(h1Bear2Bot) and h1Bear2Top > h1Bear2Bot
            boxH1Bear2 := box.new(h1Bear2Time, h1Bear2Top, time, h1Bear2Bot, xloc=xloc.bar_time, bgcolor=color.new(#FF6F00,82), border_color=color.new(color.white,70), border_width=1, text="🔴 H1" + f_htfTag(h1Bear2Top, h1Bear2Bot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(h1Bear3Top) and not na(h1Bear3Bot) and h1Bear3Top > h1Bear3Bot
            boxH1Bear3 := box.new(h1Bear3Time, h1Bear3Top, time, h1Bear3Bot, xloc=xloc.bar_time, bgcolor=color.new(#FF6F00,88), border_color=color.new(color.white,75), border_width=1, text="🔴 H1" + f_htfTag(h1Bear3Top, h1Bear3Bot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
    // ── H4 ──
    if not na(boxH4Bull)
        box.delete(boxH4Bull)
    if not na(boxH4Bull2)
        box.delete(boxH4Bull2)
    if not na(boxH4Bull3)
        box.delete(boxH4Bull3)
    if not na(boxH4Bear)
        box.delete(boxH4Bear)
    if not na(boxH4Bear2)
        box.delete(boxH4Bear2)
    if not na(boxH4Bear3)
        box.delete(boxH4Bear3)
    if i_showH4
        if not na(h4BullTop) and not na(h4BullBot) and h4BullTop > h4BullBot
            boxH4Bull  := box.new(h4Bull1Time, h4BullTop,  time, h4BullBot,  xloc=xloc.bar_time, bgcolor=C_H4_BULL,                  border_color=color.new(color.white,60), border_width=2, text="🟢 H4" + f_htfTag(h4BullTop, h4BullBot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(h4Bull2Top) and not na(h4Bull2Bot) and h4Bull2Top > h4Bull2Bot
            boxH4Bull2 := box.new(h4Bull2Time, h4Bull2Top, time, h4Bull2Bot, xloc=xloc.bar_time, bgcolor=color.new(#1565C0,82), border_color=color.new(color.white,70), border_width=2, text="🟢 H4" + f_htfTag(h4Bull2Top, h4Bull2Bot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(h4Bull3Top) and not na(h4Bull3Bot) and h4Bull3Top > h4Bull3Bot
            boxH4Bull3 := box.new(h4Bull3Time, h4Bull3Top, time, h4Bull3Bot, xloc=xloc.bar_time, bgcolor=color.new(#1565C0,88), border_color=color.new(color.white,75), border_width=2, text="🟢 H4" + f_htfTag(h4Bull3Top, h4Bull3Bot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(h4BearTop) and not na(h4BearBot) and h4BearTop > h4BearBot
            boxH4Bear  := box.new(h4Bear1Time, h4BearTop,  time, h4BearBot,  xloc=xloc.bar_time, bgcolor=C_H4_BEAR,                  border_color=color.new(color.white,60), border_width=2, text="🔴 H4" + f_htfTag(h4BearTop, h4BearBot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(h4Bear2Top) and not na(h4Bear2Bot) and h4Bear2Top > h4Bear2Bot
            boxH4Bear2 := box.new(h4Bear2Time, h4Bear2Top, time, h4Bear2Bot, xloc=xloc.bar_time, bgcolor=color.new(#B71C1C,82), border_color=color.new(color.white,70), border_width=2, text="🔴 H4" + f_htfTag(h4Bear2Top, h4Bear2Bot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(h4Bear3Top) and not na(h4Bear3Bot) and h4Bear3Top > h4Bear3Bot
            boxH4Bear3 := box.new(h4Bear3Time, h4Bear3Top, time, h4Bear3Bot, xloc=xloc.bar_time, bgcolor=color.new(#B71C1C,88), border_color=color.new(color.white,75), border_width=2, text="🔴 H4" + f_htfTag(h4Bear3Top, h4Bear3Bot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
    // ── W1 ──
    if not na(boxW1Bull)
        box.delete(boxW1Bull)
    if not na(boxW1Bull2)
        box.delete(boxW1Bull2)
    if not na(boxW1Bull3)
        box.delete(boxW1Bull3)
    if not na(boxW1Bear)
        box.delete(boxW1Bear)
    if not na(boxW1Bear2)
        box.delete(boxW1Bear2)
    if not na(boxW1Bear3)
        box.delete(boxW1Bear3)
    if i_showW1
        if not na(w1BullTop) and not na(w1BullBot) and w1BullTop > w1BullBot
            boxW1Bull  := box.new(w1Bull1Time, w1BullTop,  time, w1BullBot,  xloc=xloc.bar_time, bgcolor=C_W1_BULL,                  border_color=color.new(color.white,60), border_width=2, text="🟢 W1" + f_htfTag(w1BullTop, w1BullBot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(w1Bull2Top) and not na(w1Bull2Bot) and w1Bull2Top > w1Bull2Bot
            boxW1Bull2 := box.new(w1Bull2Time, w1Bull2Top, time, w1Bull2Bot, xloc=xloc.bar_time, bgcolor=color.new(#006064,85), border_color=color.new(color.white,70), border_width=2, text="🟢 W1" + f_htfTag(w1Bull2Top, w1Bull2Bot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(w1Bull3Top) and not na(w1Bull3Bot) and w1Bull3Top > w1Bull3Bot
            boxW1Bull3 := box.new(w1Bull3Time, w1Bull3Top, time, w1Bull3Bot, xloc=xloc.bar_time, bgcolor=color.new(#006064,90), border_color=color.new(color.white,75), border_width=2, text="🟢 W1" + f_htfTag(w1Bull3Top, w1Bull3Bot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(w1BearTop) and not na(w1BearBot) and w1BearTop > w1BearBot
            boxW1Bear  := box.new(w1Bear1Time, w1BearTop,  time, w1BearBot,  xloc=xloc.bar_time, bgcolor=C_W1_BEAR,                  border_color=color.new(color.white,60), border_width=2, text="🔴 W1" + f_htfTag(w1BearTop, w1BearBot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(w1Bear2Top) and not na(w1Bear2Bot) and w1Bear2Top > w1Bear2Bot
            boxW1Bear2 := box.new(w1Bear2Time, w1Bear2Top, time, w1Bear2Bot, xloc=xloc.bar_time, bgcolor=color.new(#4A148C,85), border_color=color.new(color.white,70), border_width=2, text="🔴 W1" + f_htfTag(w1Bear2Top, w1Bear2Bot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(w1Bear3Top) and not na(w1Bear3Bot) and w1Bear3Top > w1Bear3Bot
            boxW1Bear3 := box.new(w1Bear3Time, w1Bear3Top, time, w1Bear3Bot, xloc=xloc.bar_time, bgcolor=color.new(#4A148C,90), border_color=color.new(color.white,75), border_width=2, text="🔴 W1" + f_htfTag(w1Bear3Top, w1Bear3Bot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
    // ── MN ──
    if not na(boxMNBull)
        box.delete(boxMNBull)
    if not na(boxMNBull2)
        box.delete(boxMNBull2)
    if not na(boxMNBull3)
        box.delete(boxMNBull3)
    if not na(boxMNBear)
        box.delete(boxMNBear)
    if not na(boxMNBear2)
        box.delete(boxMNBear2)
    if not na(boxMNBear3)
        box.delete(boxMNBear3)
    if i_showMN
        if not na(mnBullTop) and not na(mnBullBot) and mnBullTop > mnBullBot
            boxMNBull  := box.new(mnBull1Time, mnBullTop,  time, mnBullBot,  xloc=xloc.bar_time, bgcolor=C_MN_BULL,                  border_color=color.new(color.white,60), border_width=3, text="⭐ MN" + f_htfTag(mnBullTop, mnBullBot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(mnBull2Top) and not na(mnBull2Bot) and mnBull2Top > mnBull2Bot
            boxMNBull2 := box.new(mnBull2Time, mnBull2Top, time, mnBull2Bot, xloc=xloc.bar_time, bgcolor=color.new(#F57F17,85), border_color=color.new(color.white,70), border_width=3, text="⭐ MN" + f_htfTag(mnBull2Top, mnBull2Bot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(mnBull3Top) and not na(mnBull3Bot) and mnBull3Top > mnBull3Bot
            boxMNBull3 := box.new(mnBull3Time, mnBull3Top, time, mnBull3Bot, xloc=xloc.bar_time, bgcolor=color.new(#F57F17,90), border_color=color.new(color.white,75), border_width=3, text="⭐ MN" + f_htfTag(mnBull3Top, mnBull3Bot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(mnBearTop) and not na(mnBearBot) and mnBearTop > mnBearBot
            boxMNBear  := box.new(mnBear1Time, mnBearTop,  time, mnBearBot,  xloc=xloc.bar_time, bgcolor=C_MN_BEAR,                  border_color=color.new(color.white,60), border_width=3, text="🔴 MN" + f_htfTag(mnBearTop, mnBearBot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(mnBear2Top) and not na(mnBear2Bot) and mnBear2Top > mnBear2Bot
            boxMNBear2 := box.new(mnBear2Time, mnBear2Top, time, mnBear2Bot, xloc=xloc.bar_time, bgcolor=color.new(#880E4F,85), border_color=color.new(color.white,70), border_width=3, text="🔴 MN" + f_htfTag(mnBear2Top, mnBear2Bot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
        if not na(mnBear3Top) and not na(mnBear3Bot) and mnBear3Top > mnBear3Bot
            boxMNBear3 := box.new(mnBear3Time, mnBear3Top, time, mnBear3Bot, xloc=xloc.bar_time, bgcolor=color.new(#880E4F,90), border_color=color.new(color.white,75), border_width=3, text="🔴 MN" + f_htfTag(mnBear3Top, mnBear3Bot), text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)




// MODULE 13c — FIBONACCI OTE (Optimal Trade Entry)
var string GRP_FIB  = "📈 Multi-Timeframe & OTE"
bool  i_showFIB     = input.bool (false,                    "Zones Optimal Trade Entry",   group=GRP_FIB)

var float _fibSHL = na
var float _fibSHH = na
var float _fibSBH = na
var float _fibSBL = na
var int   _fibBullBar = na   // Phase 5.2 : barre du BOS ayant figé la plage OTE bull
var int   _fibBearBar = na   // Phase 5.2 : idem bear

// Phase 5.2 : la plage OTE expire N barres après le BOS (sinon elle persistait
// jusqu'au BOS suivant → inOTE présent dans la quasi-totalité des trades).
// Étape 3 : fenêtre en DURÉE RÉELLE (réf M15 validée = 12 barres × 900 s = 10800 s),
// traduite en barres selon le TF courant (_tfSec déclaré près du module Sweep).
// M15 : round(10800/900)=12 (non-régression exacte) · M5 : 36 · M30 : 6 · plancher 1.
int OTE_EXPIRY_BARS = na(_tfSec) or _tfSec <= 0 ? 12 : math.max(1, int(math.round(10800.0 / _tfSec)))

if bosHaussier and not na(sl1) and not na(sh1)
    _fibSHL := sl1
    _fibSHH := sh1
    _fibBullBar := bar_index
if bosBaissier and not na(sh1) and not na(sl1)
    _fibSBH := sh1
    _fibSBL := sl1
    _fibBearBar := bar_index

// Expiration temporelle de la plage OTE
if not na(_fibBullBar) and (bar_index - _fibBullBar) > OTE_EXPIRY_BARS
    _fibSHL := na
    _fibSHH := na
if not na(_fibBearBar) and (bar_index - _fibBearBar) > OTE_EXPIRY_BARS
    _fibSBH := na
    _fibSBL := na

float _oteTopBull = na
float _oteBotBull = na
float _oteTopBear = na
float _oteBotBear = na

// Constantes Fibonacci OTE
float FIB_OTE_HIGH = 0.618
float FIB_OTE_LOW  = 0.786

if not na(_fibSHL) and not na(_fibSHH) and _fibSHH > _fibSHL
    float rng    = _fibSHH - _fibSHL
    _oteTopBull := _fibSHH - rng * FIB_OTE_HIGH
    _oteBotBull := _fibSHH - rng * FIB_OTE_LOW

if not na(_fibSBH) and not na(_fibSBL) and _fibSBH > _fibSBL
    float rng    = _fibSBH - _fibSBL
    _oteBotBear := _fibSBL + rng * FIB_OTE_HIGH
    _oteTopBear := _fibSBL + rng * FIB_OTE_LOW

bool inOTE_bull = not na(_oteTopBull) and close <= _oteTopBull and close >= _oteBotBull
bool inOTE_bear = not na(_oteTopBear) and close >= _oteBotBear and close <= _oteTopBear

var box   _oteBullBox = na
var box   _oteBearBox = na

if bosHaussier and not na(_oteTopBull) and _oteTopBull > _oteBotBull
    if not na(_oteBullBox)
        box.delete(_oteBullBox)
    _oteBullBox := na
    if i_showFIB
        _oteBullBox := box.new(bar_index, _oteTopBull, bar_index + 50, _oteBotBull,
             bgcolor=i_colFIBBull, border_color=color.new(#00C853, 40), border_width=1,
             text="OTE", text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE,
             text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)

if bosBaissier and not na(_oteTopBear) and _oteTopBear > _oteBotBear
    if not na(_oteBearBox)
        box.delete(_oteBearBox)
    _oteBearBox := na
    if i_showFIB
        _oteBearBox := box.new(bar_index, _oteTopBear, bar_index + 50, _oteBotBear,
             bgcolor=i_colFIBBear, border_color=color.new(#D50000, 40), border_width=1,
             text="OTE", text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE,
             text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)

if not na(_oteBullBox)
    if close < _oteBotBull
        box.delete(_oteBullBox)
        _oteBullBox := na

if not na(_oteBearBox)
    if close > _oteTopBear
        box.delete(_oteBearBox)
        _oteBearBox := na

// ZONE-CŒUR (Étape 1) — test de validité géométrique pour l'OB d'index _i.
// Retourne [valide, haut, bas] : intersection OB ∩ OTE ∩ 1er FVG chevauchant,
// valide seulement si chevauchement RÉEL + discount (bull) + sweep haut frais.
// Fonction factorisée : sert au tracé (1a) ET au flag par trade pour la mesure (1b).
f_coeurBull(int _i) =>
    float _cT    = na
    float _cB    = na
    bool  _valid = false
    if not na(_oteTopBull) and _sweepBullFrais and not array.get(obBullSignaled, _i)
        _cT := math.min(array.get(obBullTop, _i), _oteTopBull)
        _cB := math.max(array.get(obBullBot, _i), _oteBotBull)
        bool _hasFVG = false
        if array.size(fvgBullTop) > 0
            for _fi = 0 to array.size(fvgBullTop) - 1
                if not _hasFVG
                    float _ft = array.get(fvgBullTop, _fi)
                    float _fb = array.get(fvgBullBot, _fi)
                    if _ft > _cB and _fb < _cT
                        _cT := math.min(_cT, _ft)
                        _cB := math.max(_cB, _fb)
                        _hasFVG := true
        _valid := _hasFVG and _cT > _cB and not na(pdEquilibrium) and _cT < pdEquilibrium
    [_valid, _cT, _cB]

f_coeurBear(int _i) =>
    float _cT    = na
    float _cB    = na
    bool  _valid = false
    if not na(_oteTopBear) and _sweepBearFrais and not array.get(obBearSignaled, _i)
        _cT := math.min(array.get(obBearTop, _i), _oteTopBear)
        _cB := math.max(array.get(obBearBot, _i), _oteBotBear)
        bool _hasFVG = false
        if array.size(fvgBearTop) > 0
            for _fi = 0 to array.size(fvgBearTop) - 1
                if not _hasFVG
                    float _ft = array.get(fvgBearTop, _fi)
                    float _fb = array.get(fvgBearBot, _fi)
                    if _ft > _cB and _fb < _cT
                        _cT := math.min(_cT, _ft)
                        _cB := math.max(_cB, _fb)
                        _hasFVG := true
        _valid := _hasFVG and _cT > _cB and not na(pdEquilibrium) and _cB > pdEquilibrium
    [_valid, _cT, _cB]

// MODULE 11 — SCORING INSTITUTIONNEL
var string GRP_SC  = "🎯 Signaux & Zones"
// v11 : i_forceMin codé en dur à 4 (campagne forceMin 2026-07-19 : F4 domine F5 et F6
// en PF moyen 1.47 vs 1.34/1.30, F6 génère 0 signal sur 4/9 combos). Pour rendre ce
// seuil réglable à nouveau (expérimentation future, forceMin par actif, etc.), remplacer
// la ligne suivante par : int i_forceMin = input.int(4, "Force minimale du signal (1-10)", minval=1, maxval=10, group=GRP_SC, tooltip="Seuls les signaux dont la force /10 est ≥ à cette valeur sont générés et affichés.")
int   i_forceMin   = 4   // Force minimale du signal (/10) — codée en dur v11.
float i_atrScore   = _autoAtrScore  // Seuil ATR scoring — calibré automatiquement par asset (3.0 par défaut)


// ── Pondérations scoring adaptatif par asset (P1.1 + P1.5) ──────────────────
// Chaque asset a ses propres caractéristiques institutionnelles
int _wFVG   = _isXAU or _isXAG ? 5 : _isBTC ? 3 : 4     // FVG : très fiable sur métaux (+5), peu sur BTC
int _wSweep = _isBTC ? 1 : _isXAG ? 2 : 4                // P8 : Sweep neutre (WR=global) sur XAG/BTC → réduit ; pépite sur XAU/DAX (WR 76-78)
int _wATR   = 2                                           // ATR impulsion : caractéristique bougie, pas confluence
int _wOTE   = _isXAG or _isBTC ? 2 : 5                    // P8 : OTE neutre (WR=global) sur XAG/BTC → réduit ; précision instit sur XAU/DAX (WR 75-83)
int _wKZ    = _isXAU or _isNAS or _isDAX ? 3 : _isBTC ? 2 : 3  // Kill Zone : P7 — présent 63%, WR neutre → 4→3

float _prevLiqProx = i_prevLiqAtrProx * atr14
bool nearPDH = not na(pdhActive) and math.abs(close - pdhActive) <= _prevLiqProx
bool nearPDL = not na(pdlActive) and math.abs(close - pdlActive) <= _prevLiqProx
bool nearPWH = not na(pwhActive) and math.abs(close - pwhActive) <= _prevLiqProx
bool nearPWL = not na(pwlActive) and math.abs(close - pwlActive) <= _prevLiqProx
bool nearBullPrevLiq = nearPDL or nearPWL
bool nearBearPrevLiq = nearPDH or nearPWH
bool sweepBullPrevLiq = (not na(pdlActive) and low < pdlActive and close > pdlActive) or (not na(pwlActive) and low < pwlActive and close > pwlActive)
bool sweepBearPrevLiq = (not na(pdhActive) and high > pdhActive and close < pdhActive) or (not na(pwhActive) and high > pwhActive and close < pwhActive)

f_score(bool isBull) =>
    int sc = 0
    // BOS directionnel : P1.1 + P5.2 — poids dynamique selon force du déplacement
    // Corps fort (≥ 1.5× ATR) = impulsion institutionnelle / micro-cassure (< 0.5× ATR) = peu fiable
    // P11.2 — un MSS implique TOUJOURS un BOS : on ne compte le BOS que si aucun MSS directionnel (anti double comptage).
    bool _bosDir = (isBull and bosHaussier) or (not isBull and bosBaissier)
    bool _mssDir = (isBull and mssHaussier) or (not isBull and mssBaissier)
    if _bosDir and not _mssDir
        float _bodyBOS = math.abs(close - open)
        int   _wBOSdyn = not na(atr14) and atr14 > 0 ?
             (_bodyBOS >= 1.5 * atr14 ? (_isBTC ? 5 : 6) :
              _bodyBOS >= 0.5 * atr14 ? (_isBTC ? 3 : 4) :
                                        (_isBTC ? 1 : 2)) : (_isBTC ? 3 : 4)
        sc += _wBOSdyn
    if (isBull and isFVGBull) or (not isBull and isFVGBear)
        sc += _wFVG
    if (isBull and _sweepBullFrais) or (not isBull and _sweepBearFrais)
        sc += _wSweep
    // MSS directionnel : P7 — rare (présent 6%), WR 80-82% → 2→3
    if (isBull and mssHaussier) or (not isBull and mssBaissier)
        sc += 3
    // CHOCH confirmé : P7 — rare (présent 6%), WR 80-82% → 3→4
    if (isBull and chochHaussier) or (not isBull and chochBaissier)
        sc += 4
    // ATR impulsion : P1.5 — caractéristique bougie, pas une confluence institutionnelle → poids réduit
    if range1 > i_atrScore * atr14
        sc += _wATR
    if confluenceH4 and ((isBull and not na(h4BullTop)) or (not isBull and not na(h4BearTop)))
        sc += 4
    if confluenceH1 and ((isBull and not na(h1BullTop)) or (not isBull and not na(h1BearTop)))
        sc += 1  // HTF H1 : P7 — présent 80%, WR ≤ global → 2→1
    // W1 confluence : +5 pts
    if confluenceW1 and ((isBull and not na(w1BullTop)) or (not isBull and not na(w1BearTop)))
        sc += 5
    // MN confluence : +6 pts
    if confluenceMN and ((isBull and not na(mnBullTop)) or (not isBull and not na(mnBearTop)))
        sc += 6
    if (isBull and ibBull) or (not isBull and ibBear)
        sc += 3
    // OTE 61.8–78.6% : P1.5 — entrée de précision institutionnelle → poids augmenté
    if (isBull and inOTE_bull) or (not isBull and inOTE_bear)
        sc += _wOTE
    // Kill Zone : P1.1 — poids selon asset (critique sur or/forex/indices)
    if inKZ
        sc += _wKZ
    if i_prevLiqScore and ((isBull and nearBullPrevLiq) or (not isBull and nearBearPrevLiq))
        sc += i_prevLiqPtsProx
    if i_prevLiqScore and ((isBull and sweepBullPrevLiq) or (not isBull and sweepBearPrevLiq))
        sc += i_prevLiqPtsSweep
    // Premium/Discount : P7 — présent 78%, WR < global → 2→1
    if (isBull and inDiscount) or (not isBull and inPremium)
        sc += 1
    // v11 : Breaker/Propulsion/OB+FVG/NDOG/EQH — tous purgés du scoring (P4.2, Phase 5.6, campagne FINAL).
    // Niveaux toujours affichés sur le graphique.
    // ── Garde anti-bruit P1.2 : BOS sans confirmation institutionnelle → score plafonné à 8 ──────
    // Un BOS seul (sans sweep, FVG, OTE ni confluence HTF ≥ H4) n'est pas un setup SMC valide
    bool _hsBOS   = (isBull and bosHaussier) or (not isBull and bosBaissier)
    bool _hsSweep = (isBull and _sweepBullFrais) or (not isBull and _sweepBearFrais)
    bool _hsFVG   = (isBull and isFVGBull) or (not isBull and isFVGBear)
    bool _hsOTE   = (isBull and inOTE_bull) or (not isBull and inOTE_bear)
    bool _hsHTF   = confluenceH4 or confluenceW1 or confluenceMN
    if _hsBOS and not (_hsSweep or _hsFVG or _hsOTE or _hsHTF)
        sc := math.min(sc, 8)
    // Phase 4.1 : asset non reconnu → aucun scoring (un seul système par asset)
    if not _assetReconnu
        sc := 0
    sc

int _scoreBullLive = f_score(true)
int _scoreBearLive = f_score(false)

// Accumulation scores OB avec freshness (P1.3) et proximité (P1.4)
// bosHaussier n'est true que sur la barre de détection → sans math.max le score retombe à 0
if array.size(obBullScore) > 0
    for _sui = 0 to array.size(obBullScore) - 1
        if not array.get(obBullSignaled, _sui)
            int   _stB   = array.get(obBullState, _sui)
            float _midB  = (array.get(obBullTop, _sui) + array.get(obBullBot, _sui)) / 2.0
            float _distB = not na(atr14) and atr14 > 0 ? math.abs(close - _midB) / atr14 : 0.0
            // Freshness : OB vierge +3 | partiel 0 | profond −2 (déjà retouché = moins fiable)
            int _freshB  = _stB == 0 ? 3 : _stB == 2 ? -2 : 0
            // Proximité : < 1× ATR +2 | > 10× ATR → hors portée, score forcé 0 | > 5× ATR −1
            int _proxB   = _distB > 10.0 ? -999 : _distB < 1.0 ? 2 : _distB > 5.0 ? -1 : 0
            int _cand    = _scoreBullLive + _freshB + _proxB
            // OB profond (état=2) : autoriser la descente du score (ne pas bloquer avec math.max)
            if _stB == 2
                array.set(obBullScore, _sui, math.max(0, _cand))
            else
                array.set(obBullScore, _sui, math.max(array.get(obBullScore, _sui), _cand))
if array.size(obBearScore) > 0
    for _sui = 0 to array.size(obBearScore) - 1
        if not array.get(obBearSignaled, _sui)
            int   _stR   = array.get(obBearState, _sui)
            float _midR  = (array.get(obBearTop, _sui) + array.get(obBearBot, _sui)) / 2.0
            float _distR = not na(atr14) and atr14 > 0 ? math.abs(close - _midR) / atr14 : 0.0
            int _freshR  = _stR == 0 ? 3 : _stR == 2 ? -2 : 0
            int _proxR   = _distR > 10.0 ? -999 : _distR < 1.0 ? 2 : _distR > 5.0 ? -1 : 0
            int _cand    = _scoreBearLive + _freshR + _proxR
            if _stR == 2
                array.set(obBearScore, _sui, math.max(0, _cand))
            else
                array.set(obBearScore, _sui, math.max(array.get(obBearScore, _sui), _cand))

// LABELS OB ENRICHIS — mise à jour dynamique (après scores + HTF + OTE)
f_obLabelUpdate() =>
    if i_moteurOB and barstate.islast
        // ── Boxes OB Bull : texte = force, bordure = avis décisionnel ──
        if array.size(obBullBox) > 0
            for _i = 0 to array.size(obBullBox) - 1
                box _bx = array.get(obBullBox, _i)
                if not na(_bx)
                    int   _sc  = array.get(obBullScore,    _i)
                    int   _st  = array.get(obBullState,    _i)
                    bool  _sig = array.get(obBullSignaled, _i)
                    float _mid = (array.get(obBullTop, _i) + array.get(obBullBot, _i)) / 2.0
                    int   _f   = f_force(_sc)
                    if _f < 5
                        // Filtre bruit : OB faible → masqué (texte + bordure + fond), reste en mémoire.
                        box.set_text(_bx, "")
                        box.set_border_color(_bx, na)
                        box.set_bgcolor(_bx, na)
                    else
                        bool  _disc = not na(pdEquilibrium) and _mid < pdEquilibrium - pdTolAbs
                        bool  _prem = not na(pdEquilibrium) and _mid > pdEquilibrium + pdTolAbs
                        color _bdr = _sig ? C_AVIS_TRADE :
                                     (_st == 2 or _prem) ? C_AVIS_EVITER :
                                     _st == 1 ? C_OB_BDR_BULL :
                                     _disc ? C_AVIS_GUETTER : C_OB_BDR_BULL
                        box.set_text(_bx, "OB " + str.tostring(_f) + "/10")
                        box.set_border_color(_bx, _bdr)
                        box.set_border_width(_bx, _f >= 8 ? 3 : _f >= 5 ? 2 : 1)

        // ── Boxes OB Bear : texte = force, bordure = avis décisionnel ──
        if array.size(obBearBox) > 0
            for _i = 0 to array.size(obBearBox) - 1
                box _bx = array.get(obBearBox, _i)
                if not na(_bx)
                    int   _sc  = array.get(obBearScore,    _i)
                    int   _st  = array.get(obBearState,    _i)
                    bool  _sig = array.get(obBearSignaled, _i)
                    float _mid = (array.get(obBearTop, _i) + array.get(obBearBot, _i)) / 2.0
                    int   _f   = f_force(_sc)
                    if _f < 5
                        box.set_text(_bx, "")
                        box.set_border_color(_bx, na)
                        box.set_bgcolor(_bx, na)
                    else
                        bool  _disc = not na(pdEquilibrium) and _mid < pdEquilibrium - pdTolAbs
                        bool  _prem = not na(pdEquilibrium) and _mid > pdEquilibrium + pdTolAbs
                        color _bdr = _sig ? C_AVIS_TRADE :
                                     (_st == 2 or _disc) ? C_AVIS_EVITER :
                                     _st == 1 ? C_OB_BDR_BEAR :
                                     _prem ? C_AVIS_GUETTER : C_OB_BDR_BEAR
                        box.set_text(_bx, "OB " + str.tostring(_f) + "/10")
                        box.set_border_color(_bx, _bdr)
                        box.set_border_width(_bx, _f >= 8 ? 3 : _f >= 5 ? 2 : 1)

f_obLabelUpdate()

// MODULE 12b — FILTRE RÉGIME DE MARCHÉ (Trend vs Range)
// ADX < seuil → range → signaux bloqués
// ATR ratio court/long < seuil → compression → signaux bloqués
var string GRP_REG   = "⚙️ Technique avancé"
// v11 : i_filtreRegime SUPPRIMÉ (jamais testé en BT, décidée campagne FINAL 2026-07-19).
// Toute la logique de détection range (ADX, ATR ratio, _regimeRange) a été retirée.
// La variable _regimeRange est conservée à false pour ne pas casser les conditions
// `not _regimeRange` dans f_createBuySignals / f_createSellSignals.
bool _regimeRange = false
// Flag anti-double trade par barre : si OB ou BSZones a poussé un trade cette barre,
// l'autre moteur est bloqué (1 trade total par configuration, hors f_tradeBloquant qui
// ne gère que les trades déjà REMPLIS). Reset à chaque barre confirmée.
// Implémenté en array<bool> de taille 1 car Pine v6 interdit de muter une var bool globale
// depuis une fonction ; array.set est autorisé.
var array<bool> _tradePousseCetteBarre = array.new_bool(1, false)
if barstate.isconfirmed
    array.set(_tradePousseCetteBarre, 0, false)

// Détermination du régime — v11 : logique SUPPRIMÉE (voir commentaire GRP_REG ci-dessus).
// _regimeRange est désormais défini à false en dur plus haut (lignes GRP_REG).

// MODULE §25 — SL / TP1 / TP2 / TP3 / BE AUTOMATIQUES
var string GRP_TP    = "🎯 Signaux & Zones"
// Phase 4.2 : SL/TP/durées appliqués automatiquement par profil asset
string i_slMode      = _autoSlMode
int   i_tpWidth      = _autoTpWidth
// v11 : i_oteOnly SUPPRIMÉ (campagne FINAL 2026-07-19 : OTE ON dégrade PF sur 6/15 combos et fait
// s'effondrer la liquidité, ex XAU M15 : 223→7 trades). Le code _oteOk a été retiré de
// f_createBuySignals/f_createSellSignals. inOTE_bull/bear restent utilisés pour le scoring et l'affichage.
int   i_tp3MaxMins   = _autoTp3Mins
// Durée max trade adaptative au TF : H1=480mn, H4=1920mn, D=5760mn, sinon 240mn
int _autoTradeMaxMins = _tfH1 ? 480 : _tfH4 ? 1920 : timeframe.isdaily ? 5760 : 240
int   i_tradeMaxMins  = _autoTradeMaxMins

color C_TP_BG  = color.new(#26a69a, 78)
color C_SL_BG  = color.new(#ef5350, 78)
color C_TP_BDR = color.new(#26a69a, 10)
color C_SL_BDR = color.new(#ef5350, 10)
color C_TP1_L  = color.new(#26a69a,  0)
color C_TP2_L  = color.new(#26a69a,  0)
// Phase 11 — fonds des labels de trade détaillés (BUY vert foncé / SELL rouge foncé)
color C_LBL_BUY  = color.new(#1b5e20, 10)
color C_LBL_SELL = color.new(#b71c1c, 10)

var array<box>   stBullSLBox     = array.new<box>(0)
var array<box>   stBullTPBox     = array.new<box>(0)
var array<label> stBullLbl       = array.new<label>(0)
var array<float> stBullSL        = array.new<float>(0)
var array<float> stBullTP1       = array.new<float>(0)
var array<float> stBullTP2       = array.new<float>(0)
var array<float> stBullTP3       = array.new<float>(0)
var array<float> stBullEntry     = array.new<float>(0)
var array<int>   stBullScore     = array.new<int>(0)
var array<line>  stBullTP1Line   = array.new<line>(0)
var array<line>  stBullTP2Line   = array.new<line>(0)
var array<bool>  stBullTP1Hit    = array.new<bool>(0)
var array<int>   stBullTP2HitTs  = array.new<int>(0)
var array<int>   stBullOpenTs    = array.new<int>(0)
var array<bool>  stBullFilled    = array.new<bool>(0)
var array<int>   stBullSource    = array.new<int>(0)     // 0=OB, 1=BSZones (court-circuit _obIdx lifecycle)

var array<box>   stBearSLBox     = array.new<box>(0)
var array<box>   stBearTPBox     = array.new<box>(0)
var array<label> stBearLbl       = array.new<label>(0)
var array<float> stBearSL        = array.new<float>(0)
var array<float> stBearTP1       = array.new<float>(0)
var array<float> stBearTP2       = array.new<float>(0)
var array<float> stBearTP3       = array.new<float>(0)
var array<float> stBearEntry     = array.new<float>(0)
var array<int>   stBearScore     = array.new<int>(0)
var array<line>  stBearTP1Line   = array.new<line>(0)
var array<line>  stBearTP2Line   = array.new<line>(0)
var array<bool>  stBearTP1Hit    = array.new<bool>(0)
var array<int>   stBearTP2HitTs  = array.new<int>(0)
var array<int>   stBearOpenTs    = array.new<int>(0)
var array<bool>  stBearFilled    = array.new<bool>(0)
var array<int>   stBearSource    = array.new<int>(0)     // 0=OB, 1=BSZones
// v11 : compteurs BT SUPPRIMÉS (campagnes BT terminées). Les incréments dans les
// cycles BUY/SELL ont été neutralisés (// nop). Les fonctions f_createBuySignals/
// SellSignals retournent toujours un tuple pour compatibilité, mais les valeurs
// ne sont plus accumulées.
float _slMin = not na(atr14) ? (_isXAU ? 0.5 * atr14 : _isXAG ? 0.6 * atr14 :
               _isNAS ? 0.5 * atr14 : _isBTC ? 0.8 * atr14 :
               _isDAX ? 0.5 * atr14 : 0.0)
               : (_isXAU ? 50.0 * _pipValue : _isXAG ? 50.0 * _pipValue :
               _isNAS ? 20.0 * _pipValue : _isBTC ? 100.0 * _pipValue :
               _isDAX ? 20.0 * _pipValue : 0.0)
float _slMax = not na(atr14) ? (_isXAU ? 1.5 * atr14 : _isXAG ? 1.8 * atr14 :
               _isNAS ? 1.5 * atr14 : _isBTC ? 2.5 * atr14 :
               _isDAX ? 1.5 * atr14 : 1e10)
               : (_isXAU ? 100.0 * _pipValue : _isXAG ? 100.0 * _pipValue :
               _isNAS ? 50.0 * _pipValue : _isBTC ? 400.0 * _pipValue :
               _isDAX ? 50.0 * _pipValue : 1e10)

// Phase 11 — format d'affichage des prix selon la précision de l'asset
string _fmtPx = _isXAU ? "0.0" : _isXAG ? "0.00" : "0"

// Phase 11 — construit le texte multi-lignes du label de trade (BUY/SELL).
// Chaque niveau affiche son prix absolu en $ ; SL/TP affichent en plus la distance à l'entrée en pips.
f_lblTrade(bool _isBuy, int _sc, int _scMax, float _e, float _s, float _t1, float _t2, float _t3, float _pip, string _fmt, float _lots) =>
    string _r1 = (_isBuy ? "BUY" : "SELL") + " - force " + str.tostring(f_force(_sc)) + "/10"
    string _rL = "→ " + str.tostring(_lots, "0.00") + " lots  (" + str.tostring(int(i_capital * i_riskPct / 100.0)) + "$ risqués)"
    string _r2 = "Entrée " + str.tostring(_e, _fmt) + "$"
    string _r3 = "SL "  + str.tostring(_s,  _fmt) + "$ soit " + str.tostring(int(math.round(math.abs(_s  - _e) / _pip))) + " pips"
    string _r4 = "TP1 " + str.tostring(_t1, _fmt) + "$ soit " + str.tostring(int(math.round(math.abs(_t1 - _e) / _pip))) + " pips"
    string _r5 = "TP2 " + str.tostring(_t2, _fmt) + "$ soit " + str.tostring(int(math.round(math.abs(_t2 - _e) / _pip))) + " pips"
    string _r6 = "TP3 " + str.tostring(_t3, _fmt) + "$ soit " + str.tostring(int(math.round(math.abs(_t3 - _e) / _pip))) + " pips"
    _r1 + "\n" + _rL + "\n" + _r2 + "\n" + _r3 + "\n" + _r4 + "\n" + _r5 + "\n" + _r6

// MODULE 13 — DASHBOARD décisionnel (V2 — Phase 9)

f_syncBordDroit() =>
    if array.size(fvgBullBox) > 0
        for _si = 0 to array.size(fvgBullBox) - 1
            box _sb = array.get(fvgBullBox, _si)
            if not na(_sb)
                box.set_right(_sb, bar_index)
    if array.size(fvgBearBox) > 0
        for _si = 0 to array.size(fvgBearBox) - 1
            box _sb = array.get(fvgBearBox, _si)
            if not na(_sb)
                box.set_right(_sb, bar_index)
    if array.size(obBullBox) > 0
        for _si = 0 to array.size(obBullBox) - 1
            box _sb = array.get(obBullBox, _si)
            if not na(_sb)
                box.set_right(_sb, bar_index)
    if array.size(obBearBox) > 0
        for _si = 0 to array.size(obBearBox) - 1
            box _sb = array.get(obBearBox, _si)
            if not na(_sb)
                box.set_right(_sb, bar_index)
    if array.size(bbBullBox) > 0
        for _si = 0 to array.size(bbBullBox) - 1
            box _sb = array.get(bbBullBox, _si)
            if not na(_sb)
                box.set_right(_sb, bar_index)
    if array.size(bbBearBox) > 0
        for _si = 0 to array.size(bbBearBox) - 1
            box _sb = array.get(bbBearBox, _si)
            if not na(_sb)
                box.set_right(_sb, bar_index)
    if array.size(propBullBox) > 0
        for _si = 0 to array.size(propBullBox) - 1
            box _sb = array.get(propBullBox, _si)
            if not na(_sb)
                box.set_right(_sb, bar_index)
    if array.size(propBearBox) > 0
        for _si = 0 to array.size(propBearBox) - 1
            box _sb = array.get(propBearBox, _si)
            if not na(_sb)
                box.set_right(_sb, bar_index)
    if array.size(ndogBox) > 0
        for _si = 0 to array.size(ndogBox) - 1
            if not array.get(ndogMit, _si)
                box _sb = array.get(ndogBox, _si)
                if not na(_sb)
                    box.set_right(_sb, bar_index)
    if array.size(nwogBox) > 0
        for _si = 0 to array.size(nwogBox) - 1
            if not array.get(nwogMit, _si)
                box _sb = array.get(nwogBox, _si)
                if not na(_sb)
                    box.set_right(_sb, bar_index)
    // EQH/EQL : l'extension bord droit est gérée par f_liqLabels (recrée les lignes à chaque bougie).

// ─── Trouver le meilleur OB non-signalé par score ───────────────────
// Retourne [score, idx, isBull]
f_bestOB() =>
    int   _bsc   = -1
    int   _bidx  = -1
    bool  _bbull = false
    if array.size(obBullScore) > 0
        for _i = 0 to array.size(obBullScore) - 1
            if not array.get(obBullSignaled, _i)
                int _s = array.get(obBullScore, _i)
                if _s > _bsc
                    _bsc   := _s
                    _bidx  := _i
                    _bbull := true
    if array.size(obBearScore) > 0
        for _i = 0 to array.size(obBearScore) - 1
            if not array.get(obBearSignaled, _i)
                int _s = array.get(obBearScore, _i)
                if _s > _bsc
                    _bsc   := _s
                    _bidx  := _i
                    _bbull := false
    [_bsc, _bidx, _bbull]

[_bestSc, _bestIdx, _bestBull] = f_bestOB()


// ── P5.4 : Draw on Liquidity visuel ────────────────────────────────
// Flèche pointant vers la prochaine cible de liquidité (EQH/PDH pour bull, EQL/PDL pour bear)
// Affiché uniquement si un OB de score suffisant est actif ET une cible de liquidité existe
var label _dolLbl = na
if barstate.isconfirmed and i_moteurLiquidite and i_showLiq
    label.delete(_dolLbl)
    _dolLbl := na
    bool  _hasOBDol  = _bestIdx >= 0 and _bestSc >= 10
    if _hasOBDol
        if _bestBull
            // Cible haussière : EQH ou PDH au-dessus du prix (prendre la plus proche = la plus basse)
            float _tEQH = not na(dernierEQH_level) and dernierEQH_level > close ? dernierEQH_level : na
            float _tPDH = not na(pdhActive) and pdhActive > close ? pdhActive : na
            float _dolTarget = na
            if not na(_tEQH) and not na(_tPDH)
                _dolTarget := math.min(_tEQH, _tPDH)
            else if not na(_tEQH)
                _dolTarget := _tEQH
            else if not na(_tPDH)
                _dolTarget := _tPDH
            if not na(_dolTarget)
                string _dTxt = "↑ DoL  " + str.tostring(_dolTarget, format.mintick)
                _dolLbl := label.new(bar_index, low - 0.3 * atr14, _dTxt, xloc=xloc.bar_index,
                     yloc=yloc.price, style=label.style_arrowup,
                     color=color.new(#FFD600, 20), textcolor=color.black, size=size.small)
        else
            // Cible baissière : EQL ou PDL en-dessous du prix (prendre la plus proche = la plus haute)
            float _tEQL = not na(dernierEQL_level) and dernierEQL_level < close ? dernierEQL_level : na
            float _tPDL = not na(pdlActive) and pdlActive < close ? pdlActive : na
            float _dolTarget = na
            if not na(_tEQL) and not na(_tPDL)
                _dolTarget := math.max(_tEQL, _tPDL)
            else if not na(_tEQL)
                _dolTarget := _tEQL
            else if not na(_tPDL)
                _dolTarget := _tPDL
            if not na(_dolTarget)
                string _dTxt = "↓ DoL  " + str.tostring(_dolTarget, format.mintick)
                _dolLbl := label.new(bar_index, high + 0.3 * atr14, _dTxt, xloc=xloc.bar_index,
                     yloc=yloc.price, style=label.style_arrowdown,
                     color=color.new(#00BCD4, 20), textcolor=color.white, size=size.small)

// MODULE 13b — IMBALANCE
var array<float> ibBullTop   = array.new<float>(0)
var array<float> ibBullBot   = array.new<float>(0)
var array<int>   ibBullState = array.new<int>(0)
var array<box>   ibBullBox   = array.new<box>(0)
var int          _ibLastBull = -1

var array<float> ibBearTop   = array.new<float>(0)
var array<float> ibBearBot   = array.new<float>(0)
var array<int>   ibBearState = array.new<int>(0)
var array<box>   ibBearBox   = array.new<box>(0)
var int          _ibLastBear = -1

if i_moteurIB and i_showIB and ibBull and bar_index != _ibLastBull
    _ibLastBull := bar_index
    if array.size(ibBullBox) >= i_maxIB
        box.delete(array.shift(ibBullBox))
        array.shift(ibBullTop)
        array.shift(ibBullBot)
        array.shift(ibBullState)
    float _topB = close
    float _botB = open
    array.push(ibBullTop,   _topB)
    array.push(ibBullBot,   _botB)
    array.push(ibBullState, 0)
    array.push(ibBullBox, box.new(bar_index, _topB, bar_index + 50, _botB,
         bgcolor=C_IB_BULL_FRESH, border_color=C_IB_BORDER, border_width=1,
         text="Imbalance", text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE,
         text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN))

if i_moteurIB and i_showIB and ibBear and bar_index != _ibLastBear
    _ibLastBear := bar_index
    if array.size(ibBearBox) >= i_maxIB
        box.delete(array.shift(ibBearBox))
        array.shift(ibBearTop)
        array.shift(ibBearBot)
        array.shift(ibBearState)
    float _topBr = open
    float _botBr = close
    array.push(ibBearTop,   _topBr)
    array.push(ibBearBot,   _botBr)
    array.push(ibBearState, 0)
    array.push(ibBearBox, box.new(bar_index, _topBr, bar_index + 50, _botBr,
         bgcolor=C_IB_BEAR_FRESH, border_color=C_IB_BORDER, border_width=1,
         text="Imbalance", text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE,
         text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN))

f_ibBullLifecycle() =>
    if i_moteurIB and array.size(ibBullTop) > 0 and barstate.isconfirmed
        array<int> _delIBBull = array.new<int>(0)
        for i = 0 to array.size(ibBullTop) - 1
            float _tB  = array.get(ibBullTop,   i)
            float _bB  = array.get(ibBullBot,   i)
            float _mid = (_tB + _bB) / 2.0
            box _bxIslast = array.get(ibBullBox, i)
            if barstate.islast and not na(_bxIslast)
                box.set_right(_bxIslast, bar_index + 50)
            if close <= _bB
                box.delete(array.get(ibBullBox,  i))
                array.push(_delIBBull, i)
            else if low <= _mid and array.get(ibBullState, i) == 0
                array.set(ibBullState, i, 1)
                if i_masquerInactifs
                    box.delete(array.get(ibBullBox, i))
                    array.set(ibBullBox, i, na)
                else
                    box.set_bgcolor(array.get(ibBullBox, i), C_IB_BULL_PARTIAL)
        if array.size(_delIBBull) > 0
            array.sort(_delIBBull, order.descending)
            for j = 0 to array.size(_delIBBull) - 1
                int _idxB = array.get(_delIBBull, j)
                array.remove(ibBullTop,   _idxB)
                array.remove(ibBullBot,   _idxB)
                array.remove(ibBullState, _idxB)
                array.remove(ibBullBox,   _idxB)


f_ibBullLifecycle()

f_ibBearLifecycle() =>
    if i_moteurIB and array.size(ibBearTop) > 0 and barstate.isconfirmed
        array<int> _delIBBear = array.new<int>(0)
        for i = 0 to array.size(ibBearTop) - 1
            float _tBr  = array.get(ibBearTop,   i)
            float _bBr  = array.get(ibBearBot,   i)
            float _midR = (_tBr + _bBr) / 2.0
            box _bxIslastR = array.get(ibBearBox, i)
            if barstate.islast and not na(_bxIslastR)
                box.set_right(_bxIslastR, bar_index + 50)
            if close >= _tBr
                box.delete(array.get(ibBearBox,  i))
                array.push(_delIBBear, i)
            else if high >= _midR and array.get(ibBearState, i) == 0
                array.set(ibBearState, i, 1)
                if i_masquerInactifs
                    box.delete(array.get(ibBearBox, i))
                    array.set(ibBearBox, i, na)
                else
                    box.set_bgcolor(array.get(ibBearBox, i), C_IB_BEAR_PARTIAL)
        if array.size(_delIBBear) > 0
            array.sort(_delIBBear, order.descending)
            for j = 0 to array.size(_delIBBear) - 1
                int _idxBr = array.get(_delIBBear, j)
                array.remove(ibBearTop,   _idxBr)
                array.remove(ibBearBot,   _idxBr)
                array.remove(ibBearState, _idxBr)
                array.remove(ibBearBox,   _idxBr)


f_ibBearLifecycle()

// SYNC BORD DROIT — mise à jour chaque barre (y compris live)
// Toutes les zones actives se terminent à la bougie courante
f_syncBordDroit()
// Sync bord droit Imbalance (déclarés après f_syncBordDroit)
if array.size(ibBullBox) > 0
    for _si = 0 to array.size(ibBullBox) - 1
        box _sb = array.get(ibBullBox, _si)
        if not na(_sb)
            box.set_right(_sb, bar_index)
if array.size(ibBearBox) > 0
    for _si = 0 to array.size(ibBearBox) - 1
        box _sb = array.get(ibBearBox, _si)
        if not na(_sb)
            box.set_right(_sb, bar_index)

// MODULE 14 — SESSIONS & ASIAN LEVELS (graphiques)
// Calcul des minutes depuis minuit en HEURE DE PARIS (décision 2026-07-26).
// hour(time, "Europe/Paris") et minute(time, "Europe/Paris") gèrent automatiquement
// la DST été/hiver Europe. Les constantes SES_PARIS_* sont en heure Paris.
int  _s14ParisHour = hour(time, "Europe/Paris")
int  _s14ParisMin  = minute(time, "Europe/Paris")
int  _s14Min       = _s14ParisHour * 60 + _s14ParisMin     // minutes depuis minuit Paris
bool _s14Asian     = _s14Min >= SES_PARIS_ASIE_START   and _s14Min < SES_PARIS_ASIE_END
bool _s14London    = _s14Min >= SES_PARIS_LONDON_START and _s14Min < SES_PARIS_LONDON_END
bool _s14NY        = _s14Min >= SES_PARIS_NY_START     and _s14Min < SES_PARIS_NY_END

bool _sAsStart  = _s14Asian  and (bar_index == 0 or not _s14Asian[1])
bool _sLonStart = _s14London and (bar_index == 0 or not _s14London[1])
bool _sNYStart  = _s14NY     and (bar_index == 0 or not _s14NY[1])

// Boxes sessions (historique 24h max pour éviter l'accumulation à l'écran)
var box   _boxAsianCur  = na
var float _sAH          = na
var float _sAL          = na
var int   _sABar        = na
var box   _boxLondonCur = na
var float _sLH          = na
var float _sLL          = na
var int   _sLBar        = na
var box   _boxNYCur     = na
var float _sNH          = na
var float _sNL          = na
var int   _sNBar        = na
// Arrays FIFO des anciennes boxes (pour nettoyage > 24h)
var array<box> _oldAsianBoxes  = array.new<box>(0)
var array<box> _oldLondonBoxes = array.new<box>(0)
var array<box> _oldNYBoxes     = array.new<box>(0)
// Garde-fou 24h en ms
int _24H_MS = 24 * 60 * 60 * 1000

// —— SESSION ASIE ——
if i_showAsian
    if _sAsStart
        // Archiver l'ancienne box (si elle existe) avant d'en créer une nouvelle
        if not na(_boxAsianCur)
            array.push(_oldAsianBoxes, _boxAsianCur)
        _sAH := high
        _sAL := low
        _sABar := bar_index
        _boxAsianCur := box.new(_sABar, _sAH, bar_index + 1, _sAL,
             bgcolor=i_colAsian, border_color=color.new(color.white, 85), border_width=1,
             text="Session Asiatique", text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
    else if _s14Asian and not na(_boxAsianCur)
        _sAH := math.max(_sAH, high)
        _sAL := math.min(_sAL, low)
        box.set_top(_boxAsianCur,    _sAH)
        box.set_bottom(_boxAsianCur, _sAL)
        box.set_right(_boxAsianCur,  bar_index + 1)
    // Nettoyage FIFO : supprimer les boxes de sessions vieilles de plus de 24h
    while array.size(_oldAsianBoxes) > 0
        box _oldBx = array.get(_oldAsianBoxes, 0)
        // Récupérer le timestamp de début de la box (left) — comparaison via bar_time
        int _oldLeft = box.get_left(_oldBx)
        if time - _oldLeft > _24H_MS
            box.delete(_oldBx)
            array.remove(_oldAsianBoxes, 0)
        else
            break

// —— SESSION EUROPE (Londres) ——
if i_showLondon
    if _sLonStart
        if not na(_boxLondonCur)
            array.push(_oldLondonBoxes, _boxLondonCur)
        _sLH := high
        _sLL := low
        _sLBar := bar_index
        _boxLondonCur := box.new(_sLBar, _sLH, bar_index + 1, _sLL,
             bgcolor=i_colLondon, border_color=color.new(color.white, 85), border_width=1,
             text="Session Européenne", text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
    else if _s14London and not na(_boxLondonCur)
        _sLH := math.max(_sLH, high)
        _sLL := math.min(_sLL, low)
        box.set_top(_boxLondonCur,    _sLH)
        box.set_bottom(_boxLondonCur, _sLL)
        box.set_right(_boxLondonCur,  bar_index + 1)
    while array.size(_oldLondonBoxes) > 0
        box _oldBx = array.get(_oldLondonBoxes, 0)
        int _oldLeft = box.get_left(_oldBx)
        if time - _oldLeft > _24H_MS
            box.delete(_oldBx)
            array.remove(_oldLondonBoxes, 0)
        else
            break

// —— SESSION AMÉRIQUE (New York) ——
if i_showNY
    if _sNYStart
        if not na(_boxNYCur)
            array.push(_oldNYBoxes, _boxNYCur)
        _sNH := high
        _sNL := low
        _sNBar := bar_index
        _boxNYCur := box.new(_sNBar, _sNH, bar_index + 1, _sNL,
             bgcolor=i_colNY, border_color=color.new(color.white, 85), border_width=1,
             text="Session Américaine", text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE, text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN)
    else if _s14NY and not na(_boxNYCur)
        _sNH := math.max(_sNH, high)
        _sNL := math.min(_sNL, low)
        box.set_top(_boxNYCur,    _sNH)
        box.set_bottom(_boxNYCur, _sNL)
        box.set_right(_boxNYCur,  bar_index + 1)
    while array.size(_oldNYBoxes) > 0
        box _oldBx = array.get(_oldNYBoxes, 0)
        int _oldLeft = box.get_left(_oldBx)
        if time - _oldLeft > _24H_MS
            box.delete(_oldBx)
            array.remove(_oldNYBoxes, 0)
        else
            break

var float _ahHigh      = na
var float _ahLow       = na
var int   _ahStartBar  = na
var line  _ahHighLine  = na
var line  _ahLowLine   = na
var label _ahHighLbl   = na
var label _ahLowLbl    = na
// Sync bord droit lignes Asian + labels (déclarées ici)
if not na(_ahHighLine)
    line.set_x2(_ahHighLine, bar_index)
if not na(_ahLowLine)
    line.set_x2(_ahLowLine, bar_index)
if not na(_ahHighLbl)
    label.set_x(_ahHighLbl, bar_index)
if not na(_ahLowLbl)
    label.set_x(_ahLowLbl, bar_index)
var float _ahHighDrawn = na
var float _ahLowDrawn  = na

bool _ahStart = _sAsStart
bool _ahEnd   = not _s14Asian and _s14Asian[1]

if _ahStart
    _ahHigh     := high
    _ahLow      := low
    _ahStartBar := bar_index

if _s14Asian and not _ahStart
    _ahHigh := math.max(_ahHigh, high)
    _ahLow  := math.min(_ahLow,  low)

// ── CORRECTIF « décisions trading » 2026-08-23 : l'état TRADING (_ahHighDrawn/
// _ahLowDrawn — consommés par f_znQual DoL et TP3) est dissocié de l'AFFICHAGE.
// Avant : production nichée dans `if _ahEnd and i_showAsianHL` et invalidation
// exigeant l'objet graphique ⇒ affichage décoché = niveaux jamais produits.
if _ahEnd and not na(_ahHigh)
    _ahHighDrawn := _ahHigh
    _ahLowDrawn  := _ahLow

if barstate.isconfirmed
    // « Décisions trading » : niveau ATTEINT (sweep ou cassure) = consommé.
    if not na(_ahHighDrawn) and high >= _ahHighDrawn
        _ahHighDrawn := na
    if not na(_ahLowDrawn) and low <= _ahLowDrawn
        _ahLowDrawn  := na

// Affichage : suit l'état trading, gated par i_showAsianHL.
if _ahEnd and i_showAsianHL and not na(_ahHigh)
    if not na(_ahHighLine)
        line.delete(_ahHighLine)
    if not na(_ahLowLine)
        line.delete(_ahLowLine)
    if not na(_ahHighLbl)
        label.delete(_ahHighLbl)
    if not na(_ahLowLbl)
        label.delete(_ahLowLbl)
    _ahHighLine  := line.new(_ahStartBar, _ahHigh, bar_index, _ahHigh,
        xloc=xloc.bar_index, color=i_colAsianH,
        width=1, style=line.style_dashed, extend=extend.none)
    _ahLowLine   := line.new(_ahStartBar, _ahLow,  bar_index, _ahLow,
        xloc=xloc.bar_index, color=i_colAsianL,
        width=1, style=line.style_dashed, extend=extend.none)
    _ahHighLbl := label.new(bar_index, _ahHigh, "Asian High",
        xloc=xloc.bar_index,
        color=color.new(i_colAsianH, 80), textcolor=i_colAsianH,
        style=label.style_label_left, size=size.small)
    _ahLowLbl := label.new(bar_index, _ahLow, "Asian Low",
        xloc=xloc.bar_index,
        color=color.new(i_colAsianL, 80), textcolor=i_colAsianL,
        style=label.style_label_left, size=size.small)

if i_showAsianHL and barstate.isconfirmed
    if not na(_ahHighLine) and na(_ahHighDrawn)
        line.delete(_ahHighLine)
        if not na(_ahHighLbl)
            label.delete(_ahHighLbl)
        _ahHighLine  := na
        _ahHighLbl   := na
    if not na(_ahLowLine) and na(_ahLowDrawn)
        line.delete(_ahLowLine)
        if not na(_ahLowLbl)
            label.delete(_ahLowLbl)
        _ahLowLine   := na
        _ahLowLbl    := na

// MODULE 15 — ALERTES

// GESTION DES TRADES — Logique de cycle de vie
f_delBullSignal(int idx) =>
    box   _bsl = array.get(stBullSLBox,    idx)
    box   _btp = array.get(stBullTPBox,    idx)
    label _lbl = array.get(stBullLbl,      idx)
    line  _l1  = array.get(stBullTP1Line,  idx)
    line  _l2  = array.get(stBullTP2Line,  idx)
    if not na(_bsl)
        box.delete(_bsl)
    if not na(_btp)
        box.delete(_btp)
    if not na(_lbl)
        label.delete(_lbl)
    if not na(_l1)
        line.delete(_l1)
    if not na(_l2)
        line.delete(_l2)

f_delBearSignal(int idx) =>
    box   _bsl = array.get(stBearSLBox,    idx)
    box   _btp = array.get(stBearTPBox,    idx)
    label _lbl = array.get(stBearLbl,      idx)
    line  _l1  = array.get(stBearTP1Line,  idx)
    line  _l2  = array.get(stBearTP2Line,  idx)
    if not na(_bsl)
        box.delete(_bsl)
    if not na(_btp)
        box.delete(_btp)
    if not na(_lbl)
        label.delete(_lbl)
    if not na(_l1)
        line.delete(_l1)
    if not na(_l2)
        line.delete(_l2)

f_purgeBullSignalData(int idx) =>
    array.remove(stBullSLBox,    idx)
    array.remove(stBullTPBox,    idx)
    array.remove(stBullLbl,      idx)
    array.remove(stBullTP1Line,  idx)
    array.remove(stBullTP2Line,  idx)
    array.remove(stBullSL,       idx)
    array.remove(stBullTP1,      idx)
    array.remove(stBullTP2,      idx)
    array.remove(stBullTP3,      idx)
    array.remove(stBullEntry,    idx)
    array.remove(stBullScore,    idx)
    array.remove(stBullTP1Hit,   idx)
    array.remove(stBullTP2HitTs, idx)
    array.remove(stBullOpenTs,   idx)
    array.remove(stBullFilled,   idx)
    array.remove(stBullSource,   idx)

f_purgeBearSignalData(int idx) =>
    array.remove(stBearSLBox,    idx)
    array.remove(stBearTPBox,    idx)
    array.remove(stBearLbl,      idx)
    array.remove(stBearTP1Line,  idx)
    array.remove(stBearTP2Line,  idx)
    array.remove(stBearSL,       idx)
    array.remove(stBearTP1,      idx)
    array.remove(stBearTP2,      idx)
    array.remove(stBearTP3,      idx)
    array.remove(stBearEntry,    idx)
    array.remove(stBearScore,    idx)
    array.remove(stBearTP1Hit,   idx)
    array.remove(stBearTP2HitTs, idx)
    array.remove(stBearOpenTs,   idx)
    array.remove(stBearFilled,   idx)
    array.remove(stBearSource,   idx)

// Blocage global MM — bloque uniquement si un trade est OUVERT (rempli) et NON NEUTRALISÉ (pas encore TP1/BE).
// Les trades en ATTENTE de retest (non remplis) ne bloquent PAS la génération de nouveaux signaux.
// Évalué EN TEMPS RÉEL (parcourt les arrays de trade) : un trade rempli non-BE bloque tout nouveau signal.
f_tradeBloquant() =>
    bool _bloq = false
    if array.size(stBullSLBox) > 0
        for _i = 0 to array.size(stBullTP1Hit) - 1
            if array.get(stBullFilled, _i) and not array.get(stBullTP1Hit, _i)
                _bloq := true
    if array.size(stBearSLBox) > 0 and not _bloq
        for _i = 0 to array.size(stBearTP1Hit) - 1
            if array.get(stBearFilled, _i) and not array.get(stBearTP1Hit, _i)
                _bloq := true
    _bloq

// _pipValue / _slMin / _slMax déclarés ici (utilisés par les signaux et le Dashboard V2)

// A/B BACKTEST — modèle d'exécution figé sur "Retest (limite)" (gagnant 15/15 vs marché). Le code marché reste
// présent (témoin) ; basculer manuellement ici sur "Marché à la cassure" si besoin de refaire l'A/B.
string i_execModel = "Retest (limite)"

// ── FILTRES QUALITÉ P1/P2 (Option A) — appliqués À LA FOIS aux zones ET à la génération de trades ──
// Chaque sous-filtre est neutre si son input est OFF → comportement d'origine strictement inchangé.
// f_znHasFVG : chevauchement FVG spécifique à UN OB (P1.2, évite la fuite du booléen global).
f_znHasFVG(array<float> _ft, array<float> _fb, float _obT, float _obB) =>
    bool _r = false
    if array.size(_ft) > 0
        for _k = 0 to array.size(_ft) - 1
            if not _r and array.get(_ft, _k) > _obB and array.get(_fb, _k) < _obT
                _r := true
    _r

f_znQualBull(int _i) =>
    bool  _fvg  = true
    if i_znFvgReq
        _fvg := f_znHasFVG(fvgBullTop, fvgBullBot, array.get(obBullTop, _i), array.get(obBullBot, _i))
    bool  _dol = true
    if i_znDolReq
        float _t2 = array.get(obBullTop, _i)
        _dol := (not na(dernierEQH_level) and dernierEQH_level > _t2) or (not na(pdhActive) and pdhActive > _t2) or (not na(pwhActive) and pwhActive > _t2) or (not na(_ahHighDrawn) and _ahHighDrawn > _t2)
    _fvg and _dol

f_znQualBear(int _i) =>
    bool  _fvg  = true
    if i_znFvgReq
        _fvg := f_znHasFVG(fvgBearTop, fvgBearBot, array.get(obBearTop, _i), array.get(obBearBot, _i))
    bool  _dol = true
    if i_znDolReq
        float _b2 = array.get(obBearBot, _i)
        _dol := (not na(dernierEQL_level) and dernierEQL_level < _b2) or (not na(pdlActive) and pdlActive < _b2) or (not na(pwlActive) and pwlActive < _b2) or (not na(_ahLowDrawn) and _ahLowDrawn < _b2)
    _fvg and _dol

// ── MOTEUR B (Module 15) : Variables de validation Sweep → Displacement → BOS ──
// Structure (swings fractals swL=3 pour réactivité)
float _m15_ph = ta.pivothigh(high, 3, 3)
float _m15_pl = ta.pivotlow(low, 3, 3)
var float _m15_sh1 = na
var float _m15_sl1 = na
if not na(_m15_ph)
    _m15_sh1 := _m15_ph
if not na(_m15_pl)
    _m15_sl1 := _m15_pl

// BOS / MSS (validation structurelle)
bool _m15_bosBull = barstate.isconfirmed and not na(_m15_sh1) and close > _m15_sh1 and close[1] <= _m15_sh1
bool _m15_bosBear = barstate.isconfirmed and not na(_m15_sl1) and close < _m15_sl1 and close[1] >= _m15_sl1
var int _m15_dernierBosBull_bar = na
var int _m15_dernierBosBear_bar = na
if _m15_bosBull
    _m15_dernierBosBull_bar := bar_index
if _m15_bosBear
    _m15_dernierBosBear_bar := bar_index

// Displacement strict (corps ≥ 1.5× ATR)
float _m15_dispThreshold = 1.5 * atr14
bool _m15_displacementBull = barstate.isconfirmed and (close > open) and (close - open) >= _m15_dispThreshold
bool _m15_displacementBear = barstate.isconfirmed and (close < open) and (open - close) >= _m15_dispThreshold

// Sweep récent (fenêtre 10 barres max)
int _m15_tfSec = timeframe.in_seconds()
int M15_SWEEP_FRESH_BARS = na(_m15_tfSec) or _m15_tfSec <= 0 ? 10 : math.max(2, int(math.round(9000.0 / _m15_tfSec)))
bool _m15_sweepRecentBull = not na(dernierSweepH_bar) and (bar_index - dernierSweepH_bar) <= M15_SWEEP_FRESH_BARS
bool _m15_sweepRecentBear = not na(dernierSweepB_bar) and (bar_index - dernierSweepB_bar) <= M15_SWEEP_FRESH_BARS
// _m15_displacement* et _m15_sweepRecent* sont consommés par le moteur BSZones (module dédié).

// ════════════════════════════════════════════════════════════════════════
// MODULE BSZONES — Détecteur de zones Buy/Sell 5 étoiles (Sweep→Disp→OB canonique ICT 2022)
// Intégré en coexistence avec le moteur OB : BSZones crée ses PROPRES zones indépendantes
// (arrays bs*) et génère ses PROPRES trades, alimentant le même lifecycle stBull*/stBear*.
// Réutilise les variables déjà calculées par v12 (atr14, pdhActive, h1Trend, fvgBullTop,
// pdEquilibrium, inKZ, inOTE_bull, dernierSweepH_bar, _m15_displacement*...).
// ════════════════════════════════════════════════════════════════════════
int   i_minScore      = input.int(5, "BSZones : score min affichage (/10)", minval=1, maxval=10, group=GRP_ZN)
int   i_tradeMinScore = input.int(7, "BSZones : score min trade (/10)", minval=1, maxval=10, group=GRP_ZN, tooltip="Les zones 5-6 s'affichent pour le trading manuel. Seules les zones >= ce seuil génèrent un trade automatique.")
int   i_dispMult  = input.int(15, "BSZones : displacement min (corps = X/10 × ATR)", minval=10, maxval=30, group=GRP_ZN, tooltip="15 = 1.5× ATR (recommandé). 20 = plus strict.")

// Globales BSZones manquantes (absentes de v12)
float volSma20 = ta.sma(volume, 20)[1]   // baseline volume figée [1] (exclut la bougie OB)
float _obBodyRange1 = (high[1] - low[1]) > 0 ? math.abs(close[1] - open[1]) / (high[1] - low[1]) : 0.0
// Dead-zone NY lunch (canon ICT 2022) : 16h-18h UTC = NY 12h-14h = faux signaux.
int _bsKzMins = int(time % 86400000) / 60000
bool inDeadZone = _bsKzMins >= 960 and _bsKzMins < 1080

// Constantes visuelles BSZones (3 états de mitigation)
color C_BS_BULL_FRESH = color.new(#00C853, 70)
color C_BS_BULL_PART  = color.new(#00C853, 83)
color C_BS_BULL_DEEP  = color.new(#00C853, 91)
color C_BS_BEAR_FRESH = color.new(#D50000, 70)
color C_BS_BEAR_PART  = color.new(#D50000, 83)
color C_BS_BEAR_DEEP  = color.new(#D50000, 91)
string BS_TXT_HALIGN = text.align_right
string BS_TXT_VALIGN = text.align_top

// Arrays OB BSZones (préfixe bs* pour éviter tout conflit avec les arrays OB de v12)
var array<float> bsBullTop       = array.new<float>(0)
var array<float> bsBullBot       = array.new<float>(0)
var array<int>   bsBullState     = array.new<int>(0)      // 0=FRESH, 1=PARTIAL, 2=DEEP
var array<int>   bsBullBaseScore = array.new<int>(0)      // Socle figé /16
var array<int>   bsBullScore     = array.new<int>(0)      // Score total /10 (dynamique)
var array<box>   bsBullBox       = array.new<box>(0)
var array<bool>  bsBullInOTE     = array.new<bool>(0)     // OTE figé à la création
var array<bool>  bsBullSignaled  = array.new<bool>(0)     // anti-retrade (pushé à false à la création)
var array<float> bsBearTop       = array.new<float>(0)
var array<float> bsBearBot       = array.new<float>(0)
var array<int>   bsBearState     = array.new<int>(0)
var array<int>   bsBearBaseScore = array.new<int>(0)
var array<int>   bsBearScore     = array.new<int>(0)
var array<box>   bsBearBox       = array.new<box>(0)
var array<bool>  bsBearInOTE     = array.new<bool>(0)
var array<bool>  bsBearSignaled  = array.new<bool>(0)

// ─── FONCTIONS DE SCORING BSZONES (portées, sans dépendance globale interne) ──────────────
_dispScore(float body, float atr, float body3) =>
    float r1 = atr > 0 ? body / atr : 0.0
    float r3 = atr > 0 ? body3 / atr : 0.0
    float ratio = math.max(r1, r3)
    ratio >= 3.5 ? 3 : ratio >= 2.5 ? 2 : 1

_bodyRangeScore(float br) => br >= 0.7 ? 1 : 0

_volScore(float vol, float sma) =>
    sma > 0 ? (vol >= 2.0 * sma ? 2 : vol >= 1.5 * sma ? 1 : 0) : 0

_sweepScore(int sweepBar) =>
    int barsAgo = bar_index - sweepBar
    barsAgo <= 2 ? 2 : barsAgo <= 5 ? 1 : 0

_mitScore(int st) =>
    st == 0 ? 3 : st == 1 ? 1 : 0

_proxScore(float price, float top, float bot, float atr) =>
    float dist = math.min(math.abs(price - top), math.abs(price - bot))
    float ratio = atr > 0 ? dist / atr : 999.0
    ratio <= 1.0 ? 2 : ratio <= 3.0 ? 1 : 0

_fvgScore(bool hasFvg) =>
    hasFvg ? 1 : 0

_bsPdScore(bool isBull, float eq) =>
    if na(eq)
        0
    else if isBull
        close < eq ? 1 : 0
    else
        close > eq ? 1 : 0

_bsKzScore(bool inKz, bool isDeadZone) =>
    isDeadZone ? 0 : (inKz ? 1 : 0)

_bosScore(int bosBar) =>
    not na(bosBar) and (bar_index - bosBar) <= 3 ? 3 : 0

_chochScore(int chochBar) =>
    not na(chochBar) and (bar_index - chochBar) <= 5 ? 2 : 0

_bsHtfScore(bool isBull, int h1, int h4) =>
    int d = isBull ? 1 : -1
    (h1 == d and h4 == d) ? 2 : (h1 == d or h4 == d) ? 1 : 0

_oteScore(bool isBull, bool inOTE) =>
    inOTE ? 1 : 0

_coeurScore(bool hasFvg, bool inOTE) => (hasFvg and inOTE) ? 3 : 0

_toForce10(int raw) =>
    int sc = math.round(raw * 10.0 / 27.0)
    sc < 0 ? 0 : sc > 10 ? 10 : sc

// ─── TAGS D'AFFICHAGE BSZONES (multiligne étoilé) ────────────────────────────────────────
_starLine(int score, bool isBull) =>
    string _emoji = isBull ? "🟢" : "🔴"
    int _n = math.round(score / 2.0)
    _n := _n > 5 ? 5 : _n < 0 ? 0 : _n
    string _filled = ""
    for _i = 1 to _n
        _filled := _filled + "★"
    string _empty = ""
    for _i = 1 to (5 - _n)
        _empty := _empty + "☆"
    string _bonus = score >= 8 ? " ★" : ""
    _emoji + " " + str.tostring(score) + "/10 " + _filled + _empty + _bonus

_ctxLine(bool isBull, int h1, int h4, float eq, float zMid) =>
    int d = isBull ? 1 : -1
    string _htf = (h1 == d and h4 == d) ? "✅ HTF" : (h1 == -d and h4 == -d) ? "❌ HTF" : "⚠ HTF"
    string _pd = ""
    if not na(eq)
        bool _fav = isBull ? (zMid < eq) : (zMid > eq)
        if isBull
            _pd := _fav ? " · 📉 Discount" : " · 📈 Premium"
        else
            _pd := _fav ? " · 📈 Premium" : " · 📉 Discount"
    _htf + _pd

_tradeInfo(bool isBull, float zTop, float zBot, float liqTarget) =>
    if na(liqTarget) or liqTarget <= 0
        ""
    else
        float entry = isBull ? zTop : zBot
        float sl    = isBull ? zBot : zTop
        float r     = isBull ? (entry - sl) : (sl - entry)
        if r <= 0
            ""
        else
            float tp = liqTarget
            float rr = isBull ? (tp - entry) / r : (entry - tp) / r
            if rr < 2.0
                ""
            else
                "🎯 RR " + str.tostring(math.round(rr * 10.0) / 10.0)

_bsDolTarget(bool isBull, float entry) =>
    float best = na
    if isBull
        if not na(dernierEQH_level) and dernierEQH_level > entry
            best := dernierEQH_level
        if not na(pdhActive) and pdhActive > entry
            best := na(best) ? pdhActive : math.min(best, pdhActive)
        if not na(pwhActive) and pwhActive > entry
            best := na(best) ? pwhActive : math.min(best, pwhActive)
    else
        if not na(dernierEQL_level) and dernierEQL_level < entry
            best := dernierEQL_level
        if not na(pdlActive) and pdlActive < entry
            best := na(best) ? pdlActive : math.max(best, pdlActive)
        if not na(pwlActive) and pwlActive < entry
            best := na(best) ? pwlActive : math.max(best, pwlActive)
    best

_bsCForState(int st, bool isBull) =>
    if isBull
        st == 0 ? C_BS_BULL_FRESH : st == 1 ? C_BS_BULL_PART : C_BS_BULL_DEEP
    else
        st == 0 ? C_BS_BEAR_FRESH : st == 1 ? C_BS_BEAR_PART : C_BS_BEAR_DEEP


// ─── CRÉATION DES ZONES BSZONES (Sweep→Disp→OB canonique ICT) ────────────────────────────
// newBullOB = displacement + sweep récent (rebranché sur _m15_* du moteur B).
bool newBSBullOB = _m15_displacementBull and _m15_sweepRecentBull
bool newBSBearOB = _m15_displacementBear and _m15_sweepRecentBear

if newBSBullOB and barstate.isconfirmed
    float _obT = high[1]
    float _obB = low[1]
    float _body = close - open
    float _b1 = close - open
    float _b2 = close > open and close[1] > open[1] ? close[1] - open[1] : 0.0
    float _b3 = _b2 > 0 and close[2] > open[2] ? close[2] - open[2] : 0.0
    float _body3 = _b1 + _b2 + _b3
    int _scA = _dispScore(_body, atr14, _body3)
    int _scB = _sweepScore(dernierSweepH_bar)
    int _scC = 3  // VIERGE à la création
    int _scH = _bosScore(_m15_dernierBosBull_bar)
    int _scI = _chochScore(dernierChochBull_bar)
    int _scL = _bodyRangeScore(_obBodyRange1)
    int _scM = _volScore(volume[1], volSma20)
    int _baseScore = _scA + _scB + _scC + _scH + _scI + _scL + _scM
    // GATE HTF (canon ICT) : BUY ne naît que si H1 ou H4 haussier.
    if _baseScore >= 6 and (h1Trend == 1 or h4Trend == 1)
        bool _hasFvg0 = f_znHasFVG(fvgBullTop, fvgBullBot, _obT, _obB)
        int _dynScore = _proxScore(close, _obT, _obB, atr14) + _fvgScore(_hasFvg0) + _bsPdScore(true, pdEquilibrium) + _bsKzScore(inKZ, inDeadZone) + _bsHtfScore(true, h1Trend, h4Trend) + _oteScore(true, inOTE_bull) + _coeurScore(_hasFvg0, inOTE_bull)
        int _sc = _toForce10(_baseScore + _dynScore)
        array.push(bsBullTop, _obT)
        array.push(bsBullBot, _obB)
        array.push(bsBullState, 0)
        array.push(bsBullBaseScore, _baseScore)
        array.push(bsBullScore, _sc)
        array.push(bsBullInOTE, inOTE_bull)
        array.push(bsBullSignaled, false)   // pas encore tradé
        bool _show0 = _sc >= i_minScore
        color _bg0 = _show0 ? C_BS_BULL_FRESH : na
        color _bd0 = _show0 ? color.new(color.white, 80) : na
        string _tx0 = _show0 ? _starLine(_sc, true) + "\n" + _ctxLine(true, h1Trend, h4Trend, pdEquilibrium, (_obT + _obB) / 2.0) + (_tradeInfo(true, _obT, _obB, _bsDolTarget(true, _obT)) == "" ? "" : "\n" + _tradeInfo(true, _obT, _obB, _bsDolTarget(true, _obT))) : ""
        box _bx = box.new(bar_index[1], _obT, bar_index + 30, _obB, bgcolor=_bg0, border_color=_bd0, text=_tx0, text_color=color.white, text_size=size.tiny, text_halign=BS_TXT_HALIGN, text_valign=BS_TXT_VALIGN)
        array.push(bsBullBox, _bx)
        if array.size(bsBullTop) > 20
            box.delete(array.get(bsBullBox, 0))
            array.remove(bsBullBox, 0)
            array.remove(bsBullTop, 0)
            array.remove(bsBullBot, 0)
            array.remove(bsBullState, 0)
            array.remove(bsBullBaseScore, 0)
            array.remove(bsBullScore, 0)
            array.remove(bsBullInOTE, 0)
            array.remove(bsBullSignaled, 0)

if newBSBearOB and barstate.isconfirmed
    float _obT = high[1]
    float _obB = low[1]
    float _body = open - close
    float _b1 = open - close
    float _b2 = close < open and close[1] < open[1] ? open[1] - close[1] : 0.0
    float _b3 = _b2 > 0 and close[2] < open[2] ? open[2] - close[2] : 0.0
    float _body3 = _b1 + _b2 + _b3
    int _scA = _dispScore(_body, atr14, _body3)
    int _scB = _sweepScore(dernierSweepB_bar)
    int _scC = 3
    int _scH = _bosScore(_m15_dernierBosBear_bar)
    int _scI = _chochScore(dernierChochBear_bar)
    int _scL = _bodyRangeScore(_obBodyRange1)
    int _scM = _volScore(volume[1], volSma20)
    int _baseScore = _scA + _scB + _scC + _scH + _scI + _scL + _scM
    // GATE HTF : SELL ne naît que si H1 ou H4 baissier.
    if _baseScore >= 6 and (h1Trend == -1 or h4Trend == -1)
        bool _hasFvg0 = f_znHasFVG(fvgBearTop, fvgBearBot, _obT, _obB)
        int _dynScore = _proxScore(close, _obT, _obB, atr14) + _fvgScore(_hasFvg0) + _bsPdScore(false, pdEquilibrium) + _bsKzScore(inKZ, inDeadZone) + _bsHtfScore(false, h1Trend, h4Trend) + _oteScore(false, inOTE_bear) + _coeurScore(_hasFvg0, inOTE_bear)
        int _sc = _toForce10(_baseScore + _dynScore)
        array.push(bsBearTop, _obT)
        array.push(bsBearBot, _obB)
        array.push(bsBearState, 0)
        array.push(bsBearBaseScore, _baseScore)
        array.push(bsBearScore, _sc)
        array.push(bsBearInOTE, inOTE_bear)
        array.push(bsBearSignaled, false)
        bool _show0 = _sc >= i_minScore
        color _bg0 = _show0 ? C_BS_BEAR_FRESH : na
        color _bd0 = _show0 ? color.new(color.white, 80) : na
        string _tx0 = _show0 ? _starLine(_sc, false) + "\n" + _ctxLine(false, h1Trend, h4Trend, pdEquilibrium, (_obT + _obB) / 2.0) + (_tradeInfo(false, _obT, _obB, _bsDolTarget(false, _obB)) == "" ? "" : "\n" + _tradeInfo(false, _obT, _obB, _bsDolTarget(false, _obB))) : ""
        box _bx = box.new(bar_index[1], _obT, bar_index + 30, _obB, bgcolor=_bg0, border_color=_bd0, text=_tx0, text_color=color.white, text_size=size.tiny, text_halign=BS_TXT_HALIGN, text_valign=BS_TXT_VALIGN)
        array.push(bsBearBox, _bx)
        if array.size(bsBearTop) > 20
            box.delete(array.get(bsBearBox, 0))
            array.remove(bsBearBox, 0)
            array.remove(bsBearTop, 0)
            array.remove(bsBearBot, 0)
            array.remove(bsBearState, 0)
            array.remove(bsBearBaseScore, 0)
            array.remove(bsBearScore, 0)
            array.remove(bsBearInOTE, 0)
            array.remove(bsBearSignaled, 0)

// ─── LIFECYCLE ZONES BSZONES (mitigation + invalidation + recalcul score) ────────────────
if array.size(bsBullTop) > 0 and barstate.isconfirmed
    for i = array.size(bsBullTop) - 1 to 0
        float topB = array.get(bsBullTop, i)
        float botB = array.get(bsBullBot, i)
        int   st   = array.get(bsBullState, i)
        bool  inval = low < botB
        if inval
            box.delete(array.get(bsBullBox, i))
            array.remove(bsBullBox, i)
            array.remove(bsBullTop, i)
            array.remove(bsBullBot, i)
            array.remove(bsBullState, i)
            array.remove(bsBullBaseScore, i)
            array.remove(bsBullScore, i)
            array.remove(bsBullInOTE, i)
            array.remove(bsBullSignaled, i)
        else
            float mid = (topB + botB) / 2.0
            int newSt = st
            if low <= topB
                if close <= mid and st < 2
                    newSt := 2
                else if close > mid and st == 0
                    newSt := 1
            if newSt != st
                array.set(bsBullState, i, newSt)
                int oldBase = array.get(bsBullBaseScore, i)
                int newBase = oldBase - _mitScore(st) + _mitScore(newSt)
                array.set(bsBullBaseScore, i, newBase)
            int _baseS = array.get(bsBullBaseScore, i)
            bool _oteFige = array.get(bsBullInOTE, i)
            bool _hasFvg = f_znHasFVG(fvgBullTop, fvgBullBot, topB, botB)
            int _dynS = _proxScore(close, topB, botB, atr14) + _fvgScore(_hasFvg) + _bsPdScore(true, pdEquilibrium) + _bsKzScore(inKZ, inDeadZone) + _bsHtfScore(true, h1Trend, h4Trend) + _oteScore(true, _oteFige) + _coeurScore(_hasFvg, _oteFige)
            int _totalS = _toForce10(_baseS + _dynS)
            array.set(bsBullScore, i, _totalS)
            bool _show = _totalS >= i_minScore
            if _show
                box.set_bgcolor(array.get(bsBullBox, i), _bsCForState(newSt, true))
                box.set_border_color(array.get(bsBullBox, i), color.new(color.white, 80))
                box.set_text(array.get(bsBullBox, i), _starLine(_totalS, true) + "\n" + _ctxLine(true, h1Trend, h4Trend, pdEquilibrium, (topB + botB) / 2.0) + (_tradeInfo(true, topB, botB, _bsDolTarget(true, topB)) == "" ? "" : "\n" + _tradeInfo(true, topB, botB, _bsDolTarget(true, topB))))
            else
                box.set_bgcolor(array.get(bsBullBox, i), na)
                box.set_border_color(array.get(bsBullBox, i), na)
                box.set_text(array.get(bsBullBox, i), "")
            box.set_right(array.get(bsBullBox, i), bar_index + 5)

if array.size(bsBearTop) > 0 and barstate.isconfirmed
    for i = array.size(bsBearTop) - 1 to 0
        float topB = array.get(bsBearTop, i)
        float botB = array.get(bsBearBot, i)
        int   st   = array.get(bsBearState, i)
        bool  inval = high > topB
        if inval
            box.delete(array.get(bsBearBox, i))
            array.remove(bsBearBox, i)
            array.remove(bsBearTop, i)
            array.remove(bsBearBot, i)
            array.remove(bsBearState, i)
            array.remove(bsBearBaseScore, i)
            array.remove(bsBearScore, i)
            array.remove(bsBearInOTE, i)
            array.remove(bsBearSignaled, i)
        else
            float mid = (topB + botB) / 2.0
            int newSt = st
            if high >= botB
                if close >= mid and st < 2
                    newSt := 2
                else if close < mid and st == 0
                    newSt := 1
            if newSt != st
                array.set(bsBearState, i, newSt)
                int oldBase = array.get(bsBearBaseScore, i)
                int newBase = oldBase - _mitScore(st) + _mitScore(newSt)
                array.set(bsBearBaseScore, i, newBase)
            int _baseS = array.get(bsBearBaseScore, i)
            bool _oteFige = array.get(bsBearInOTE, i)
            bool _hasFvg = f_znHasFVG(fvgBearTop, fvgBearBot, topB, botB)
            int _dynS = _proxScore(close, topB, botB, atr14) + _fvgScore(_hasFvg) + _bsPdScore(false, pdEquilibrium) + _bsKzScore(inKZ, inDeadZone) + _bsHtfScore(false, h1Trend, h4Trend) + _oteScore(false, _oteFige) + _coeurScore(_hasFvg, _oteFige)
            int _totalS = _toForce10(_baseS + _dynS)
            array.set(bsBearScore, i, _totalS)
            bool _show = _totalS >= i_minScore
            if _show
                box.set_bgcolor(array.get(bsBearBox, i), _bsCForState(newSt, false))
                box.set_border_color(array.get(bsBearBox, i), color.new(color.white, 80))
                box.set_text(array.get(bsBearBox, i), _starLine(_totalS, false) + "\n" + _ctxLine(false, h1Trend, h4Trend, pdEquilibrium, (topB + botB) / 2.0) + (_tradeInfo(false, topB, botB, _bsDolTarget(false, botB)) == "" ? "" : "\n" + _tradeInfo(false, topB, botB, _bsDolTarget(false, botB))))
            else
                box.set_bgcolor(array.get(bsBearBox, i), na)
                box.set_border_color(array.get(bsBearBox, i), na)
                box.set_text(array.get(bsBearBox, i), "")
            box.set_right(array.get(bsBearBox, i), bar_index + 5)

// Sync bord droit en temps réel
if array.size(bsBullTop) > 0 and barstate.islast
    for i = 0 to array.size(bsBullBox) - 1
        box.set_right(array.get(bsBullBox, i), bar_index + 5)
if array.size(bsBearTop) > 0 and barstate.islast
    for i = 0 to array.size(bsBearBox) - 1
        box.set_right(array.get(bsBearBox, i), bar_index + 5)


f_createBuySignals() =>
    // v11 : retour BT supprimé (module BT retiré). Fonction désormais void.
    if barstate.isconfirmed and not f_tradeBloquant() and not array.get(_tradePousseCetteBarre, 0) and not _regimeRange and array.size(obBullTop) > 0
        bool _oneBullSignal = false
        for i = 0 to array.size(obBullTop) - 1
            float _rt   = array.get(obBullTop, i)
            float _rb   = array.get(obBullBot, i)
            int   _rst  = array.get(obBullState, i)
            bool  _rSig = array.get(obBullSignaled, i)
            int   _rBar = array.get(obBullBar, i)
            // Ne pas signaler sur la barre de création (zone doit avoir au moins 1 barre pour s'afficher)
            float _mid   = (_rt + _rb) / 2.0
            bool _proche = na(atr14) or atr14 <= 0 or (close - _rt) <= 8.0 * atr14
            bool _retour = close > _rt and _rst < 2 and not _rSig and bar_index > _rBar and _proche
            if _retour
                // Correctif 1.4 : utiliser le score ENRICHI (freshness + proximité) déjà affiché
                // dans le label OB (obBullScore[i]), pas le score brut _scoreBullLive.
                // Garantit que le score archivé = score montré à l'utilisateur.
                int _scR = array.get(obBullScore, i)
                array.set(obBullScore, i, _scR)
                // Moteur OB (V11) : score + force + FVG/DoL. Le moteur BSZones gère ses propres trades.
                bool _qualifA = _scR >= seuilTrade and f_force(_scR) >= i_forceMin and f_znQualBull(i)
                if _qualifA and not _oneBullSignal
                    // v11 : entrée TR forcé (touche-retest au bord de l'OB).
                    // Décision campagne TR/PR/Mix 2026-07-19 : TR gagne 6/9 combos en espérance,
                    // PF moyen 1.47 (vs 1.40 PR / 1.39 Mix), taux de fill 56 % (vs 47 %).
                    // _mid (PR) supprimé — logique _rst (Mix) supprimée.
                    float _entry = _rt
                    float _sl    = i_slMode == "1.5× ATR sous OB" ? _rb - 1.5 * atr14 :
                                   i_slMode == "1× ATR sous OB"   ? _rb - atr14        :
                                   i_slMode == "2× ATR sous OB"   ? _rb - 2.0 * atr14  : _rb
                    float _r     = _entry - _sl
                    if _r > 2.0 * _slMax
                        continue
                    if i_execModel == "Marché à la cassure"
                        _entry := close
                        _r     := _entry - _sl
                    _r := math.max(_slMin, math.min(_slMax, _r))
                    _sl := _entry - _r
                    float _tp1   = _entry + _r
                    float _tp2   = _entry + 2.0 * _r
                    float _tEQH3 = not na(dernierEQH_level) and dernierEQH_level > _entry ? dernierEQH_level : na
                    float _tPDH3 = not na(pdhActive) and pdhActive > _entry ? pdhActive : na
                    float _tPWH3 = not na(pwhActive) and pwhActive > _entry ? pwhActive : na
                    float _tAHH3 = not na(_ahHighDrawn) and _ahHighDrawn > _entry ? _ahHighDrawn : na
                    float _tp3 = na
                    if not na(_tEQH3) or not na(_tPDH3) or not na(_tPWH3) or not na(_tAHH3)
                        float _m3 = na(_tEQH3) ? 1e15 : _tEQH3
                        _m3 := na(_tPDH3) ? _m3 : math.min(_m3, _tPDH3)
                        _m3 := na(_tPWH3) ? _m3 : math.min(_m3, _tPWH3)
                        _m3 := na(_tAHH3) ? _m3 : math.min(_m3, _tAHH3)
                        _tp3 := _m3
                    else
                        _tp3 := _entry + 3.0 * _r
                    // Correctif 1.3 : garantir TP3 ≥ TP2 ≥ TP1 (la liquidité cible peut être trop proche).
                    // Si la liquidité retenue casse la monotonie, retomber sur entry + 3R.
                    if na(_tp3) or _tp3 < _tp2
                        _tp3 := _entry + 3.0 * _r
                    int   _br    = int(time)
                    int   _right = _br + i_tpWidth * timeframe.in_seconds() * 1000
                    array.push(stBullEntry,    _entry)
                    array.push(_auditCreBuy, bar_index)  // audit : losange à la CRÉATION du trade
                    array.push(stBullSL,       _sl)
                    array.push(stBullTP1,      _tp1)
                    array.push(stBullTP2,      _tp2)
                    array.push(stBullTP3,      _tp3)
                    array.push(stBullTP1Hit,   false)
                    array.push(stBullTP2HitTs, 0)
                    array.push(stBullOpenTs,   int(time))
                    array.push(stBullScore,    _scR)
                    if _scR >= SEUIL_INSTIT
                        bool _ = true  // BT supprimé v11
                    else if _scR >= SEUIL_FORT
                        bool _ = true  // BT supprimé v11
                    else if _scR >= SEUIL_MOYEN
                        bool _ = true  // BT supprimé v11
                    array.push(stBullFilled,   false)   // Option B : en attente du retest de l'OB (fill réel quand low <= entrée)
                    array.push(stBullSource,   0)   // 0 = OB (lifecycle _obIdx actif)
                    // Trade en attente = INVISIBLE (objets créés transparents, rendus visibles au fill)
                    array.push(stBullSLBox, box.new(_br, _entry, _right, _sl,
                         xloc=xloc.bar_time, bgcolor=na, border_color=na, border_width=1))
                    array.push(stBullTPBox, box.new(_br, _tp3, _right, _entry,
                         xloc=xloc.bar_time, bgcolor=na, border_color=na, border_width=1))
                    array.push(stBullTP1Line, line.new(_br, _tp1, _right, _tp1,
                         xloc=xloc.bar_time, color=na, width=1, style=line.style_dashed))
                    array.push(stBullTP2Line, line.new(_br, _tp2, _right, _tp2,
                         xloc=xloc.bar_time, color=na, width=1, style=line.style_dashed))
                    // Phase 11 — label détaillé du trade (créé masqué, rempli au fill)
                    int _midX = int((_br + _right) / 2)
                    array.push(stBullLbl, label.new(_midX, _sl, "",
                         xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up,
                         color=na, textcolor=color.white, size=size.small, textalign=text.align_center))
                    array.set(obBullSignaled, i, true)
                    _oneBullSignal := true
                    array.set(_tradePousseCetteBarre, 0, true)   // bloque BSZones cette barre (1 trade total)



// ZONE-CŒUR (Étape 1a) — sous-zone d'entrée = intersection géométrique OB ∩ OTE ∩ FVG.
// Affichée seulement si chevauchement RÉEL + discount (bull) / premium (bear) + sweep frais.
// Affichage seul : AUCUN impact sur _entry / _sl (le levier d'engagement viendra en 1c).
color C_COEUR_BULL  = color.new(#00E676, 20)
color C_COEUR_BEAR  = color.new(#FF1744, 20)
color C_COEUR_BDR_B = color.new(#00C853, 0)
color C_COEUR_BDR_R = color.new(#D50000, 0)

f_zoneCoeurLifecycle() =>
    if i_showZones and i_moteurOB and barstate.isconfirmed
        // ── BULL : OB ∩ OTE ∩ FVG, en discount, sweep haut frais ──
        if array.size(obBullTop) > 0
            for _zi = 0 to array.size(obBullTop) - 1
                [_valid, _cT, _cB] = f_coeurBull(_zi)
                box _coBx = array.get(obBullCoreBox, _zi)
                // Affichage LIVE : créé/prolongé tant que le setup est valable, supprimé dès qu'il ne l'est plus
                if _valid
                    if na(_coBx)
                        array.set(obBullCoreBox, _zi, box.new(array.get(obBullBar, _zi), _cT, bar_index + 50, _cB,
                             bgcolor=C_COEUR_BULL, border_color=C_COEUR_BDR_B, border_width=1,
                             text="Zone Achat", text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE,
                             text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN))
                    else
                        box.set_right(_coBx, bar_index + 50)
                else if not na(_coBx)
                    box.delete(_coBx)
                    array.set(obBullCoreBox, _zi, na)
        // ── BEAR : OB ∩ OTE ∩ FVG, en premium, sweep bas frais ──
        if array.size(obBearTop) > 0
            for _zi = 0 to array.size(obBearTop) - 1
                [_valid, _cT, _cB] = f_coeurBear(_zi)
                box _coBx = array.get(obBearCoreBox, _zi)
                // Affichage LIVE : créé/prolongé tant que le setup est valable, supprimé dès qu'il ne l'est plus
                if _valid
                    if na(_coBx)
                        array.set(obBearCoreBox, _zi, box.new(array.get(obBearBar, _zi), _cT, bar_index + 50, _cB,
                             bgcolor=C_COEUR_BEAR, border_color=C_COEUR_BDR_R, border_width=1,
                             text="Zone Vente", text_color=C_BLOC_TXT_COLOR, text_size=C_BLOC_TXT_SIZE,
                             text_halign=C_BLOC_TXT_HALIGN, text_valign=C_BLOC_TXT_VALIGN))
                    else
                        box.set_right(_coBx, bar_index + 50)
                else if not na(_coBx)
                    box.delete(_coBx)
                    array.set(obBearCoreBox, _zi, na)

f_zoneCoeurLifecycle()

// Enrichissement des labels OB principaux (fraîcheur + Premium/Discount + confluence HTF + avis).
// Mise à jour live chaque barre — pdEquilibrium / confluence* déjà disponibles à ce stade.

// v11 : appels aux générateurs de signaux (module BT retiré, appels sans return).
f_createBuySignals()

f_createSellSignals() =>
    // v11 : retour BT supprimé (module BT retiré). Fonction désormais void.
    if barstate.isconfirmed and not f_tradeBloquant() and not array.get(_tradePousseCetteBarre, 0) and not _regimeRange and array.size(obBearTop) > 0
        bool _oneBearSignal = false
        for i = 0 to array.size(obBearTop) - 1
            float _rt   = array.get(obBearTop, i)
            float _rb   = array.get(obBearBot, i)
            int   _rst  = array.get(obBearState, i)
            bool  _rSig = array.get(obBearSignaled, i)
            int   _rBar = array.get(obBearBar, i)
            // Ne pas signaler sur la barre de création (zone doit avoir au moins 1 barre pour s'afficher)
            float _mid   = (_rt + _rb) / 2.0
            bool _proche = na(atr14) or atr14 <= 0 or (_rb - close) <= 8.0 * atr14
            bool _retour = close < _rb and _rst < 2 and not _rSig and bar_index > _rBar and _proche
            if _retour
                // Correctif 1.4 : utiliser le score ENRICHI (freshness + proximité) déjà affiché
                // dans le label OB (obBearScore[i]), pas le score brut _scoreBearLive.
                // Garantit que le score archivé = score montré à l'utilisateur.
                int _scR = array.get(obBearScore, i)
                array.set(obBearScore, i, _scR)
                // Moteur OB (V11) : score + force + FVG/DoL. Le moteur BSZones gère ses propres trades.
                bool _qualifA = _scR >= seuilTrade and f_force(_scR) >= i_forceMin and f_znQualBear(i)
                if _qualifA and not _oneBearSignal
                    // v11 : entrée TR forcé (touche-retest au bord de l'OB) — voir commentaire BUY.
                    float _entry = _rb
                    float _sl    = i_slMode == "1.5× ATR sous OB" ? _rt + 1.5 * atr14 :
                                   i_slMode == "1× ATR sous OB"   ? _rt + atr14        :
                                   i_slMode == "2× ATR sous OB"   ? _rt + 2.0 * atr14  : _rt
                    float _r     = _sl - _entry
                    if _r > 2.0 * _slMax
                        continue
                    if i_execModel == "Marché à la cassure"
                        _entry := close
                        _r     := _sl - _entry
                    _r := math.max(_slMin, math.min(_slMax, _r))
                    _sl := _entry + _r
                    float _tp1   = _entry - _r
                    float _tp2   = _entry - 2.0 * _r
                    float _tEQL3 = not na(dernierEQL_level) and dernierEQL_level < _entry ? dernierEQL_level : na
                    float _tPDL3 = not na(pdlActive) and pdlActive < _entry ? pdlActive : na
                    float _tPWL3 = not na(pwlActive) and pwlActive < _entry ? pwlActive : na
                    float _tAHL3 = not na(_ahLowDrawn) and _ahLowDrawn < _entry ? _ahLowDrawn : na
                    float _tp3 = na
                    if not na(_tEQL3) or not na(_tPDL3) or not na(_tPWL3) or not na(_tAHL3)
                        float _m3 = na(_tEQL3) ? -1e15 : _tEQL3
                        _m3 := na(_tPDL3) ? _m3 : math.max(_m3, _tPDL3)
                        _m3 := na(_tPWL3) ? _m3 : math.max(_m3, _tPWL3)
                        _m3 := na(_tAHL3) ? _m3 : math.max(_m3, _tAHL3)
                        _tp3 := _m3
                    else
                        _tp3 := _entry - 3.0 * _r
                    // Correctif 1.3 : garantir TP3 ≤ TP2 ≤ TP1 (la liquidité cible peut être trop proche).
                    // Si la liquidité retenue casse la monotonie, retomber sur entry - 3R.
                    if na(_tp3) or _tp3 > _tp2
                        _tp3 := _entry - 3.0 * _r
                    int   _br    = int(time)
                    int   _right = _br + i_tpWidth * timeframe.in_seconds() * 1000
                    array.push(stBearEntry,    _entry)
                    array.push(_auditCreSell, bar_index)  // audit : losange à la CRÉATION du trade
                    array.push(stBearSL,       _sl)
                    array.push(stBearTP1,      _tp1)
                    array.push(stBearTP2,      _tp2)
                    array.push(stBearTP3,      _tp3)
                    array.push(stBearTP1Hit,   false)
                    array.push(stBearTP2HitTs, 0)
                    array.push(stBearOpenTs,   int(time))
                    array.push(stBearScore,    _scR)
                    if _scR >= SEUIL_INSTIT
                        bool _ = true  // BT supprimé v11
                    else if _scR >= SEUIL_FORT
                        bool _ = true  // BT supprimé v11
                    else if _scR >= SEUIL_MOYEN
                        bool _ = true  // BT supprimé v11
                    array.push(stBearFilled,   false)   // Option B : en attente du retest de l'OB (fill réel quand high >= entrée)
                    array.push(stBearSource,   0)
                    // Trade en attente = INVISIBLE (objets créés transparents, rendus visibles au fill)
                    array.push(stBearSLBox, box.new(_br, _sl, _right, _entry,
                         xloc=xloc.bar_time, bgcolor=na, border_color=na, border_width=1))
                    array.push(stBearTPBox, box.new(_br, _entry, _right, _tp3,
                         xloc=xloc.bar_time, bgcolor=na, border_color=na, border_width=1))
                    array.push(stBearTP1Line, line.new(_br, _tp1, _right, _tp1,
                         xloc=xloc.bar_time, color=na, width=1, style=line.style_dashed))
                    array.push(stBearTP2Line, line.new(_br, _tp2, _right, _tp2,
                         xloc=xloc.bar_time, color=na, width=1, style=line.style_dashed))
                    // Phase 11 — label détaillé du trade (créé masqué, rempli au fill)
                    int _midX = int((_br + _right) / 2)
                    array.push(stBearLbl, label.new(_midX, _sl, "",
                         xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down,
                         color=na, textcolor=color.white, size=size.small, textalign=text.align_center))
                    array.set(obBearSignaled, i, true)
                    _oneBearSignal := true
                    array.set(_tradePousseCetteBarre, 0, true)   // bloque BSZones cette barre

f_createSellSignals()

// ─── MOTEUR BSZONES — Génération de trades (coexistence avec le moteur OB) ────────────────
// f_tradeBloquant + _tradePousseCetteBarre garantissent 1 trade total par configuration
// (si OB a poussé un trade cette barre, BSZones ne pousse rien, et inversement).

f_createBSBuySignals() =>
    if barstate.isconfirmed and not f_tradeBloquant() and not array.get(_tradePousseCetteBarre, 0) and array.size(bsBullTop) > 0
        bool _oneBullSignal = false
        for i = 0 to array.size(bsBullTop) - 1
            float _rt   = array.get(bsBullTop, i)
            float _rb   = array.get(bsBullBot, i)
            int   _rst  = array.get(bsBullState, i)
            bool  _rSig = array.get(bsBullSignaled, i)
            bool _proche = na(atr14) or atr14 <= 0 or (close - _rt) <= 8.0 * atr14
            // Retour dans la zone BSZones (prix au-dessus du top, zone non profonde, non signalée).
            // Le bar_index de création BSZones n'est pas tracé → on accepte le signal dès la barre suivante
            // de la zone (le gate naissance _baseScore>=6 + HTF filtre déjà la qualité).
            bool _retour = close > _rt and _rst < 2 and not _rSig and _proche
            if _retour
                int _scR = array.get(bsBullScore, i)
                // Qualif trade BSZones : score >= i_tradeMinScore (séparé de l'affichage i_minScore).
                // Les zones 5-6 s'affichent pour le manuel, mais seules les >= i_tradeMinScore génèrent un trade.
                bool _qualif = _scR >= i_tradeMinScore
                if _qualif and not _oneBullSignal
                    float _entry = _rt   // TR forcé (bord haut zone BSZones)
                    float _sl    = i_slMode == "1.5× ATR sous OB" ? _rb - 1.5 * atr14 :
                                   i_slMode == "1× ATR sous OB"   ? _rb - atr14        :
                                   i_slMode == "2× ATR sous OB"   ? _rb - 2.0 * atr14  : _rb
                    float _r = _entry - _sl
                    if _r > 2.0 * _slMax
                        continue
                    _r := math.max(_slMin, math.min(_slMax, _r))
                    _sl := _entry - _r
                    float _tp1 = _entry + _r
                    float _tp2 = _entry + 2.0 * _r
                    // TP3 = liquidité la plus proche (réutilise _bsDolTarget déjà calculé pour le label).
                    float _tp3 = _bsDolTarget(true, _entry)
                    if na(_tp3) or _tp3 < _tp2
                        _tp3 := _entry + 3.0 * _r
                    int _br    = int(time)
                    int _right = _br + i_tpWidth * timeframe.in_seconds() * 1000
                    array.push(stBullEntry,    _entry)
                    array.push(_auditCreBuy, bar_index)  // audit : losange à la CRÉATION du trade
                    array.push(stBullSL,       _sl)
                    array.push(stBullTP1,      _tp1)
                    array.push(stBullTP2,      _tp2)
                    array.push(stBullTP3,      _tp3)
                    array.push(stBullTP1Hit,   false)
                    array.push(stBullTP2HitTs, 0)
                    array.push(stBullOpenTs,   int(time))
                    array.push(stBullScore,    _scR)
                    array.push(stBullFilled,   false)
                    array.push(stBullSource,   1)   // 1 = BSZones (court-circuite _obIdx lifecycle)
                    array.push(stBullSLBox, box.new(_br, _entry, _right, _sl,
                         xloc=xloc.bar_time, bgcolor=na, border_color=na, border_width=1))
                    array.push(stBullTPBox, box.new(_br, _tp3, _right, _entry,
                         xloc=xloc.bar_time, bgcolor=na, border_color=na, border_width=1))
                    array.push(stBullTP1Line, line.new(_br, _tp1, _right, _tp1,
                         xloc=xloc.bar_time, color=na, width=1, style=line.style_dashed))
                    array.push(stBullTP2Line, line.new(_br, _tp2, _right, _tp2,
                         xloc=xloc.bar_time, color=na, width=1, style=line.style_dashed))
                    int _midX = int((_br + _right) / 2)
                    array.push(stBullLbl, label.new(_midX, _sl, "",
                         xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_up,
                         color=na, textcolor=color.white, size=size.small, textalign=text.align_center))
                    array.set(bsBullSignaled, i, true)
                    _oneBullSignal := true
                    array.set(_tradePousseCetteBarre, 0, true)   // bloque OB (et BSZones bear) cette barre

f_createBSSellSignals() =>
    if barstate.isconfirmed and not f_tradeBloquant() and not array.get(_tradePousseCetteBarre, 0) and array.size(bsBearTop) > 0
        bool _oneBearSignal = false
        for i = 0 to array.size(bsBearTop) - 1
            float _rt   = array.get(bsBearTop, i)
            float _rb   = array.get(bsBearBot, i)
            int   _rst  = array.get(bsBearState, i)
            bool  _rSig = array.get(bsBearSignaled, i)
            bool _proche = na(atr14) or atr14 <= 0 or (_rb - close) <= 8.0 * atr14
            bool _retour = close < _rb and _rst < 2 and not _rSig and _proche
            if _retour
                int _scR = array.get(bsBearScore, i)
                // Qualif trade BSZones : score >= i_tradeMinScore (séparé de l'affichage i_minScore).
                bool _qualif = _scR >= i_tradeMinScore
                if _qualif and not _oneBearSignal
                    float _entry = _rb   // TR forcé (bord bas zone BSZones)
                    float _sl    = i_slMode == "1.5× ATR sous OB" ? _rt + 1.5 * atr14 :
                                   i_slMode == "1× ATR sous OB"   ? _rt + atr14        :
                                   i_slMode == "2× ATR sous OB"   ? _rt + 2.0 * atr14  : _rt
                    float _r = _sl - _entry
                    if _r > 2.0 * _slMax
                        continue
                    _r := math.max(_slMin, math.min(_slMax, _r))
                    _sl := _entry + _r
                    float _tp1 = _entry - _r
                    float _tp2 = _entry - 2.0 * _r
                    float _tp3 = _bsDolTarget(false, _entry)
                    if na(_tp3) or _tp3 > _tp2
                        _tp3 := _entry - 3.0 * _r
                    int _br    = int(time)
                    int _right = _br + i_tpWidth * timeframe.in_seconds() * 1000
                    array.push(stBearEntry,    _entry)
                    array.push(_auditCreSell, bar_index)  // audit : losange à la CRÉATION du trade
                    array.push(stBearSL,       _sl)
                    array.push(stBearTP1,      _tp1)
                    array.push(stBearTP2,      _tp2)
                    array.push(stBearTP3,      _tp3)
                    array.push(stBearTP1Hit,   false)
                    array.push(stBearTP2HitTs, 0)
                    array.push(stBearOpenTs,   int(time))
                    array.push(stBearScore,    _scR)
                    array.push(stBearFilled,   false)
                    array.push(stBearSource,   1)
                    array.push(stBearSLBox, box.new(_br, _sl, _right, _entry,
                         xloc=xloc.bar_time, bgcolor=na, border_color=na, border_width=1))
                    array.push(stBearTPBox, box.new(_br, _entry, _right, _tp3,
                         xloc=xloc.bar_time, bgcolor=na, border_color=na, border_width=1))
                    array.push(stBearTP1Line, line.new(_br, _tp1, _right, _tp1,
                         xloc=xloc.bar_time, color=na, width=1, style=line.style_dashed))
                    array.push(stBearTP2Line, line.new(_br, _tp2, _right, _tp2,
                         xloc=xloc.bar_time, color=na, width=1, style=line.style_dashed))
                    int _midX = int((_br + _right) / 2)
                    array.push(stBearLbl, label.new(_midX, _sl, "",
                         xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_down,
                         color=na, textcolor=color.white, size=size.small, textalign=text.align_center))
                    array.set(bsBearSignaled, i, true)
                    _oneBearSignal := true
                    array.set(_tradePousseCetteBarre, 0, true)

f_createBSBuySignals()
f_createBSSellSignals()

// Gestion cycle de vie signaux BUY
// Phase 11.2 : évaluation INTRABAR (sans barstate.isconfirmed) — SL touché → trade supprimé immédiatement,
// TP1 touché → BE placé (box SL effacée) immédiatement, sans attendre la clôture. Conditions monotones
// sur la bougie en cours (low/high ne reviennent pas) → pas de clignotement. Les compteurs stats
// justifiant l'ancien gating ont été supprimés en Phase 10.
// NOTE: ancien module BT interne retiré (migration vers moteur BT unifié externe).
if array.size(stBullSLBox) > 0
    array<int> _delBull = array.new<int>(0)
    for i = 0 to array.size(stBullSLBox) - 1
        float _sl    = array.get(stBullSL,       i)
        float _entry = array.get(stBullEntry,    i)
        float _tp1   = array.get(stBullTP1,      i)
        float _tp2   = array.get(stBullTP2,      i)
        float _tp3   = array.get(stBullTP3,      i)
        int   _scBullTrade = array.get(stBullScore,     i)
        bool  _t1Hit = array.get(stBullTP1Hit,   i)
        int   _t2Ts  = array.get(stBullTP2HitTs, i)
        int   _openTs = array.get(stBullOpenTs,   i)
        bool  _filled = array.get(stBullFilled,   i)
        bool  _isMarket = i_execModel == "Marché à la cassure"
        if not _filled and (_isMarket or (time > _openTs and low <= _entry))
            _filled := true
            array.set(stBullFilled, i, true)
            bool _ = true  // BT supprimé v11
            // Affichage : ré-ancrer le trade sur la barre de FILL (retest) au lieu de la barre de création,
            // pour que la 1ʳᵉ bougie affichée soit celle où le prix touche réellement l'entrée.
            int _fillL    = int(time)
            int _fillR    = _fillL + i_tpWidth * timeframe.in_seconds() * 1000
            int _fillMidX = int((_fillL + _fillR) / 2)
            // Option B : le prix est revenu toucher l'entrée → fill réel, on solidifie l'affichage
            box _slBxF = array.get(stBullSLBox, i)
            if not na(_slBxF)
                box.set_left(_slBxF, _fillL)
                box.set_right(_slBxF, _fillR)
                box.set_bgcolor(_slBxF, C_SL_BG)
                box.set_border_color(_slBxF, C_SL_BDR)
                box.set_border_style(_slBxF, line.style_solid)
            box _tpBxF = array.get(stBullTPBox, i)
            if not na(_tpBxF)
                box.set_left(_tpBxF, _fillL)
                box.set_right(_tpBxF, _fillR)
                box.set_bgcolor(_tpBxF, C_TP_BG)
                box.set_border_color(_tpBxF, C_TP_BDR)
                box.set_border_style(_tpBxF, line.style_solid)
            line _l1F = array.get(stBullTP1Line, i)
            if not na(_l1F)
                line.set_x1(_l1F, _fillL)
                line.set_x2(_l1F, _fillR)
                line.set_color(_l1F, C_TP1_L)
            line _l2F = array.get(stBullTP2Line, i)
            if not na(_l2F)
                line.set_x1(_l2F, _fillL)
                line.set_x2(_l2F, _fillR)
                line.set_color(_l2F, C_TP2_L)
            label _lblF = array.get(stBullLbl, i)
            if not na(_lblF)
                label.set_x(_lblF, _fillMidX)
                label.set_color(_lblF, C_LBL_BUY)
                float _rF = _entry - _sl
                label.set_text(_lblF, f_lblTrade(true, _scBullTrade, _scoreMax, _entry, _sl, _tp1, _tp2, _tp3, _pipValue, _fmtPx, (i_capital * i_riskPct / 100.0) / (_rF / _pipValue * _pvLot)))
        bool  _ageExpire = (time - _openTs) > i_tradeMaxMins * 60000
        bool  _expire = (_t2Ts > 0 and (time - _t2Ts) > i_tp3MaxMins * 60000) or _ageExpire
        bool  _slHit     = _filled and low < _sl and not _t1Hit
        bool  _beHit     = _filled and low < _entry and _t1Hit and _t2Ts == 0
        bool  _tp2SLHit  = _filled and low < _tp1  and _t1Hit and _t2Ts > 0
        bool  _tp3Hit    = _filled and high >= _tp3
        // Phase 6 : trouver l'OB lié au trade actif (uniquement si source OB, pas BSZones)
        int _srcBull = array.get(stBullSource, i)
        int _obIdx = -1
        if _srcBull == 0 and array.size(obBullSignaled) > 0
            for _k = 0 to array.size(obBullSignaled) - 1
                if array.get(obBullSignaled, _k)
                    _obIdx := _k
                    break
        bool _scoreDeg = _obIdx >= 0 and not _t1Hit and
             f_force(array.get(obBullScore, _obIdx)) < i_forceMin
        bool _beForce  = not _t1Hit and bosBaissier
        // Ventilation par classe de score (audit 2026-07-19) : Moyen / Fort / Institutionnel
        int _clsBull = _scBullTrade >= SEUIL_INSTIT ? 2 : _scBullTrade >= SEUIL_FORT ? 1 : 0
        if _slHit or _beHit or _tp2SLHit or _tp3Hit or _expire or (not _filled and _beForce)
            if _slHit
                bool _ = true  // BT supprimé v11
                if _clsBull == 2
                    bool _ = true  // BT supprimé v11
                else if _clsBull == 1
                    bool _ = true  // BT supprimé v11
                else
                    bool _ = true  // BT supprimé v11
            else if _beHit
                bool _ = true  // BT supprimé v11
            else if _tp2SLHit
                bool _ = true  // BT supprimé v11
                if _clsBull == 2
                    bool _ = true  // BT supprimé v11
                else if _clsBull == 1
                    bool _ = true  // BT supprimé v11
                else
                    bool _ = true  // BT supprimé v11
            else if _tp3Hit
                bool _ = true  // BT supprimé v11
                if _clsBull == 2
                    bool _ = true  // BT supprimé v11
                else if _clsBull == 1
                    bool _ = true  // BT supprimé v11
                else
                    bool _ = true  // BT supprimé v11
            else if _expire
                if not _filled
                    bool _ = true  // BT supprimé v11
                else if _t2Ts > 0
                    bool _ = true  // BT supprimé v11
                else
                    bool _ = true  // BT supprimé v11
            else if not _filled and _beForce
                bool _ = true  // BT supprimé v11
            f_delBullSignal(i)
            array.push(_delBull, i)
        else if _filled and (_beForce or _scoreDeg) and not _t1Hit
            // Passage en BE : SL → entry, trade maintenu ouvert (N_BE compte seulement a la cloture reelle via _beHit, evite le double comptage)
            if _obIdx >= 0
                array.set(obBullSignaled, _obIdx, false)
            array.set(stBullSL, i, _entry)
            box _bslBE = array.get(stBullSLBox, i)
            if not na(_bslBE)
                box.delete(_bslBE)
                array.set(stBullSLBox, i, na)
            array.set(stBullTP1Hit, i, true)
            label _lbl6be = array.get(stBullLbl, i)
            if not na(_lbl6be)
                label.delete(_lbl6be)
                array.set(stBullLbl, i, na)
            if _beForce
                alert("⚠ BE BUY — SL → " + str.tostring(_entry, format.mintick) + " | " + syminfo.ticker, alert.freq_once_per_bar_close)
                _auditBarBeBuy := bar_index  // audit : croix à la barre du BE
        else
            // Phase 6A : mise à jour label score live (seulement une fois le trade rempli)
            if _filled and _obIdx >= 0
                label _lbl6 = array.get(stBullLbl, i)
                if not na(_lbl6)
                    int _scLv  = array.get(obBullScore, _obIdx)
                    float _rLv = _entry - _sl
                    label.set_text(_lbl6, f_lblTrade(true, _scLv, _scoreMax, _entry, _sl,
                         _tp1, _tp2, _tp3, _pipValue, _fmtPx,
                         (i_capital * i_riskPct / 100.0) / (_rLv / _pipValue * _pvLot)))
            if _filled and not _t1Hit and high >= _tp1
                array.set(stBullTP1Hit, i, true)
                array.set(stBullSL,     i, _entry)   // TP1 atteint -> SL a BE (entree)
                bool _ = true  // BT supprimé v11
                box _bsl = array.get(stBullSLBox, i)
                if not na(_bsl)
                    box.delete(_bsl)
                    array.set(stBullSLBox, i, na)
                label _lblTp1 = array.get(stBullLbl, i)
                if not na(_lblTp1)
                    label.delete(_lblTp1)
                    array.set(stBullLbl, i, na)
            if _filled and _t1Hit and _t2Ts == 0 and high >= _tp2
                array.set(stBullTP2HitTs, i, int(time))
    if array.size(_delBull) > 0
        array.sort(_delBull, order.descending)
        for j = 0 to array.size(_delBull) - 1
            int _id = array.get(_delBull, j)
            f_purgeBullSignalData(_id)





// Gestion cycle de vie signaux SELL
// Phase 11.2 : évaluation INTRABAR (sans barstate.isconfirmed) — SL touché → trade supprimé immédiatement,
// TP1 touché → BE placé (box SL effacée) immédiatement, sans attendre la clôture. Conditions monotones
// sur la bougie en cours (high/low ne reviennent pas) → pas de clignotement. Les compteurs stats
// justifiant l'ancien gating ont été supprimés en Phase 10.
if array.size(stBearSLBox) > 0
    array<int> _delBear = array.new<int>(0)
    for i = 0 to array.size(stBearSLBox) - 1
        float _sl    = array.get(stBearSL,       i)
        float _entry = array.get(stBearEntry,    i)
        float _tp1   = array.get(stBearTP1,      i)
        float _tp2   = array.get(stBearTP2,      i)
        float _tp3   = array.get(stBearTP3,      i)
        int   _scBearTrade = array.get(stBearScore,     i)
        bool  _t1Hit = array.get(stBearTP1Hit,   i)
        int   _t2Ts  = array.get(stBearTP2HitTs, i)

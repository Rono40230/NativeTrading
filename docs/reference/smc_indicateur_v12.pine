        bool  _filled = array.get(stBearFilled,   i)
        bool  _isMarket = i_execModel == "Marché à la cassure"
        if not _filled and (_isMarket or (time > _openTs and high >= _entry))
            _filled := true
            array.set(stBearFilled, i, true)
            bool _ = true  // BT supprimé v11
            // Affichage : ré-ancrer le trade sur la barre de FILL (retest) au lieu de la barre de création,
            // pour que la 1ʳᵉ bougie affichée soit celle où le prix touche réellement l'entrée.
            int _fillL    = int(time)
            int _fillR    = _fillL + i_tpWidth * timeframe.in_seconds() * 1000
            int _fillMidX = int((_fillL + _fillR) / 2)
            // Option B : le prix est revenu toucher l'entrée → fill réel, on solidifie l'affichage
            box _slBxF = array.get(stBearSLBox, i)
            if not na(_slBxF)
                box.set_left(_slBxF, _fillL)
                box.set_right(_slBxF, _fillR)
                box.set_bgcolor(_slBxF, C_SL_BG)
                box.set_border_color(_slBxF, C_SL_BDR)
                box.set_border_style(_slBxF, line.style_solid)
            box _tpBxF = array.get(stBearTPBox, i)
            if not na(_tpBxF)
                box.set_left(_tpBxF, _fillL)
                box.set_right(_tpBxF, _fillR)
                box.set_bgcolor(_tpBxF, C_TP_BG)
                box.set_border_color(_tpBxF, C_TP_BDR)
                box.set_border_style(_tpBxF, line.style_solid)
            line _l1F = array.get(stBearTP1Line, i)
            if not na(_l1F)
                line.set_x1(_l1F, _fillL)
                line.set_x2(_l1F, _fillR)
                line.set_color(_l1F, C_TP1_L)
            line _l2F = array.get(stBearTP2Line, i)
            if not na(_l2F)
                line.set_x1(_l2F, _fillL)
                line.set_x2(_l2F, _fillR)
                line.set_color(_l2F, C_TP2_L)
            label _lblF = array.get(stBearLbl, i)
            if not na(_lblF)
                label.set_x(_lblF, _fillMidX)
                label.set_color(_lblF, C_LBL_SELL)
                float _rF = _sl - _entry
                label.set_text(_lblF, f_lblTrade(false, _scBearTrade, _scoreMax, _entry, _sl, _tp1, _tp2, _tp3, _pipValue, _fmtPx, (i_capital * i_riskPct / 100.0) / (_rF / _pipValue * _pvLot)))
        bool  _ageExpire = (time - _openTs) > i_tradeMaxMins * 60000
        bool  _expire = (_t2Ts > 0 and (time - _t2Ts) > i_tp3MaxMins * 60000) or _ageExpire
        bool  _slHit     = _filled and high > _sl and not _t1Hit
        bool  _beHit     = _filled and high > _entry and _t1Hit and _t2Ts == 0
        bool  _tp2SLHit  = _filled and high > _tp1  and _t1Hit and _t2Ts > 0
        bool  _tp3Hit    = _filled and low <= _tp3
        // Phase 6 : trouver l'OB lié au trade actif (uniquement si source OB, pas BSZones)
        int _srcBear = array.get(stBearSource, i)
        int _obIdx = -1
        if _srcBear == 0 and array.size(obBearSignaled) > 0
            for _k = 0 to array.size(obBearSignaled) - 1
                if array.get(obBearSignaled, _k)
                    _obIdx := _k
                    break
        bool _scoreDeg = _obIdx >= 0 and not _t1Hit and
             f_force(array.get(obBearScore, _obIdx)) < i_forceMin
        bool _beForce  = not _t1Hit and bosHaussier
        // Ventilation par classe de score (audit 2026-07-19) : Moyen / Fort / Institutionnel
        int _clsBear = _scBearTrade >= SEUIL_INSTIT ? 2 : _scBearTrade >= SEUIL_FORT ? 1 : 0
        if _slHit or _beHit or _tp2SLHit or _tp3Hit or _expire or (not _filled and _beForce)
            if _slHit
                bool _ = true  // BT supprimé v11
                if _clsBear == 2
                    bool _ = true  // BT supprimé v11
                else if _clsBear == 1
                    bool _ = true  // BT supprimé v11
                else
                    bool _ = true  // BT supprimé v11
            else if _beHit
                bool _ = true  // BT supprimé v11
            else if _tp2SLHit
                bool _ = true  // BT supprimé v11
                if _clsBear == 2
                    bool _ = true  // BT supprimé v11
                else if _clsBear == 1
                    bool _ = true  // BT supprimé v11
                else
                    bool _ = true  // BT supprimé v11
            else if _tp3Hit
                bool _ = true  // BT supprimé v11
                if _clsBear == 2
                    bool _ = true  // BT supprimé v11
                else if _clsBear == 1
                    bool _ = true  // BT supprimé v11
                else
                    bool _ = true  // BT supprimé v11
            else if _expire
                if not _filled
                    bool _ = true  // BT supprimé v11
                else if _t2Ts > 0
                    bool _ = true  // BT supprimé v11
                else
                    bool _ = true  // BT supprimé v11
            else if not _filled and _beForce
                bool _ = true  // BT supprimé v11
            f_delBearSignal(i)
            array.push(_delBear, i)
        else if _filled and (_beForce or _scoreDeg) and not _t1Hit
            // Passage en BE : SL → entry, trade maintenu ouvert (N_BE compte seulement a la cloture reelle via _beHit, evite le double comptage)
            if _obIdx >= 0
                array.set(obBearSignaled, _obIdx, false)
            array.set(stBearSL, i, _entry)
            box _bslBE = array.get(stBearSLBox, i)
            if not na(_bslBE)
                box.delete(_bslBE)
                array.set(stBearSLBox, i, na)
            array.set(stBearTP1Hit, i, true)
            label _lbl6be = array.get(stBearLbl, i)
            if not na(_lbl6be)
                label.delete(_lbl6be)
                array.set(stBearLbl, i, na)
            if _beForce
                alert("⚠ BE SELL — SL → " + str.tostring(_entry, format.mintick) + " | " + syminfo.ticker, alert.freq_once_per_bar_close)
                _auditBarBeSell := bar_index  // audit : croix à la barre du BE
        else
            // Phase 6A : mise à jour label score live (seulement une fois le trade rempli)
            if _filled and _obIdx >= 0
                label _lbl6 = array.get(stBearLbl, i)
                if not na(_lbl6)
                    int _scLv  = array.get(obBearScore, _obIdx)
                    float _rLv = _sl - _entry
                    label.set_text(_lbl6, f_lblTrade(false, _scLv, _scoreMax, _entry, _sl,
                         _tp1, _tp2, _tp3, _pipValue, _fmtPx,
                         (i_capital * i_riskPct / 100.0) / (_rLv / _pipValue * _pvLot)))
            if _filled and not _t1Hit and low <= _tp1
                array.set(stBearTP1Hit, i, true)
                array.set(stBearSL,     i, _entry)   // TP1 atteint -> SL a BE (entree)
                bool _ = true  // BT supprimé v11
                box _bsl = array.get(stBearSLBox, i)
                if not na(_bsl)
                    box.delete(_bsl)
                    array.set(stBearSLBox, i, na)
                label _lblTp1 = array.get(stBearLbl, i)
                if not na(_lblTp1)
                    label.delete(_lblTp1)
                    array.set(stBearLbl, i, na)
            if _filled and _t1Hit and _t2Ts == 0 and low <= _tp2
                array.set(stBearTP2HitTs, i, int(time))
    if array.size(_delBear) > 0
        array.sort(_delBear, order.descending)
        for j = 0 to array.size(_delBear) - 1
            int _id = array.get(_delBear, j)
            f_purgeBearSignalData(_id)

// v11 : module BT (plots + table _btTable) SUPPRIMÉ. Les compteurs _btN* restent
// calculés dans le cycle de vie (étapes 2 et 3 à venir) mais ne sont plus affichés.
// Les campagnes BT sont terminées — voir releves_bt_v11_*.csv et roadmap.md.



// ─── ALERTES SCOPE PRINCIPAL ────────────────────────────────────────
// Détection des signaux BUY/SELL générés dans f_createBuySignals() et f_createSellSignals()

// Signal BUY détecté : parcours des trades BUY créés sur la barre courante
bool _newBuySignal = false
if array.size(stBullSLBox) > 0
    for _i = 0 to array.size(stBullSLBox) - 1
        float _entry = array.get(stBullEntry, _i)
        int   _sc    = array.get(stBullScore, _i)
        if _sc >= seuilTrade and math.abs(_entry - close) < 0.001 * close
            _newBuySignal := true

// Signal SELL détecté
bool _newSellSignal = false
if array.size(stBearSLBox) > 0
    for _i = 0 to array.size(stBearSLBox) - 1
        float _entry = array.get(stBearEntry, _i)
        int   _sc    = array.get(stBearScore, _i)
        if _sc >= seuilTrade and math.abs(_entry - close) < 0.001 * close
            _newSellSignal := true

// Déclencher les alertes (une seule fois par barre)
if barstate.isconfirmed
    if _newBuySignal and not _alertBuyTriggered
        int _lastIdx = array.size(stBullSLBox) - 1
        if _lastIdx >= 0
            float _entry = array.get(stBullEntry, _lastIdx)
            float _sl    = array.get(stBullSL,    _lastIdx)
            float _tp1   = array.get(stBullTP1,   _lastIdx)
            int   _sc    = array.get(stBullScore, _lastIdx)
            alert("🟢 ENTRÉE BUY force " + str.tostring(f_force(_sc)) + "/10 | " + syminfo.ticker + " " + timeframe.period + " | SL " + str.tostring(_sl, format.mintick) + " TP1 " + str.tostring(_tp1, format.mintick), alert.freq_once_per_bar_close)
            _alertBuyTriggered := true
            _auditBarBuy := bar_index  // audit : flèche à la barre d'émission
    else if not _newBuySignal
        _alertBuyTriggered := false

    if _newSellSignal and not _alertSellTriggered
        int _lastIdx = array.size(stBearSLBox) - 1
        if _lastIdx >= 0
            float _entry = array.get(stBearEntry, _lastIdx)
            float _sl    = array.get(stBearSL,    _lastIdx)
            float _tp1   = array.get(stBearTP1,   _lastIdx)
            int   _sc    = array.get(stBearScore, _lastIdx)
            alert("🔴 ENTRÉE SELL force " + str.tostring(f_force(_sc)) + "/10 | " + syminfo.ticker + " " + timeframe.period + " | SL " + str.tostring(_sl, format.mintick) + " TP1 " + str.tostring(_tp1, format.mintick), alert.freq_once_per_bar_close)
            _alertSellTriggered := true
            _auditBarSell := bar_index  // audit : flèche à la barre d'émission
    else if not _newSellSignal
        _alertSellTriggered := false


// MODULE P3 — ALERTES COMPOSITES SMC
// Activer via TradingView → "Créer une alerte" → choisir la condition

// ── 3.1 : Setup approche — OB fort à portée ───────────────────────
// Déclenchement : meilleur OB non-signalé avec score ≥ Fort
//                ET prix à moins de 2× ATR de l'OB
bool _alertSetupBull = false
bool _alertSetupBear = false
if _bestIdx >= 0 and not na(atr14) and barstate.isconfirmed
    float _obMidA = _bestBull ?
         (array.get(obBullTop, _bestIdx) + array.get(obBullBot, _bestIdx)) / 2.0 :
         (array.get(obBearTop, _bestIdx) + array.get(obBearBot, _bestIdx)) / 2.0
    bool _proche   = math.abs(close - _obMidA) <= 2.0 * atr14
    bool _scoreFort = f_force(_bestSc) >= 7
    if _scoreFort and _proche
        if _bestBull
            _alertSetupBull := true
        else
            _alertSetupBear := true


alertcondition(_alertSetupBull, title="SMC — Setup BUY approche",  message="🟢 SMC BUY SETUP | {{ticker}} {{interval}}")
alertcondition(_alertSetupBear, title="SMC — Setup SELL approche", message="🔴 SMC SELL SETUP | {{ticker}} {{interval}}")

// ── 3.2 : Dégradation d'un OB signalé (état → profond/consommé) ──
// Déclenchement : un OB qui avait généré un signal passe à état=2
var bool _prevAnyBullDeep = false
var bool _prevAnyBearDeep = false
bool _alertDegradBull = false
bool _alertDegradBear = false
if barstate.isconfirmed
    bool _anyBullDeep = false
    if array.size(obBullState) > 0
        for _di = 0 to array.size(obBullState) - 1
            if array.get(obBullSignaled, _di) and array.get(obBullState, _di) >= 2
                _anyBullDeep := true
    bool _anyBearDeep = false
    if array.size(obBearState) > 0
        for _di = 0 to array.size(obBearState) - 1
            if array.get(obBearSignaled, _di) and array.get(obBearState, _di) >= 2
                _anyBearDeep := true
    // Détecter la transition false→true (nouveau OB dégradé)
    _alertDegradBull := _anyBullDeep and not _prevAnyBullDeep
    _alertDegradBear := _anyBearDeep and not _prevAnyBearDeep
    _prevAnyBullDeep := _anyBullDeep
    _prevAnyBearDeep := _anyBearDeep

// ── 3.3 : Kill Zone ouverte + setup fort ──────────────────────────
// Déclenchement : transition inKZ false→true ET force ≥ Fort (7/10)
var bool _prevKZ = false
bool _kzOpen = inKZ and not _prevKZ  // front montant Kill Zone
_prevKZ := inKZ

bool _alertKZBull = _kzOpen and f_force(_bestSc) >= 7 and _bestBull  and barstate.isconfirmed
bool _alertKZBear = _kzOpen and f_force(_bestSc) >= 7 and not _bestBull and barstate.isconfirmed

alertcondition(_alertKZBull, title="SMC — KZ ouverte + Setup BUY",  message="🎯 KZ OUVERTE + SETUP BUY | Score {{plot(\"Score\")}} | {{ticker}} {{interval}}")
alertcondition(_alertKZBear, title="SMC — KZ ouverte + Setup SELL", message="🎯 KZ OUVERTE + SETUP SELL | Score {{plot(\"Score\")}} | {{ticker}} {{interval}}")

// ── AUDIT : marqueurs persistants (input « Mode audit », Phase 2.7) ─────
// Les plotshape ne peuvent pas être supprimés : chaque émission/BE laisse
// une trace permanente à sa barre exacte — lisible en scrollant l'historique.
// Triangles = condition d'ALERTE (close ≈ entry à la clôture) ;
// losanges   = CRÉATION du trade (retour qualifié dans l'OB) — comparable
//              1:1 avec les émissions du moteur local.
plotshape(i_audit and bar_index == _auditBarBuy,     title="Émission BUY",  style=shape.triangleup,   location=location.belowbar, color=color.new(#00e676, 0), size=size.tiny)
plotshape(i_audit and bar_index == _auditBarSell,    title="Émission SELL", style=shape.triangledown, location=location.abovebar, color=color.new(#ff5252, 0), size=size.tiny)
plotshape(i_audit and bar_index == _auditBarBeBuy,   title="BE BUY",        style=shape.xcross,       location=location.belowbar, color=color.new(#ffd54f, 0), size=size.tiny)
plotshape(i_audit and bar_index == _auditBarBeSell,  title="BE SELL",       style=shape.xcross,       location=location.abovebar, color=color.new(#ffd54f, 0), size=size.tiny)
plotshape(i_audit and array.includes(_auditCreBuy,  bar_index), title="Création BUY",  style=shape.diamond, location=location.belowbar, color=color.new(#40c4ff, 30), size=size.tiny)
plotshape(i_audit and array.includes(_auditCreSell, bar_index), title="Création SELL", style=shape.diamond, location=location.abovebar, color=color.new(#ff9e80, 30), size=size.tiny)
// Debug détection : petites étiquettes IMP sur les bougies d'impulsion OB.
// Debug : compteur de zones actives + âge de la plus vieille (test FIFO 40).
// ── Debug vague 3 : table des niveaux EQH/EQL du pool MODULE 4 ──────────────
// Une ligne par niveau : type, prix, touches, DATE du 1er pivot, SWP si sweepé.
// Les niveaux sont listés du PLUS ANCIEN (index 0) au plus récent — comme
// l'export de l'app (même ordre d'insertion FIFO).
var table _liqTbl = table.new(position.top_right, 1, 22, bgcolor=color.new(color.black, 40))
if i_debugLiq and barstate.islast
    table.cell(_liqTbl, 0, 0, "EQH/EQL (" + str.tostring(array.size(liqPool)) + ") ATR " + str.tostring(atr14, "#") + " bars " + str.tostring(bar_index), text_color=color.white, text_size=size.normal)
    string _dEval = na(_diagLastPivBar) ? "?" : str.format_time(time[math.min(bar_index - _diagLastPivBar, 5000)], "dd/MM HH:mm")
    table.cell(_liqTbl, 0, 1, "evalH " + str.tostring(_diagEvalH) + " creat " + str.tostring(_diagCreat) + " dern eval " + _dEval + " | " + str.tostring(_diagSh1, "#") + " vs " + str.tostring(_diagSh2, "#") + " ph " + str.tostring(_diagPh, "#") + " sw " + str.tostring(i_swingLength) + " tol " + str.tostring(_diagTolEq, "#"), text_color=color.new(#ff9800, 0), text_size=size.normal)
    if array.size(liqPool) > 0
        for _li2 = 0 to math.min(array.size(liqPool) - 1, 19)
            LiqLevel _lv = array.get(liqPool, _li2)
            string _dte = _lv.tTime > 0 ? str.format_time(_lv.tTime, "dd/MM") : "??"
            string _st = (_lv.isHigh ? "EQH " : "EQL ") + str.tostring(_lv.price, "#") + " x" + str.tostring(_lv.touches) + " " + _dte + (_lv.swept ? " SWP" : "")
            table.cell(_liqTbl, 0, _li2 + 2, _st, text_color=_lv.swept ? color.new(#9e9e9e, 0) : _lv.isHigh ? color.new(#ffd600, 0) : color.new(#00bcd4, 0), text_size=size.normal)

// Ancien bloc de métriques BT interne supprimé (obsolète).

